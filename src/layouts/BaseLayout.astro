---
interface Props {
  title: string;
  description: string;
  schema?: object;
}

const { title, description, schema } = Astro.props;

const dealerSchema = {
  "@context": "https://schema.org",
  "@type": "AutoDealer",
  "name": "Ô Tô Chuyên Dùng Phú Cường",
  "url": "https://chuyendungphucuong.com",
  "telephone": "0922777703",
  "description": "Chuyên phân phối xe tải chuyên dùng và ô tô khách chính hãng tại miền Nam.",
  "areaServed": ["TP. Hồ Chí Minh", "Tiền Giang", "An Giang", "Đồng Tháp"],
  "department": [
    {
      "@type": "AutoDealer",
      "name": "Chuyên Dùng Phú Cường - Showroom TP. HCM",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "2466 Lê Khả Phiêu, Ấp 16, Xã Bình Chánh",
        "addressLocality": "TP. Hồ Chí Minh",
        "addressCountry": "VN"
      }
    },
    {
      "@type": "AutoDealer",
      "name": "Chuyên Dùng Phú Cường - Showroom Tiền Giang",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "95 Quốc lộ 1A, phường Nhị Quý",
        "addressLocality": "Tiền Giang",
        "addressCountry": "VN"
      }
    },
    {
      "@type": "AutoDealer",
      "name": "Chuyên Dùng Phú Cường - Showroom An Giang",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "26 Trần Hưng Đạo, phường Bình Đức",
        "addressLocality": "An Giang",
        "addressCountry": "VN"
      }
    }
  ]
};
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Chuyên Dùng Phú Cường</title>
    <meta name="description" content={description} />
    <script is:inline src="https://cdn.tailwindcss.com"></script>

    <script type="application/ld+json" set:html={JSON.stringify(dealerSchema)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans pb-20 md:pb-0">
    <!-- Top Bar 3 Showroom -->
    <div class="bg-slate-900 text-amber-400 text-xs py-2 px-4">
      <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-2">
        <span>📍 Hệ thống Showroom: <strong>Bình Chánh, TP.HCM</strong> | <strong>Nhị Quý, Tiền Giang</strong> | <strong>Bình Đức, An Giang</strong></span>
        <span class="text-white">Hotline tư vấn & Cứu hộ: <strong class="text-amber-400">0922 77 77 03</strong></span>
      </div>
    </div>

    <!-- Header hoàn chỉnh với Menu Đa Cấp Tin Tức Chuẩn Xác -->
    <header class="bg-white shadow-sm sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
        <a href="/" class="text-2xl font-extrabold text-blue-900 tracking-tight">
          PHÚ CƯỜNG <span class="text-red-600">AUTO</span>
        </a>
        
        <!-- Menu Desktop -->
        <nav class="hidden md:flex items-center space-x-5 font-semibold text-slate-700 text-sm">
          <a href="/" class="hover:text-red-600">Trang chủ</a>
          
          <!-- 1. Xe Tải Chuyên Dùng -->
          <div class="relative group">
            <button class="flex items-center gap-1 hover:text-red-600 py-2 focus:outline-none cursor-pointer">
              Xe Tải Chuyên Dùng ▾
            </button>
            <div class="absolute top-full left-0 w-80 bg-white shadow-xl rounded-lg py-2 border border-slate-100 hidden group-hover:block">
              <div class="px-4 py-1 text-xs font-bold text-slate-400 uppercase">Xe Cẩu Tự Hành</div>
              <a href="/?cat=xe-tai-chuyen-dung&sub=cau-truc" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-red-600">Xe tải gắn cẩu trục (Unic, Tadano, Soosan)</a>
              <a href="/?cat=xe-tai-chuyen-dung&sub=cau-gap" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-red-600">Xe tải gắn cẩu gập (Palfinger, Sany)</a>
              
              <div class="border-t border-slate-100 my-1"></div>
              <div class="px-4 py-1 text-xs font-bold text-slate-400 uppercase">Xe Bồn Chuyên Dùng</div>
              <a href="/?cat=xe-tai-chuyen-dung&sub=bon-nuoc" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-red-600">Xe bồn chở nước / tưới cây công cộng</a>
              <a href="/?cat=xe-tai-chuyen-dung&sub=bon-hut-chat-thai" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-red-600">Xe bồn hút chất thải, bùn hầm cầu</a>
              <a href="/?cat=xe-tai-chuyen-dung&sub=bon-thuc-pham" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-red-600">Xe chở cám / bồn chở thực phẩm lỏng</a>

              <div class="border-t border-slate-100 my-1"></div>
              <div class="px-4 py-1 text-xs font-bold text-slate-400 uppercase">Xe Ép Rác & Môi Trường</div>
              <a href="/?cat=xe-tai-chuyen-dung&sub=ep-rac" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-red-600">Xe cuốn ép rác (6 khối, 9 khối, 14 khối)</a>
              <a href="/?cat=xe-tai-chuyen-dung&sub=quet-rac" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-red-600">Xe quét rác, hút bụi đường</a>

              <div class="border-t border-slate-100 my-1"></div>
              <div class="px-4 py-1 text-xs font-bold text-slate-400 uppercase">Xe Cứu Hộ & Chở Xe</div>
              <a href="/?cat=xe-tai-chuyen-dung&sub=nang-dau" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-red-600">Xe nâng đầu chở máy / chở xe tải</a>
              <a href="/?cat=xe-tai-chuyen-dung&sub=cuu-ho" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-red-600">Xe cứu hộ giao thông 3 chức năng</a>

              <div class="border-t border-slate-100 my-1"></div>
              <div class="px-4 py-1 text-xs font-bold text-slate-400 uppercase">Xe Ben & Xe Nặng Khác</div>
              <a href="/?cat=xe-tai-chuyen-dung&sub=xe-ben" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-red-600">Xe ben tự đổ (Hino, Isuzu, Foton, Dongfeng)</a>
              <a href="/?cat=xe-tai-chuyen-dung&sub=xe-nang-khac" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-red-600">Xe đầu kéo gắn cẩu / Chở gia súc gia cầm</a>
            </div>
          </div>

          <!-- 2. Ô Tô Khách -->
          <div class="relative group">
            <button class="flex items-center gap-1 hover:text-red-600 py-2 focus:outline-none cursor-pointer">
              Ô Tô Khách ▾
            </button>
            <div class="absolute top-full left-0 w-72 bg-white shadow-xl rounded-lg py-2 border border-slate-100 hidden group-hover:block">
              <div class="px-4 py-1 text-xs font-bold text-slate-400 uppercase">Xe Khách Nhỏ & Trung</div>
              <a href="/?cat=xe-khach&sub=16-cho" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-red-600">Xe khách 16 chỗ (Limousine / Tiêu chuẩn)</a>
              <a href="/?cat=xe-khach&sub=29-cho" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-red-600">Xe khách 29 chỗ (Bầu hơi, Weichai/Hyundai)</a>
              <a href="/?cat=xe-khach&sub=34-cho" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-red-600">Xe khách 34 chỗ ngồi rộng</a>

              <div class="border-t border-slate-100 my-1"></div>
              <div class="px-4 py-1 text-xs font-bold text-slate-400 uppercase">Xe Khách Lớn & Giường Nằm</div>
              <a href="/?cat=xe-khach&sub=47-cho" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-red-600">Xe khách 47 chỗ du lịch đường dài</a>
              <a href="/?cat=xe-khach&sub=giuong-nam" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-red-600">Xe giường nằm Limousine cao cấp</a>
            </div>
          </div>

          <!-- 3. Dịch Vụ -->
          <div class="relative group">
            <a href="/dich-vu" class="flex items-center gap-1 hover:text-red-600 py-2 focus:outline-none cursor-pointer">
              Dịch Vụ ▾
            </a>
            <div class="absolute top-full left-0 w-72 bg-white shadow-xl rounded-lg py-2 border border-slate-100 hidden group-hover:block">
              <a href="/dich-vu" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-red-600 font-bold">Tổng Quan Dịch Vụ</a>
              <div class="border-t border-slate-100 my-1"></div>
              <a href="/dich-vu/cuu-ho-chuyen-dung" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-red-600 text-red-600 font-bold">Cứu Hộ Chuyên Dùng 24/7</a>
              <a href="/dich-vu/sua-xe-chuyen-dung" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-red-600">Sửa Chữa Xe Chuyên Dùng & Động Cơ</a>
              <a href="/dich-vu/sua-thung-bon" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-red-600">Sửa Chữa & Gia Cố Thùng, Bồn Chuyên Dùng</a>
              <a href="/dich-vu/cai-tao-ho-so" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-red-600">Đăng Kiểm & Cải Tạo Hồ Sơ Thiết Kế</a>
            </div>
          </div>

          <!-- 4. Tính Lăn Bánh -->
          <a href="/#bao-gia" class="hover:text-red-600">Tính Lăn Bánh</a>

          <!-- 5. Kiến Thức & Tin Tức (Đã sửa liên kết lọc chuẩn xác qua tham số ?cat=) -->
          <div class="relative group">
            <a href="/tin-tuc" class="flex items-center gap-1 hover:text-red-600 py-2 focus:outline-none cursor-pointer">
              Kiến Thức & Tin Tức ▾
            </a>
            <div class="absolute top-full left-0 w-72 bg-white shadow-xl rounded-lg py-2 border border-slate-100 hidden group-hover:block">
              <a href="/tin-tuc" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-red-600 font-bold">Xem Tất Cả Bài Viết</a>
              <div class="border-t border-slate-100 my-1"></div>
              <a href="/tin-tuc?cat=danh-gia-xe" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-red-600">Đánh Giá & So Sánh Xe</a>
              <a href="/tin-tuc?cat=phap-ly" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-red-600">Thủ Tục Pháp Lý & Đăng Kiểm</a>
              <a href="/tin-tuc?cat=kinh-nghiem" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-red-600">Kinh Nghiệm Vận Tải & Đầu Tư</a>
              <a href="/tin-tuc?cat=tin-tuc" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 hover:text-red-600">Tin Tức & Bàn Giao Xe Showroom</a>
            </div>
          </div>

          <!-- 6. Liên Hệ -->
          <a href="/lien-he" class="hover:text-red-600">Liên Hệ</a>
        </nav>

        <a href="tel:0922777703" data-gtm-event="click_call_header" class="bg-red-600 hover:bg-red-700 text-white font-bold px-4 py-2 rounded-lg text-sm transition">
          📞 0922 77 77 03
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Footer Chi tiết 3 Showroom chính thức -->
    <footer id="he-thong-showroom" class="bg-slate-900 text-slate-300 py-12 mt-16">
      <div class="max-w-7xl mx-auto px-4 grid md:grid-cols-3 gap-8">
        <div>
          <h3 class="text-white font-bold text-lg mb-3">Showroom 1: TP. Hồ Chí Minh</h3>
          <p class="text-sm leading-relaxed">📍 2466 Lê Khả Phiêu, Ấp 16, Xã Bình Chánh, TP. HCM</p>
          <p class="text-sm mt-2 text-amber-400 font-semibold">Hotline: 0922 77 77 03</p>
        </div>
        <div>
          <h3 class="text-white font-bold text-lg mb-3">Showroom 2: Tiền Giang</h3>
          <p class="text-sm leading-relaxed">📍 95 Quốc lộ 1A, phường Nhị Quý, tỉnh Đồng Tháp (Tiền Giang cũ)</p>
          <p class="text-sm mt-2 text-amber-400 font-semibold">Hotline: 0922 77 77 03</p>
        </div>
        <div>
          <h3 class="text-white font-bold text-lg mb-3">Showroom 3: An Giang</h3>
          <p class="text-sm leading-relaxed">📍 26 Trần Hưng Đạo, phường Bình Đức, tỉnh An Giang</p>
          <p class="text-sm mt-2 text-amber-400 font-semibold">Hotline: 0922 77 77 03</p>
        </div>
      </div>
      <div class="max-w-7xl mx-auto px-4 border-t border-slate-800 mt-8 pt-6 text-center text-xs text-slate-500">
        © 2026 Ô Tô Chuyên Dùng Phú Cường. All rights reserved. Hỗ trợ tài chính trả góp 80% toàn miền Nam.
      </div>
    </footer>

    <!-- Thanh Sticky Mobile Bar -->
    <div class="fixed bottom-0 left-0 right-0 bg-white border-t border-slate-200 grid grid-cols-3 md:hidden z-50 shadow-lg">
      <a href="tel:0922777703" class="py-3 text-center bg-red-600 text-white font-bold text-sm">📞 Gọi Ngay</a>
      <a href="https://zalo.me/0922777703" class="py-3 text-center bg-blue-600 text-white font-bold text-sm">💬 Chat Zalo</a>
      <a href="/lien-he" class="py-3 text-center bg-amber-500 text-slate-900 font-bold text-sm">📍 Liên Hệ</a>
    </div>
  </body>
</html>
