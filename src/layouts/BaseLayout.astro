---
import navData from '../data/navigation.json';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Ô TÔ PHÚ CƯỜNG - NHÀ CUNG CẤP VÀ SẢN XUẤT Ô TÔ CHUYÊN DÙNG",
  description = "Ô Tô Phú Cường chuyên cung cấp và sản xuất các dòng ô tô chuyên dùng, xe tải, xe bồn xitec, xe cẩu, xe cứu hộ và ô tô khách. Hỗ trợ trả góp đến 90%, giao xe toàn quốc. Hotline/Zalo: 0922 77 77 03.",
  image = "https://images.unsplash.com/photo-1563720223185-11003d516935?auto=format&fit=crop&w=1200&q=80"
} = Astro.props;

const navigation = Array.isArray(navData?.mainMenu) ? navData.mainMenu : [];
const canonicalURL = Astro.url?.href || "https://phucuongauto.vn";
---

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph / Zalo / Facebook Preview -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:site_name" content="Ô Tô Phú Cường" />
  <meta property="og:locale" content="vi_VN" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <script is:inline src="https://cdn.tailwindcss.com"></script>

  <style is:inline>
    @keyframes pulseRing {
      0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.7); }
      70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(220, 38, 38, 0); }
      100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(220, 38, 38, 0); }
    }
    .hotline-pulse {
      animation: pulseRing 2s infinite;
    }
    @media print {
      .no-print {
        display: none !important;
      }
    }
  </style>
</head>
<body class="bg-gray-50 font-sans text-gray-900 antialiased pb-16 sm:pb-0">
  <header class="bg-white border-b border-gray-200 sticky top-0 z-40 shadow-sm no-print">
    <div class="container mx-auto px-4 max-w-7xl flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex flex-col shrink-0">
        <span class="text-xl sm:text-2xl font-black text-blue-900 leading-none">
          Ô TÔ PHÚ CƯỜNG
        </span>
        <span class="text-[9px] sm:text-[10px] font-extrabold text-red-600 uppercase tracking-wider mt-1">
          Cung Cấp & Sản Xuất Ô Tô Chuyên Dùng
        </span>
      </a>

      <!-- Menu Máy Tính (Desktop) -->
      <nav class="hidden lg:flex items-center gap-7 font-bold text-sm text-slate-700">
        {navigation.map((menu: any) => (
          <div class="relative group py-4">
            <a href={menu.url} class="flex items-center gap-1 hover:text-red-600 transition">
              {menu.title} {menu.children && '▾'}
            </a>
            {menu.children && Array.isArray(menu.children) && (
              <div class="absolute top-full left-0 w-64 bg-white shadow-xl rounded-xl py-2 border border-slate-100 hidden group-hover:block z-50">
                {menu.children.map((sub: any) => (
                  <a href={sub.url} class="block px-4 py-2.5 text-xs font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-600 transition">
                    {sub.title}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </nav>

      <!-- Cụm nút bên phải: Hotline, Zalo & Nút mở Menu Di Động -->
      <div class="flex items-center gap-2 sm:gap-2.5">
        <a 
          href="https://zalo.me/0922777703" 
          target="_blank" 
          rel="noopener noreferrer"
          class="hidden sm:flex bg-blue-600 hover:bg-blue-700 text-white font-extrabold px-3.5 py-2.5 rounded-xl text-xs sm:text-sm transition shadow-sm items-center gap-1.5"
        >
          💬 <span>Zalo</span>
        </a>
        <a 
          href="tel:0922777703" 
          class="bg-red-600 hover:bg-red-700 text-white font-extrabold px-3.5 sm:px-4 py-2.5 rounded-xl text-xs sm:text-sm transition shadow-md flex items-center gap-1.5"
        >
          📞 <span>0922 77 77 03</span>
        </a>

        <!-- Nút Hamburger Menu chỉ hiện trên Điện thoại / Máy tính bảng (< 1024px) -->
        <button 
          type="button" 
          id="btnMobileMenu" 
          aria-label="Mở menu điều hướng"
          class="lg:hidden p-2.5 rounded-xl border border-slate-200 text-slate-700 hover:bg-slate-100 transition cursor-pointer"
        >
          <svg id="iconMenuOpen" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="iconMenuClose" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Khung Menu Di Động Xổ Xuống (Mobile Drawer) -->
    <div id="mobileMenuDrawer" class="hidden lg:hidden bg-white border-t border-gray-200 px-4 py-4 space-y-2 shadow-xl max-h-[80vh] overflow-y-auto">
      {navigation.map((menu: any, idx: number) => (
        <div class="border-b border-gray-100 last:border-0 pb-2">
          <div class="flex items-center justify-between">
            <a href={menu.url} class="py-2 font-bold text-slate-800 hover:text-blue-600 text-sm flex-1">
              {menu.title}
            </a>
            {menu.children && Array.isArray(menu.children) && (
              <button 
                type="button" 
                data-target={`mobSub-${idx}`}
                class="btn-mob-sub px-3 py-1.5 text-xs font-bold bg-slate-100 text-slate-700 rounded-lg cursor-pointer"
              >
                Mở rộng ▾
              </button>
            )}
          </div>
          {menu.children && Array.isArray(menu.children) && (
            <div id={`mobSub-${idx}`} class="hidden pl-4 mt-1 space-y-1 border-l-2 border-blue-600 bg-slate-50/60 rounded-r-xl py-2">
              {menu.children.map((sub: any) => (
                <a href={sub.url} class="block py-2 px-3 text-xs font-semibold text-slate-600 hover:text-blue-600">
                  • {sub.title}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </header>

  <slot />

  <footer class="bg-slate-900 text-slate-400 py-12 px-4 mt-20 no-print">
    <div class="container mx-auto max-w-7xl grid grid-cols-1 md:grid-cols-3 gap-8 text-sm">
      <div>
        <span class="text-lg font-black text-white block mb-1">Ô TÔ PHÚ CƯỜNG</span>
        <span class="text-xs font-bold text-red-400 uppercase block mb-3">Nhà Cung Cấp Và Sản Xuất Ô Tô Chuyên Dùng</span>
        <p class="leading-relaxed">Đơn vị uy tín hàng đầu trong lĩnh vực phân phối, đóng mới xe chuyên dùng và ô tô khách tại miền Nam. Hỗ trợ vay ngân hàng đến 90%.</p>
      </div>
      <div>
        <h4 class="text-white font-bold mb-3">Hệ thống Showroom</h4>
        <p class="mb-2">📍 Showroom 1: 2466 Lê Khả Phiêu, Xã Bình Chánh, TP. Hồ Chí Minh</p>
        <p class="mb-2">📍 Showroom 2: 95 Quốc lộ 1A, Nhị Quý, Tiền Giang</p>
        <p>📍 Showroom 3: 26 Trần Hưng Đạo, Bình Đức, An Giang</p>
      </div>
      <div>
        <h4 class="text-white font-bold mb-3">Tổng đài liên hệ 24/7</h4>
        <p class="mb-2">Hotline / Zalo: <a href="tel:0922777703" class="text-white font-extrabold hover:text-red-400">0922 77 77 03 (Mr. Hoàng Vũ)</a></p>
        <p class="mb-3">Email: <a href="mailto:chuyendungphucuong@gmail.com" class="text-white hover:underline">chuyendungphucuong@gmail.com</a></p>
        <a href="/tinh-lan-banh" class="inline-block bg-blue-700 hover:bg-blue-600 text-white text-xs font-bold px-4 py-2 rounded-lg transition">
          🧮 Công Cụ Tính Giá Lăn Bánh & Xuất PDF
        </a>
      </div>
    </div>
  </footer>

  <!-- CỤM NÚT NỔI TRÊN MÁY TÍNH (DESKTOP FLOATING BUTTONS) -->
  <div class="hidden sm:flex fixed right-5 bottom-6 z-40 flex-col gap-3 no-print">
    <a
      href="/tinh-lan-banh"
      title="Tính giá lăn bánh & Trả góp"
      class="bg-slate-800 hover:bg-slate-900 text-white font-bold px-4 py-2.5 rounded-full shadow-lg flex items-center gap-2 text-xs transition hover:-translate-x-1 border border-slate-700"
    >
      <span>🧮</span>
      <span>Tính Lăn Bánh</span>
    </a>
    <a
      href="https://zalo.me/0922777703"
      target="_blank"
      rel="noopener noreferrer"
      title="Chat Zalo với Mr. Hoàng Vũ"
      class="bg-blue-600 hover:bg-blue-700 text-white font-extrabold px-4 py-3 rounded-full shadow-lg flex items-center gap-2 text-xs transition hover:-translate-x-1"
    >
      <span class="bg-white text-blue-600 font-black px-1.5 py-0.5 rounded text-[10px]">Zalo</span>
      <span>Chat Báo Giá</span>
    </a>
    <a
      href="tel:0922777703"
      title="Gọi Hotline 0922 77 77 03"
      class="hotline-pulse bg-red-600 hover:bg-red-700 text-white font-extrabold px-4 py-3 rounded-full shadow-xl flex items-center gap-2 text-xs transition"
    >
      <span>📞</span>
      <span>0922 77 77 03</span>
    </a>
  </div>

  <!-- THANH CÔNG CỤ CỐ ĐỊNH DƯỚI ĐÁY TRÊN ĐIỆN THOẠI (MOBILE STICKY BAR) -->
  <div class="sm:hidden fixed bottom-0 left-0 right-0 z-40 bg-white border-t border-gray-200 shadow-2xl grid grid-cols-3 gap-1 p-1.5 no-print">
    <a
      href="/tinh-lan-banh"
      class="bg-slate-100 active:bg-slate-200 text-slate-800 font-bold py-2.5 rounded-xl flex flex-col items-center justify-center text-[11px]"
    >
      <span class="text-sm">🧮</span>
      <span>Tính Giá</span>
    </a>
    <a
      href="https://zalo.me/0922777703"
      target="_blank"
      rel="noopener noreferrer"
      class="bg-blue-600 active:bg-blue-700 text-white font-extrabold py-2.5 rounded-xl flex flex-col items-center justify-center text-[11px]"
    >
      <span class="text-sm">💬</span>
      <span>Chat Zalo</span>
    </a>
    <a
      href="tel:0922777703"
      class="bg-red-600 active:bg-red-700 text-white font-extrabold py-2.5 rounded-xl flex flex-col items-center justify-center text-[11px]"
    >
      <span class="text-sm">📞</span>
      <span>Gọi Ngay</span>
    </a>
  </div>

  <!-- Script điều khiển Menu Di Động -->
  <script is:inline>
    const btnMobileMenu = document.getElementById('btnMobileMenu');
    const mobileMenuDrawer = document.getElementById('mobileMenuDrawer');
    const iconOpen = document.getElementById('iconMenuOpen');
    const iconClose = document.getElementById('iconMenuClose');

    btnMobileMenu?.addEventListener('click', () => {
      const isHidden = mobileMenuDrawer.classList.contains('hidden');
      if (isHidden) {
        mobileMenuDrawer.classList.remove('hidden');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
      } else {
        mobileMenuDrawer.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      }
    });

    document.querySelectorAll('.btn-mob-sub').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const targetId = e.currentTarget.getAttribute('data-target');
        const subEl = document.getElementById(targetId);
        if (subEl) {
          subEl.classList.toggle('hidden');
        }
      });
    });
  </script>
</body>
</html>
