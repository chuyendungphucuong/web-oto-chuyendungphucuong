---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import postsData from "../../../data/posts.json";
import navData from "../../../data/navigation.json";

const url = new URL(Astro.request.url);
const slug = url.searchParams.get("slug");

const posts = Array.isArray(postsData) ? postsData : [];
const post = posts.find((p) => p.slug === slug) || null;
const isEditMode = !!post;

const mainMenu = Array.isArray(navData?.mainMenu) ? navData.mainMenu : [];
const newsMenu = mainMenu.find((m) => typeof m.url === "string" && m.url.includes("/tin-tuc"));
const dynamicPostCategories = [];

if (newsMenu && Array.isArray(newsMenu.children)) {
  newsMenu.children.forEach((child) => {
    if (child.title && !child.title.toLowerCase().includes("xem tất cả")) {
      dynamicPostCategories.push(child.title);
    }
  });
}

const defaultCategories = [
  "Đánh Giá & So Sánh Xe",
  "Thủ Tục Pháp Lý & Đăng Kiểm",
  "Kinh Nghiệm Vận Tải & Đầu Tư",
  "Tin Tức & Bàn Giao Xe Showroom"
];

const postCategories = dynamicPostCategories.length > 0 ? dynamicPostCategories : defaultCategories;

const rawPostContent = (post?.content || "")
  .replace(/&lt;/g, "<")
  .replace(/&gt;/g, ">");
---

<AdminLayout title={isEditMode ? "Chỉnh Sửa Bài Viết Tin Tức" : "Viết Bài Viết Mới"} activeTab="posts">
  <style is:global>
    #visualEditor { min-height: 460px; max-height: 720px; overflow-y: auto; outline: none; line-height: 1.75; color: #1e293b; font-size: 15px; }
    #visualEditor h2 { font-size: 1.4rem; font-weight: 800; color: #0f172a; margin: 1.25rem 0 0.6rem; }
    #visualEditor h3 { font-size: 1.2rem; font-weight: 700; color: #1e3a8a; margin: 1rem 0 0.5rem; }
    #visualEditor h4 { font-size: 1.05rem; font-weight: 700; color: #334155; margin: 0.8rem 0 0.4rem; }
    #visualEditor p { margin-bottom: 0.75rem; }
    #visualEditor ul { list-style-type: disc; padding-left: 1.5rem; margin-bottom: 0.85rem; }
    #visualEditor ol { list-style-type: decimal; padding-left: 1.5rem; margin-bottom: 0.85rem; }
    #visualEditor li { margin-bottom: 0.35rem; }
    #visualEditor a { color: #2563eb; text-decoration: underline; font-weight: 600; }
    #visualEditor img { max-width: 100%; height: auto; border-radius: 0.75rem; margin: 1rem auto; border: 1px solid #cbd5e1; }
    #visualEditor table { width: 100%; border-collapse: collapse; margin: 1.25rem 0; font-size: 14px; background: #fff; }
    #visualEditor th { background-color: #1e3a8a; color: #ffffff; font-weight: 700; padding: 10px 12px; border: 1px solid #94a3b8; text-align: left; }
    #visualEditor td { padding: 10px 12px; border: 1px solid #cbd5e1; vertical-align: top; }
    #visualEditor tr:nth-child(even) td { background-color: #f8fafc; }
    #visualEditor td:focus, #visualEditor th:focus { outline: 2px solid #f59e0b; background-color: #fffbeb !important; color: #0f172a; }
  </style>

  <div class="max-w-5xl mx-auto space-y-6 pb-12">
    <div class="flex items-center justify-between">
      <a href="/admin/posts" class="text-sm font-bold text-blue-600 hover:underline">&larr; Quay lại danh sách bài viết</a>
      <button type="button" id="btnSavePost" class="bg-red-600 hover:bg-red-700 text-white font-extrabold px-8 py-3 rounded-xl shadow-lg cursor-pointer transition text-sm">
        💾 {isEditMode ? "LƯU THAY ĐỔI BÀI VIẾT" : "XUẤT BẢN BÀI VIẾT MỚI"}
      </button>
    </div>

    <input type="hidden" id="isEditMode" value={isEditMode ? "true" : "false"} />

    <!-- KHỐI TRỢ LÝ AI NHẬP LIỆU NHANH 1-CLICK -->
    <div class="bg-gradient-to-r from-slate-900 via-blue-950 to-slate-900 text-white p-6 rounded-2xl shadow-lg border border-blue-800 space-y-4">
      <div class="border-b border-white/15 pb-3">
        <span class="bg-amber-400 text-slate-950 text-[10px] font-black px-2.5 py-0.5 rounded uppercase tracking-wider">⚡ Trợ Lý Tin Tức Siêu Tốc</span>
        <h2 class="text-base sm:text-lg font-extrabold mt-1">Tự Động Điền Bài Viết Tin Tức Chuẩn SEO & AI Overviews (1-Click)</h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 text-sm">
        <div class="lg:col-span-8 space-y-2">
          <label class="block text-xs font-bold text-blue-200">
            Dán "Mã Nhập Liệu Bài Viết (JSON)" từ trợ lý AI vào đây:
          </label>
          <textarea id="aiPostQuickInput" rows="4" placeholder="Dán khối mã JSON bài viết vào đây..." class="w-full p-3 rounded-xl bg-slate-800/90 border border-slate-600 text-white font-mono text-xs focus:border-amber-400 outline-none"></textarea>
        </div>

        <div class="lg:col-span-4 flex flex-col justify-end gap-2.5">
          <button type="button" id="btnApplyPostJson" class="w-full bg-amber-400 hover:bg-amber-500 text-slate-950 font-black py-3 px-4 rounded-xl shadow-md transition cursor-pointer text-xs sm:text-sm flex items-center justify-center gap-2">
            🚀 Tự Động Điền Bài Viết (1-Click)
          </button>
          <button type="button" id="btnGeneratePostTemplate" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-2.5 px-4 rounded-xl transition cursor-pointer text-xs flex items-center justify-center gap-1.5">
            ✍️ Tự Dựng Khung Bài Từ Tiêu Đề
          </button>
          <p id="aiPostStatus" class="text-[11px] text-emerald-400 font-bold hidden"></p>
        </div>
      </div>
    </div>

    <!-- TRÌNH SOẠN THẢO VÀ BẢNG TÍNH TRỰC QUAN -->
    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
      <h2 class="text-base font-bold text-white bg-blue-700 p-3 rounded-xl">Trình Soạn Thảo Bài Viết & Bảng So Sánh Trực Quan</h2>

      <div class="space-y-4 text-sm">
        <div>
          <label class="block font-bold text-slate-700 mb-1">Tiêu đề bài viết (*):</label>
          <input type="text" id="inputTitle" value={post?.title || ""} placeholder="Nhập tiêu đề chuẩn SEO..." class="w-full p-3 border rounded-xl font-bold text-slate-900 text-base outline-none focus:ring-2 focus:ring-blue-600" />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block font-bold text-slate-700 mb-1">Mã định danh URL (Slug) (*):</label>
            <input type="text" id="inputSlug" value={post?.slug || ""} placeholder="vd: thu-tuc-dang-kiem-xe" class={"w-full p-3 border rounded-xl font-mono text-xs " + (isEditMode ? "bg-slate-100" : "")} readonly={isEditMode} />
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">Chuyên mục bài viết:</label>
            <select id="inputCategory" class="w-full p-3 border rounded-xl bg-white font-semibold outline-none">
              {postCategories.map((cat) => (
                <option value={cat} selected={post?.category?.toLowerCase() === cat.toLowerCase()}>
                  {cat}
                </option>
              ))}
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block font-bold text-slate-700 mb-1">Tác giả:</label>
            <input type="text" id="inputAuthor" value={post?.author || "Chuyên gia Phú Cường"} class="w-full p-3 border rounded-xl outline-none" />
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1">Ảnh đại diện bài viết:</label>
            <div class="flex gap-2">
              <input type="text" id="inputImage" value={post?.image || ""} placeholder="/images/posts/..." class="flex-1 p-3 border rounded-xl font-mono text-xs outline-none" />
              <input type="file" id="fileBannerPost" accept="image/*" class="hidden" />
              <button type="button" id="btnUploadBanner" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-3.5 rounded-xl text-xs cursor-pointer shrink-0 transition">
                📤 Chọn ảnh
              </button>
            </div>
          </div>
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1">Tóm tắt ngắn chuẩn AI Overviews (Summary):</label>
          <textarea id="inputSummary" rows="3" class="w-full p-3 border rounded-xl outline-none">{post?.summary || ""}</textarea>
        </div>

        <!-- THANH CÔNG CỤ SOẠN THẢO & QUẢN LÝ BẢNG TÍNH -->
        <div class="border border-slate-300 rounded-2xl overflow-hidden shadow-sm">
          <div class="bg-slate-100 p-2.5 border-b border-slate-300 flex flex-wrap items-center gap-1.5">
            <button type="button" data-cmd="formatBlock" data-val="H2" class="tb-btn px-2.5 py-1.5 bg-white border border-slate-300 rounded-lg font-extrabold text-xs hover:bg-blue-50 cursor-pointer">H2</button>
            <button type="button" data-cmd="formatBlock" data-val="H3" class="tb-btn px-2.5 py-1.5 bg-white border border-slate-300 rounded-lg font-bold text-xs hover:bg-blue-50 cursor-pointer">H3</button>
            <button type="button" data-cmd="formatBlock" data-val="P" class="tb-btn px-2.5 py-1.5 bg-white border border-slate-300 rounded-lg text-xs hover:bg-blue-50 cursor-pointer">Đoạn văn</button>
            <span class="h-5 w-px bg-slate-300 mx-1"></span>
            <button type="button" data-cmd="bold" class="tb-btn px-2.5 py-1.5 bg-white border border-slate-300 rounded-lg font-black text-xs hover:bg-blue-50 cursor-pointer">B</button>
            <button type="button" data-cmd="italic" class="tb-btn px-2.5 py-1.5 bg-white border border-slate-300 rounded-lg italic text-xs hover:bg-blue-50 cursor-pointer">I</button>
            <button type="button" data-cmd="underline" class="tb-btn px-2.5 py-1.5 bg-white border border-slate-300 rounded-lg underline text-xs hover:bg-blue-50 cursor-pointer">U</button>
            <span class="h-5 w-px bg-slate-300 mx-1"></span>
            <button type="button" data-cmd="insertUnorderedList" class="tb-btn px-2.5 py-1.5 bg-white border border-slate-300 rounded-lg text-xs hover:bg-blue-50 cursor-pointer">• Danh sách</button>
            <button type="button" data-cmd="insertOrderedList" class="tb-btn px-2.5 py-1.5 bg-white border border-slate-300 rounded-lg text-xs hover:bg-blue-50 cursor-pointer">1. Danh sách</button>
            <button type="button" id="btnAddLink" class="px-2.5 py-1.5 bg-white border border-slate-300 rounded-lg text-xs hover:bg-blue-50 cursor-pointer font-semibold text-blue-700">🔗 Chèn Link</button>
            <button type="button" id="btnAddInlineImg" class="px-2.5 py-1.5 bg-white border border-slate-300 rounded-lg text-xs hover:bg-blue-50 cursor-pointer font-semibold text-emerald-700">🖼️ Chèn Ảnh</button>
            <input type="file" id="fileInlineImg" accept="image/*" class="hidden" />
          </div>

          <!-- THANH CÔNG CỤ CHUYÊN BIỆT CHO BẢNG TÍNH (TABLE TOOLS) -->
          <div class="bg-blue-50/90 p-2.5 border-b border-blue-200 flex flex-wrap items-center gap-2 text-xs">
            <span class="font-extrabold text-blue-900 uppercase tracking-wider flex items-center gap-1">📊 Công cụ Bảng so sánh:</span>
            <div class="flex items-center gap-1 bg-white px-2 py-1 rounded-lg border border-blue-200">
              <span>Dòng:</span>
              <input type="number" id="tblRows" value="5" min="1" max="30" class="w-11 p-1 border rounded text-center font-bold" />
              <span>Cột:</span>
              <input type="number" id="tblCols" value="3" min="1" max="10" class="w-11 p-1 border rounded text-center font-bold" />
              <button type="button" id="btnInsertTable" class="bg-blue-700 hover:bg-blue-800 text-white font-bold px-2.5 py-1 rounded-md cursor-pointer transition">+ Tạo Bảng Mới</button>
            </div>
            <button type="button" id="btnAddRow" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-2.5 py-1.5 rounded-lg cursor-pointer transition">+ Thêm dòng dưới</button>
            <button type="button" id="btnDelRow" class="bg-amber-600 hover:bg-amber-700 text-white font-bold px-2.5 py-1.5 rounded-lg cursor-pointer transition">- Xóa dòng đang chọn</button>
            <button type="button" id="btnAddCol" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-2.5 py-1.5 rounded-lg cursor-pointer transition">+ Thêm cột phải</button>
            <button type="button" id="btnDelCol" class="bg-rose-600 hover:bg-rose-700 text-white font-bold px-2.5 py-1.5 rounded-lg cursor-pointer transition">- Xóa cột đang chọn</button>
            <button type="button" id="btnDelTable" class="bg-slate-700 hover:bg-slate-900 text-white font-bold px-2.5 py-1.5 rounded-lg cursor-pointer transition">🗑️ Xóa bảng</button>
          </div>

          <!-- VÙNG SOẠN THẢO TRỰC QUAN CONTENTEDITABLE (GIỮ 100% BẢNG BIỂU) -->
          <div id="visualEditor" contenteditable="true" class="p-5 bg-white"></div>
        </div>

        <!-- KHỐI QUẢN LÝ MÃ HTML ĐỒNG BỘ 2 CHIỀU TỨC THÌ -->
        <div class="bg-slate-900 text-white p-5 rounded-xl border border-slate-700 space-y-3 mt-4">
          <div class="flex items-center justify-between">
            <label class="block font-extrabold text-amber-400 text-xs uppercase tracking-wider">
              🛠️ Mã Nguồn HTML Bài Viết (Tự động đồng bộ 2 chiều với khung soạn thảo):
            </label>
          </div>
          <textarea id="inputRawHtml" rows="6" placeholder="Mã HTML chi tiết..." class="w-full p-3 rounded-lg bg-slate-950 border border-slate-700 text-emerald-400 font-mono text-xs outline-none focus:border-amber-400"></textarea>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ savedHtml: rawPostContent }}>
    const inputTitle = document.getElementById("inputTitle");
    const inputSlug = document.getElementById("inputSlug");
    const inputImage = document.getElementById("inputImage");
    const visualEditor = document.getElementById("visualEditor");
    const inputRawHtml = document.getElementById("inputRawHtml");
    const isEditMode = document.getElementById("isEditMode").value === "true";

    let activeTableCell = null;

    function setEditorHtml(html) {
      visualEditor.innerHTML = html || "";
      inputRawHtml.value = html || "";
    }

    if (savedHtml) {
      setEditorHtml(savedHtml);
    }

    visualEditor.addEventListener("input", () => {
      inputRawHtml.value = visualEditor.innerHTML;
    });

    inputRawHtml.addEventListener("input", () => {
      visualEditor.innerHTML = inputRawHtml.value;
    });

    visualEditor.addEventListener("click", (e) => {
      const cell = e.target.closest("td, th");
      if (cell) activeTableCell = cell;
    });

    function makeSlug(str) {
      return (str || "").toLowerCase()
        .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
        .replace(/[đĐ]/g, "d")
        .replace(/([^0-9a-z-\s])/g, "")
        .trim()
        .replace(/(\s+)/g, "-");
    }

    if (!isEditMode && inputTitle) {
      inputTitle.addEventListener("input", () => {
        inputSlug.value = makeSlug(inputTitle.value);
      });
    }

    // Các nút định dạng văn bản
    document.querySelectorAll(".tb-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const cmd = btn.getAttribute("data-cmd");
        const val = btn.getAttribute("data-val") || null;
        visualEditor.focus();
        document.execCommand(cmd, false, val);
        inputRawHtml.value = visualEditor.innerHTML;
      });
    });

    document.getElementById("btnAddLink")?.addEventListener("click", () => {
      const url = prompt("Nhập đường dẫn liên kết (URL):", "https://chuyendungphucuong.vn/san-pham/");
      if (url) {
        visualEditor.focus();
        document.execCommand("createLink", false, url);
        inputRawHtml.value = visualEditor.innerHTML;
      }
    });

    // Tải ảnh đại diện
    const fileBanner = document.getElementById("fileBannerPost");
    document.getElementById("btnUploadBanner")?.addEventListener("click", () => fileBanner.click());
    fileBanner?.addEventListener("change", async () => {
      const file = fileBanner.files[0];
      if (!file) return;
      const formData = new FormData();
      formData.append("image", file);
      formData.append("title", inputTitle.value.trim() || "tin-tuc-phu-cuong");
      formData.append("type", "posts");
      try {
        const res = await fetch("/api/upload-image", { method: "POST", body: formData });
        const result = await res.json();
        if (result.success) inputImage.value = result.url;
        else alert("❌ Lỗi tải ảnh: " + result.message);
      } catch (err) {
        alert("❌ Lỗi kết nối khi tải ảnh đại diện!");
      }
    });

    // Chèn ảnh vào giữa bài viết
    const fileInlineImg = document.getElementById("fileInlineImg");
    document.getElementById("btnAddInlineImg")?.addEventListener("click", () => fileInlineImg.click());
    fileInlineImg?.addEventListener("change", async () => {
      const file = fileInlineImg.files[0];
      if (!file) return;
      const formData = new FormData();
      formData.append("image", file);
      formData.append("title", inputTitle.value.trim() || "phu-cuong-auto");
      formData.append("type", "posts");
      try {
        const res = await fetch("/api/upload-image", { method: "POST", body: formData });
        const result = await res.json();
        if (result.success) {
          visualEditor.focus();
          document.execCommand("insertImage", false, result.url);
          inputRawHtml.value = visualEditor.innerHTML;
        } else alert("❌ Tải ảnh thất bại: " + result.message);
      } catch (err) {
        alert("❌ Lỗi kết nối khi tải ảnh!");
      }
    });

    // CÔNG CỤ XỬ LÝ BẢNG TÍNH (TẠO BẢNG, THÊM/XÓA DÒNG CỘT)
    document.getElementById("btnInsertTable")?.addEventListener("click", () => {
      const rows = parseInt(document.getElementById("tblRows").value, 10) || 4;
      const cols = parseInt(document.getElementById("tblCols").value, 10) || 3;
      let html = "<div style=\"overflow-x:auto;margin:20px 0;\"><table><thead><tr>";
      for (let c = 1; c <= cols; c++) {
        html += "<th>Tiêu đề cột " + c + "</th>";
      }
      html += "</tr></thead><tbody>";
      for (let r = 1; r <= rows; r++) {
        html += "<tr>";
        for (let c = 1; c <= cols; c++) {
          html += "<td>Nội dung ô " + r + "." + c + "</td>";
        }
        html += "</tr>";
      }
      html += "</tbody></table></div><p><br></p>";
      visualEditor.focus();
      document.execCommand("insertHTML", false, html);
      inputRawHtml.value = visualEditor.innerHTML;
    });

    document.getElementById("btnAddRow")?.addEventListener("click", () => {
      if (!activeTableCell) return alert("⚠️ Hãy nhấp chuột vào 1 ô bất kỳ trong bảng trước!");
      const tr = activeTableCell.closest("tr");
      if (!tr) return;
      const newRow = tr.cloneNode(true);
      newRow.querySelectorAll("td, th").forEach((cell) => { cell.innerHTML = "Nhập nội dung..."; });
      tr.parentNode.insertBefore(newRow, tr.nextSibling);
      inputRawHtml.value = visualEditor.innerHTML;
    });

    document.getElementById("btnDelRow")?.addEventListener("click", () => {
      if (!activeTableCell) return alert("⚠️ Hãy nhấp chuột vào 1 ô thuộc dòng cần xóa!");
      const tr = activeTableCell.closest("tr");
      if (tr) {
        tr.remove();
        activeTableCell = null;
        inputRawHtml.value = visualEditor.innerHTML;
      }
    });

    document.getElementById("btnAddCol")?.addEventListener("click", () => {
      if (!activeTableCell) return alert("⚠️ Hãy nhấp chuột vào 1 ô trong bảng trước!");
      const table = activeTableCell.closest("table");
      const colIndex = Array.from(activeTableCell.parentNode.children).indexOf(activeTableCell);
      table.querySelectorAll("tr").forEach((row) => {
        const refCell = row.children[colIndex];
        if (refCell) {
          const newCell = document.createElement(refCell.tagName);
          newCell.innerHTML = refCell.tagName === "TH" ? "Cột mới" : "Nội dung...";
          refCell.parentNode.insertBefore(newCell, refCell.nextSibling);
        }
      });
      inputRawHtml.value = visualEditor.innerHTML;
    });

    document.getElementById("btnDelCol")?.addEventListener("click", () => {
      if (!activeTableCell) return alert("⚠️ Hãy nhấp chuột vào 1 ô thuộc cột cần xóa!");
      const table = activeTableCell.closest("table");
      const colIndex = Array.from(activeTableCell.parentNode.children).indexOf(activeTableCell);
      table.querySelectorAll("tr").forEach((row) => {
        if (row.children[colIndex]) row.children[colIndex].remove();
      });
      activeTableCell = null;
      inputRawHtml.value = visualEditor.innerHTML;
    });

    document.getElementById("btnDelTable")?.addEventListener("click", () => {
      if (!activeTableCell) return alert("⚠️ Hãy nhấp chuột vào bảng cần xóa!");
      const table = activeTableCell.closest("table");
      if (table && confirm("Bạn chắc chắn muốn xóa bảng này?")) {
        table.remove();
        activeTableCell = null;
        inputRawHtml.value = visualEditor.innerHTML;
      }
    });

    // 1-Click JSON
    document.getElementById("btnApplyPostJson")?.addEventListener("click", () => {
      const rawText = document.getElementById("aiPostQuickInput").value.trim();
      const statusEl = document.getElementById("aiPostStatus");
      if (!rawText) return alert("⚠️ Vui lòng dán gói mã JSON bài viết vào ô trước khi bấm!");
      try {
        const cleanedJson = rawText.replace(/^```json\s*/i, "").replace(/```\s*$/, "").trim();
        const data = JSON.parse(cleanedJson);
        if (data.title) {
          inputTitle.value = data.title;
          if (!isEditMode) inputSlug.value = data.slug || makeSlug(data.title);
        }
        if (!isEditMode && data.slug) inputSlug.value = data.slug;
        if (data.author) document.getElementById("inputAuthor").value = data.author;
        if (data.image) inputImage.value = data.image;
        if (data.summary) document.getElementById("inputSummary").value = data.summary;
        if (data.category) {
          const selectCat = document.getElementById("inputCategory");
          for (let i = 0; i < selectCat.options.length; i++) {
            if (selectCat.options[i].value.toLowerCase().includes(data.category.toLowerCase()) || data.category.toLowerCase().includes("so sánh") && selectCat.options[i].value.toLowerCase().includes("so sánh")) {
              selectCat.selectedIndex = i;
              break;
            }
          }
        }
        if (data.content) {
          setEditorHtml(data.content);
        }
        if (statusEl) {
          statusEl.classList.remove("hidden");
          statusEl.innerText = "✅ Đã điền tự động toàn bộ bài viết và giữ nguyên 100% Bảng biểu!";
        }
      } catch (e) {
        alert("❌ Định dạng mã JSON chưa khớp!");
      }
    });

    // Lưu bài viết
    document.getElementById("btnSavePost")?.addEventListener("click", async () => {
      const title = inputTitle.value.trim();
      const slug = inputSlug.value.trim();
      const category = document.getElementById("inputCategory").value;
      const author = document.getElementById("inputAuthor").value.trim();
      const image = inputImage.value.trim();
      const summary = document.getElementById("inputSummary").value.trim();
      const content = visualEditor.innerHTML;
      if (!title || !slug) return alert("❌ Vui lòng nhập đầy đủ Tiêu đề và Slug bài viết!");
      const payload = { slug, title, category, author, image, summary, content };
      try {
        const res = await fetch("/api/update-post", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });
        const result = await res.json();
        if (result.success) {
          alert("🎉 " + result.message);
          window.location.href = "/admin/posts";
        } else alert("❌ Lỗi: " + result.message);
      } catch (err) {
        alert("❌ Lỗi kết nối đến máy chủ!");
      }
    });
  </script>
</AdminLayout>