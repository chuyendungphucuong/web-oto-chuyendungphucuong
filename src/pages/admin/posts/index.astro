---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import postsData from "../../../data/posts.json";

const posts = Array.isArray(postsData) ? postsData : [];
const categories = Array.from(new Set(posts.map((p: any) => String(p.category || "").trim()).filter(Boolean)));
---

<AdminLayout title="Quản Lý Tin Tức & Bài Viết" activeTab="posts">
  <div class="space-y-6">
    <!-- Thanh tiêu đề & Nút thêm bài viết mới -->
    <div class="bg-white p-5 sm:p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900">📝 Quản Lý Tin Tức &amp; Nhật Ký Bàn Giao</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Tổng cộng <strong class="text-blue-700">{posts.length}</strong> bài viết đang hiển thị trên hệ thống.
        </p>
      </div>
      <div class="flex items-center gap-3">
        <a
          href="/tin-tuc"
          target="_blank"
          class="px-4 py-2.5 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs sm:text-sm transition"
        >
          👁️ Xem trang Tin tức
        </a>
        <a
          href="/admin/posts/edit"
          class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-extrabold text-xs sm:text-sm shadow-sm transition flex items-center gap-1.5"
        >
          <span>➕</span> Viết Bài Mới
        </a>
      </div>
    </div>

    <!-- Bộ lọc tìm kiếm & Chuyên mục -->
    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row gap-3">
      <div class="flex-1">
        <input
          type="text"
          id="adminPostSearch"
          placeholder="🔍 Tìm nhanh theo tiêu đề bài viết hoặc slug..."
          class="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm outline-none focus:border-blue-600"
        />
      </div>
      <div class="sm:w-64">
        <select
          id="adminPostCatFilter"
          class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm font-semibold text-slate-700 bg-white outline-none focus:border-blue-600"
        >
          <option value="all">Tất cả chuyên mục ({posts.length})</option>
          {categories.map((cat) => (
            <option value={cat}>{cat}</option>
          ))}
        </select>
      </div>
    </div>

    <!-- Bảng danh sách bài viết -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-xs uppercase text-slate-600 font-extrabold">
              <th class="p-4 w-20">Ảnh</th>
              <th class="p-4">Tiêu đề bài viết</th>
              <th class="p-4 w-48">Chuyên mục</th>
              <th class="p-4 w-32">Ngày đăng</th>
              <th class="p-4 w-44 text-right">Thao tác</th>
            </tr>
          </thead>
          <tbody id="adminPostsTableBody" class="divide-y divide-slate-200">
            {posts.map((post: any) => (
              <tr
                class="admin-post-row hover:bg-slate-50/80 transition"
                data-title={String(post.title || "").toLowerCase()}
                data-slug={String(post.slug || "").toLowerCase()}
                data-cat={String(post.category || "").trim()}
              >
                <td class="p-3.5">
                  <div class="w-16 h-12 rounded-lg bg-slate-100 border border-slate-200 overflow-hidden">
                    <img
                      src={post.image || "/Logo.png"}
                      alt={post.title}
                      loading="lazy"
                      class="w-full h-full object-cover"
                    />
                  </div>
                </td>
                <td class="p-3.5">
                  <a
                    href={`/admin/posts/edit?slug=${encodeURIComponent(post.slug)}`}
                    class="font-bold text-slate-900 hover:text-blue-700 line-clamp-2 leading-snug"
                  >
                    {post.title}
                  </a>
                  <span class="text-[11px] text-slate-400 font-mono block mt-0.5">/{post.slug}</span>
                </td>
                <td class="p-3.5">
                  <span class="inline-block bg-blue-50 text-blue-700 border border-blue-100 text-xs font-bold px-2.5 py-1 rounded-lg">
                    {post.category || "Tin tức"}
                  </span>
                </td>
                <td class="p-3.5 text-xs text-slate-600 font-medium">
                  {post.date || "—"}
                </td>
                <td class="p-3.5 text-right whitespace-nowrap space-x-1.5">
                  <a
                    href={`/tin-tuc/${post.slug}`}
                    target="_blank"
                    title="Xem bài viết ngoài web"
                    class="inline-flex items-center px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition"
                  >
                    👁️
                  </a>
                  <a
                    href={`/admin/posts/edit?slug=${encodeURIComponent(post.slug)}`}
                    class="inline-flex items-center px-3 py-1.5 rounded-lg bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 text-xs font-bold transition"
                  >
                    ✏️ Sửa
                  </a>
                  <button
                    type="button"
                    data-delete-slug={post.slug}
                    data-delete-title={post.title}
                    class="btn-delete-post inline-flex items-center px-3 py-1.5 rounded-lg bg-red-50 hover:bg-red-600 text-red-600 hover:text-white border border-red-200 text-xs font-bold transition cursor-pointer"
                  >
                    🗑️ Xóa
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const searchInput = document.getElementById("adminPostSearch");
      const catSelect = document.getElementById("adminPostCatFilter");
      const rows = document.querySelectorAll(".admin-post-row");

      function filterPosts() {
        const q = (searchInput?.value || "").toLowerCase().trim();
        const cat = catSelect?.value || "all";

        rows.forEach((row) => {
          const title = row.getAttribute("data-title") || "";
          const slug = row.getAttribute("data-slug") || "";
          const rowCat = row.getAttribute("data-cat") || "";
          const matchText = !q || title.includes(q) || slug.includes(q);
          const matchCat = cat === "all" || rowCat === cat;
          row.classList.toggle("hidden", !(matchText && matchCat));
        });
      }

      searchInput?.addEventListener("input", filterPosts);
      catSelect?.addEventListener("change", filterPosts);

      // Xử lý xóa bài viết gọi API /api/delete-post
      document.querySelectorAll(".btn-delete-post").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const slug = btn.getAttribute("data-delete-slug");
          const title = btn.getAttribute("data-delete-title") || slug;
          if (!slug) return;
          if (!confirm(`Bạn có chắc chắn muốn xóa bài viết:\n"${title}"?`)) return;

          btn.disabled = true;
          btn.textContent = "⏳...";
          try {
            const res = await fetch("/api/delete-post", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ slug })
            });
            const data = await res.json();
            if (res.ok && data.success !== false) {
              window.location.reload();
            } else {
              alert("❌ Lỗi xóa bài viết: " + (data.message || data.error || "Không thể xóa"));
              btn.disabled = false;
              btn.textContent = "🗑️ Xóa";
            }
          } catch (err) {
            alert("❌ Lỗi kết nối máy chủ khi xóa bài viết.");
            btn.disabled = false;
            btn.textContent = "🗑️ Xóa";
          }
        });
      });
    })();
  </script>
</AdminLayout>
