---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { allVehiclesAdmin as allVehicles } from '../../../data/vehicles.js';
import navData from '../../../data/navigation.json';

const vehicleList = Array.isArray(allVehicles) ? allVehicles : [];
const hasAnyExplicitFeatured = vehicleList.some((v: any) => v.isFeatured !== undefined);

const mainMenu = Array.isArray(navData?.mainMenu) ? navData.mainMenu : [];
const menuCategories: { title: string; subKey: string }[] = [];

mainMenu.forEach((menu: any) => {
  if (typeof menu.url === 'string' && (menu.url.includes('/san-pham') || menu.url.includes('/danh-muc')) && Array.isArray(menu.children)) {
    menu.children.forEach((child: any) => {
      let subKey = '';
      if (typeof child.url === 'string') {
        if (child.url.includes('cat=')) {
          subKey = child.url.split('cat=')[1].split('&')[0].trim();
        } else if (child.url.startsWith('/danh-muc/')) {
          subKey = child.url.replace('/danh-muc/', '').split('?')[0].replace(/\/$/, '').trim();
        }
      }
      menuCategories.push({ title: child.title, subKey });
    });
  }
});
---

<AdminLayout title="Quản Lý Kho Xe Chuyên Dùng & Ô Tô Khách" activeTab="products">
  <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm mb-5 flex flex-col sm:flex-row gap-3 justify-between items-center">
    <div class="flex items-center gap-2.5 w-full flex-1">
      <input 
        type="text" 
        id="searchInput" 
        placeholder="🔍 Tìm nhanh theo tên xe, mã slug, hãng xe..." 
        class="p-2.5 border border-slate-300 rounded-xl text-sm w-full flex-1 outline-none focus:ring-2 focus:ring-blue-600"
      />
      <span class="text-xs font-bold text-slate-600 bg-slate-100 border border-slate-200 px-3 py-2.5 rounded-xl whitespace-nowrap shrink-0">
        Hiện: <strong id="visibleCountLabel" class="text-blue-700">{vehicleList.length}</strong>/{vehicleList.length} xe
      </span>
    </div>
    <a href="/admin/products/edit" class="w-full sm:w-auto text-center bg-red-600 hover:bg-red-700 text-white font-extrabold px-5 py-2.5 rounded-xl text-sm transition shadow-md shrink-0">
      + Thêm Xe Mới
    </a>
  </div>

  <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs sm:text-sm">
        <thead>
          <tr class="bg-slate-800 text-white text-[11px] uppercase align-middle">
            <th class="px-3 py-3">Sản phẩm &amp; Hãng</th>
            <th class="px-2.5 py-3 w-36">
              <div class="flex flex-col gap-1">
                <span>Danh mục</span>
                <select id="filterCategory" class="bg-slate-700 hover:bg-slate-600 text-white text-[11px] font-bold normal-case px-1.5 py-1 rounded-md border border-slate-600 outline-none cursor-pointer w-full">
                  <option value="all">Tất cả ({vehicleList.length})</option>
                  {menuCategories.map((cat) => (
                    <option value={cat.subKey || cat.title} data-title={cat.title}>
                      {cat.title}
                    </option>
                  ))}
                </select>
              </div>
            </th>
            <th class="px-2.5 py-3 w-52">
              <div class="flex flex-col gap-1">
                <span>Giá (VNĐ)</span>
                <select id="sortPrice" class="bg-slate-700 hover:bg-slate-600 text-white text-[11px] font-bold normal-case px-1.5 py-1 rounded-md border border-slate-600 outline-none cursor-pointer w-36">
                  <option value="default">↕ Mặc định</option>
                  <option value="price-asc">↑ Thấp → Cao</option>
                  <option value="price-desc">↓ Cao → Thấp</option>
                </select>
              </div>
            </th>
            <th class="px-2 py-3 w-24 text-center">
              <div class="flex flex-col items-center gap-1">
                <span>Trang chủ</span>
                <select id="filterFeatured" class="bg-slate-700 hover:bg-slate-600 text-white text-[11px] font-bold normal-case px-1.5 py-1 rounded-md border border-slate-600 outline-none cursor-pointer w-20">
                  <option value="all">Tất cả</option>
                  <option value="featured">⭐ Hiện</option>
                  <option value="normal">Ẩn TC</option>
                </select>
              </div>
            </th>
            <th class="px-3 py-3 w-36 text-right">
              <div class="flex flex-col items-end gap-1">
                <span>Trạng thái &amp; Thao tác</span>
                <select id="filterVisibility" class="bg-slate-700 hover:bg-slate-600 text-white text-[11px] font-bold normal-case px-1.5 py-1 rounded-md border border-slate-600 outline-none cursor-pointer w-28">
                  <option value="all">Tất cả</option>
                  <option value="visible">🟢 Đang hiện</option>
                  <option value="hidden">🟡 Đang ẩn</option>
                </select>
              </div>
            </th>
          </tr>
        </thead>
        <tbody id="productTableBody" class="divide-y divide-slate-200">
          {vehicleList.map((v: any, idx: number) => {
            const isChecked = hasAnyExplicitFeatured ? Boolean(v.isFeatured) : idx < 4;
            const isHidden = Boolean(v.isHidden);
            return (
              <tr 
                class={`hover:bg-slate-50 transition product-row ${isHidden ? 'opacity-60' : ''}`}
                data-index={idx}
                data-name={`${v.name || ''} ${v.slug || ''} ${v.brand || ''}`.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[đĐ]/g, "d")} 
                data-cat={v.subCategory || ''}
                data-subkey={v.subKey || ''}
                data-price={Number(v.price || 0)}
                data-featured={isChecked ? 'true' : 'false'}
                data-hidden={isHidden ? 'true' : 'false'}
              >
                <td class="px-3 py-3">
                  <div class="flex items-start gap-2.5 min-w-[200px]">
                    <img src={v.images?.[0] || '/Logo.png'} alt={v.name} class="w-16 h-12 object-cover rounded-lg border border-slate-200 shrink-0 bg-slate-100" />
                    <div class="min-w-0">
                      <span class="text-[10px] font-extrabold text-blue-600 uppercase tracking-wide">{v.brand}</span>
                      <p class="font-bold text-slate-900 text-xs sm:text-[13px] line-clamp-2 leading-snug">{v.name}</p>
                      <span class="text-[10px] text-slate-400 font-mono block truncate max-w-[210px]" title={v.slug}>{v.slug}</span>
                    </div>
                  </div>
                </td>
                <td class="px-2.5 py-3">
                  <span class="inline-block bg-slate-100 text-slate-700 text-[11px] font-semibold px-2 py-1 rounded-md leading-snug">
                    {v.subCategory || 'Chuyên dùng'}
                  </span>
                </td>
                <td class="px-2.5 py-3">
                  <div class="flex flex-col gap-1">
                    <div class="flex items-center gap-1">
                      <span class="text-[10px] font-bold text-slate-500 w-12 shrink-0">Công bố:</span>
                      <input 
                        type="number" 
                        step="1000000"
                        value={v.price ?? 0} 
                        data-slug={v.slug}
                        class="price-input px-2 py-1 border border-slate-300 rounded-md w-28 text-xs font-extrabold text-red-600 focus:ring-2 focus:ring-blue-600 outline-none"
                      />
                    </div>
                    <div class="flex items-center gap-1">
                      <span class="text-[10px] font-bold text-emerald-700 w-12 shrink-0">Tối thiểu:</span>
                      <input 
                        type="number" 
                        step="1000000"
                        value={v.minPrice ?? v.price ?? 0} 
                        data-slug={v.slug}
                        class="minprice-input px-2 py-1 border border-emerald-400 bg-emerald-50/30 rounded-md w-28 text-xs font-extrabold text-emerald-700 focus:ring-2 focus:ring-emerald-600 outline-none"
                      />
                      <button 
                        type="button"
                        data-slug={v.slug}
                        class="btn-save-price bg-blue-600 hover:bg-blue-700 text-white text-[11px] font-bold px-2 py-1 rounded-md cursor-pointer transition shrink-0"
                      >
                        Lưu
                      </button>
                    </div>
                  </div>
                </td>
                <td class="px-2 py-3 text-center">
                  <input 
                    type="checkbox" 
                    data-slug={v.slug}
                    checked={isChecked}
                    class="toggle-featured w-5 h-5 accent-red-600 rounded cursor-pointer" 
                    title="Tick chọn để trưng bày xe này ngoài Trang Chủ" 
                  />
                </td>
                <td class="px-3 py-3 text-right">
                  <div class="flex flex-col items-end gap-1.5">
                    <button
                      type="button"
                      data-slug={v.slug}
                      class={`btn-toggle-vis text-[11px] font-bold px-2.5 py-1 rounded-md border transition cursor-pointer w-28 text-center ${
                        isHidden
                          ? 'border-amber-300 bg-amber-50 text-amber-800 hover:bg-amber-100'
                          : 'border-emerald-300 bg-emerald-50 text-emerald-700 hover:bg-emerald-100'
                      }`}
                    >
                      {isHidden ? '🟡 Đang ẩn' : '🟢 Đang hiện'}
                    </button>
                    <div class="flex items-center justify-end gap-1">
                      <a href={`/san-pham/${v.slug}`} target="_blank" class="bg-slate-100 hover:bg-emerald-600 hover:text-white text-slate-700 font-bold px-2 py-1 rounded-md text-[11px] transition" title="Xem ngoài web">
                        👁️
                      </a>
                      <a href={`/admin/products/edit?slug=${v.slug}`} class="bg-slate-100 hover:bg-blue-600 hover:text-white text-slate-700 font-bold px-2.5 py-1 rounded-md text-[11px] transition">
                        ✏️ Sửa
                      </a>
                      <button 
                        type="button"
                        data-slug={v.slug}
                        data-name={v.name}
                        class="btn-delete-vehicle bg-red-50 hover:bg-red-600 hover:text-white text-red-600 font-bold px-2 py-1 rounded-md text-[11px] transition cursor-pointer"
                        title="Xóa sản phẩm"
                      >
                        🗑️
                      </button>
                    </div>
                  </div>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>

  <script is:inline>
    (function () {
      const tbody = document.getElementById('productTableBody');
      const searchInput = document.getElementById('searchInput');
      const filterCat = document.getElementById('filterCategory');
      const filterVis = document.getElementById('filterVisibility');
      const filterFeat = document.getElementById('filterFeatured');
      const sortPrice = document.getElementById('sortPrice');
      const countLabel = document.getElementById('visibleCountLabel');

      function normalizeStr(s) {
        return (s || '').toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[đĐ]/g, "d");
      }

      function applyFiltersAndSort() {
        const rows = Array.from(tbody.querySelectorAll('.product-row'));
        const q = normalizeStr(searchInput.value).trim();
        const selectedVal = filterCat.value;
        const selectedOpt = filterCat.options[filterCat.selectedIndex];
        const selectedTitle = normalizeStr(selectedOpt ? selectedOpt.getAttribute('data-title') || '' : '');
        const visVal = filterVis.value;
        const featVal = filterFeat.value;
        const sortVal = sortPrice.value;

        rows.sort((a, b) => {
          if (sortVal === 'price-asc') return Number(a.getAttribute('data-price') || 0) - Number(b.getAttribute('data-price') || 0);
          if (sortVal === 'price-desc') return Number(b.getAttribute('data-price') || 0) - Number(a.getAttribute('data-price') || 0);
          return Number(a.getAttribute('data-index') || 0) - Number(b.getAttribute('data-index') || 0);
        });
        rows.forEach(r => tbody.appendChild(r));

        let shown = 0;
        rows.forEach(row => {
          const matchName = !q || (row.getAttribute('data-name') || '').includes(q);
          const rowCat = normalizeStr(row.getAttribute('data-cat') || '');
          const rowSubKey = normalizeStr(row.getAttribute('data-subkey') || '');

          const matchCat = selectedVal === 'all'
            || rowSubKey === normalizeStr(selectedVal)
            || rowCat === selectedTitle
            || (selectedVal === 'bon-thuc-pham' && rowCat.includes('bon cam'))
            || (selectedVal === 'bon-hut-chat-thai' && (rowCat.includes('hut chat thai') || rowCat.includes('bon chuyen dung')))
            || (selectedVal === 'bon-nuoc' && (rowCat.includes('bon nuoc') || rowCat.includes('bon chuyen dung')))
            || (selectedVal === 'xe-cau' && rowCat.includes('cau'))
            || (selectedVal === 'cuu-ho' && rowCat.includes('cuu ho'))
            || (selectedVal === 'nang-dau' && rowCat.includes('nang dau'));

          const isHidden = row.getAttribute('data-hidden') === 'true';
          const matchVis = visVal === 'all' || (visVal === 'visible' && !isHidden) || (visVal === 'hidden' && isHidden);

          const isFeatured = row.getAttribute('data-featured') === 'true';
          const matchFeat = featVal === 'all' || (featVal === 'featured' && isFeatured) || (featVal === 'normal' && !isFeatured);

          const ok = matchName && matchCat && matchVis && matchFeat;
          row.style.display = ok ? '' : 'none';
          if (ok) shown++;
        });

        if (countLabel) countLabel.innerText = String(shown);
      }

      searchInput?.addEventListener('input', applyFiltersAndSort);
      [filterCat, filterVis, filterFeat, sortPrice].forEach(el => el?.addEventListener('change', applyFiltersAndSort));

      document.querySelectorAll('.btn-save-price').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const target = e.currentTarget;
          const slug = target.getAttribute('data-slug');
          const row = target.closest('tr');
          const newPrice = row.querySelector('.price-input').value;
          const minInput = row.querySelector('.minprice-input');
          const newMinPrice = minInput ? minInput.value : newPrice;
          try {
            const res = await fetch('/api/update-vehicle', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ slug, price: newPrice, minPrice: newMinPrice })
            });
            const result = await res.json();
            if (result.success) {
              row.setAttribute('data-price', String(Number(newPrice || 0)));
              alert('🎉 Đã lưu giá mới thành công!');
              applyFiltersAndSort();
            } else {
              alert('❌ Lỗi: ' + result.message);
            }
          } catch (err) {
            alert('❌ Lỗi kết nối đến máy chủ!');
          }
        });
      });

      document.querySelectorAll('.toggle-featured').forEach(chk => {
        chk.addEventListener('change', async (e) => {
          const target = e.currentTarget;
          const slug = target.getAttribute('data-slug');
          const isFeatured = target.checked;
          const row = target.closest('tr');
          try {
            const res = await fetch('/api/update-vehicle', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ slug, isFeatured })
            });
            const result = await res.json();
            if (result.success) {
              row.setAttribute('data-featured', isFeatured ? 'true' : 'false');
              applyFiltersAndSort();
            } else {
              alert('❌ Lỗi: ' + result.message);
              target.checked = !isFeatured;
            }
          } catch (err) {
            alert('❌ Không thể cập nhật trạng thái hiển thị trang chủ!');
            target.checked = !isFeatured;
          }
        });
      });

      document.querySelectorAll('.btn-toggle-vis').forEach(btn => {
        btn.addEventListener('click', async () => {
          const slug = btn.getAttribute('data-slug');
          const row = btn.closest('tr');
          btn.disabled = true;
          btn.innerText = '⏳...';
          try {
            const res = await fetch('/api/toggle-visibility', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ type: 'vehicle', slug })
            });
            const data = await res.json();
            if (data.success) {
              const hidden = Boolean(data.isHidden);
              row.setAttribute('data-hidden', hidden ? 'true' : 'false');
              row.classList.toggle('opacity-60', hidden);
              btn.innerText = hidden ? '🟡 Đang ẩn' : '🟢 Đang hiện';
              btn.className = hidden
                ? 'btn-toggle-vis text-[11px] font-bold px-2.5 py-1 rounded-md border border-amber-300 bg-amber-50 text-amber-800 hover:bg-amber-100 transition cursor-pointer w-28 text-center'
                : 'btn-toggle-vis text-[11px] font-bold px-2.5 py-1 rounded-md border border-emerald-300 bg-emerald-50 text-emerald-700 hover:bg-emerald-100 transition cursor-pointer w-28 text-center';
              applyFiltersAndSort();
            } else {
              alert('Lỗi: ' + (data.error || 'Không thể cập nhật'));
            }
          } catch (e) {
            alert('Lỗi kết nối máy chủ cục bộ');
          } finally {
            btn.disabled = false;
          }
        });
      });

      document.querySelectorAll('.btn-delete-vehicle').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const target = e.currentTarget;
          const slug = target.getAttribute('data-slug');
          const name = target.getAttribute('data-name');
          if (!confirm(`⚠️ Bạn có chắc chắn muốn xóa sản phẩm:\n"${name}"?\nToàn bộ dữ liệu của xe này sẽ bị xóa khỏi hệ thống!`)) return;
          try {
            const res = await fetch('/api/delete-vehicle', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ slug })
            });
            const result = await res.json();
            if (result.success) {
              alert('🎉 ' + result.message);
              location.reload();
            } else {
              alert('❌ Lỗi: ' + result.message);
            }
          } catch (err) {
            alert('❌ Lỗi kết nối đến máy chủ!');
          }
        });
      });
    })();
  </script>
</AdminLayout>
