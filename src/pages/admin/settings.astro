---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Cài Đặt Bảo Mật & Đổi Mật Khẩu Quản Trị" activeTab="settings">
  <div class="max-w-md bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-5">
    <h2 class="text-base font-bold text-slate-900 border-b pb-3">🔑 Thay Đổi Mật Khẩu Quản Lý Chung</h2>
    
    <form id="changePassForm" class="space-y-4 text-sm">
      <div>
        <label class="block font-bold text-slate-700 mb-1">Mật khẩu hiện tại:</label>
        <input type="password" id="oldPass" class="w-full p-3 border rounded-xl" required />
      </div>
      <div>
        <label class="block font-bold text-slate-700 mb-1">Mật khẩu mới:</label>
        <input type="password" id="newPass" class="w-full p-3 border rounded-xl" required />
      </div>
      <div>
        <label class="block font-bold text-slate-700 mb-1">Nhập lại mật khẩu mới:</label>
        <input type="password" id="confirmPass" class="w-full p-3 border rounded-xl" required />
      </div>
      <p id="msgStatus" class="text-xs font-bold hidden"></p>
      <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-extrabold py-3 rounded-xl transition cursor-pointer">
        Cập Nhật Mật Khẩu Mới
      </button>
    </form>
  </div>

  <script is:inline>
    document.getElementById('changePassForm').addEventListener('submit', (e) => {
      e.preventDefault();
      const oldP = document.getElementById('oldPass').value;
      const newP = document.getElementById('newPass').value;
      const confP = document.getElementById('confirmPass').value;
      const msg = document.getElementById('msgStatus');
      const currentSaved = localStorage.getItem('pc_admin_pass') || 'phucuong@2026';

      msg.classList.remove('hidden', 'text-red-600', 'text-emerald-600');

      if (oldP !== currentSaved) {
        msg.innerText = '❌ Mật khẩu hiện tại không đúng!';
        msg.classList.add('text-red-600');
        return;
      }
      if (newP !== confP) {
        msg.innerText = '❌ Mật khẩu mới nhập lại không khớp!';
        msg.classList.add('text-red-600');
        return;
      }

      localStorage.setItem('pc_admin_pass', newP);
      msg.innerText = '✅ Đã đổi mật khẩu quản trị thành công!';
      msg.classList.add('text-emerald-600');
      document.getElementById('changePassForm').reset();
    });
  

  // === START ADMIN YOUTUBE FIELD ===
  function injectYouTubeAdminField() {
    if (document.getElementById("videoUrl")) return;

    // Tìm form hoặc một trong các ô chuẩn của trang sản phẩm
    const anchorInput =
      document.querySelector("[name=\"promo\"]") ||
      document.querySelector("#promo") ||
      document.querySelector("[name=\"priceText\"]") ||
      document.querySelector("#priceText") ||
      document.querySelector("[name=\"summary\"]") ||
      document.querySelector("#summary") ||
      document.querySelector("[name=\"slug\"]") ||
      document.querySelector("#slug") ||
      document.querySelector("[name=\"name\"]") ||
      document.querySelector("#name");

    if (!anchorInput) return;

    // Tìm khối bao ngoài của ô input đó để chèn ngay phía sau
    const wrapper = anchorInput.closest("div") || anchorInput.parentElement;
    if (!wrapper || !wrapper.parentElement) return;

    const videoBox = document.createElement("div");
    videoBox.className = "col-span-1 md:col-span-2 my-3 bg-red-50/80 p-4 rounded-xl border-2 border-red-200 shadow-sm";
    videoBox.innerHTML = `
      <label for="videoUrl" class="block text-sm font-bold text-red-700 mb-1.5 flex items-center gap-2">
        <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-red-600 text-white text-xs">▶</span>
        🎬 Link Video YouTube / YouTube Shorts Thực Tế (Tùy chọn)
      </label>
      <input
        type="url"
        id="videoUrl"
        name="videoUrl"
        placeholder="Dán link YouTube vào đây (VD: https://www.youtube.com/watch?v=... hoặc https://youtube.com/shorts/...)"
        class="w-full px-3.5 py-2.5 bg-white border border-red-300 rounded-lg text-sm text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-red-500"
      />
      <p class="text-xs text-slate-600 mt-1.5">
        💡 Mẹo: Khi dán mã JSON 1-Click có trường <code>"videoUrl"</code> hoặc dán trực tiếp link YouTube vào ô này, trang sản phẩm sẽ tự động hiển thị khung phát Video HD.
      </p>
    `;

    wrapper.parentNode.insertBefore(videoBox, wrapper.nextSibling);

    // Tự động bắt sự kiện когда người dùng dán JSON 1-Click vào bất kỳ ô textarea nào
    const allTextareas = document.querySelectorAll("textarea");
    allTextareas.forEach(ta => {
      ta.addEventListener("input", () => {
        try {
          const val = ta.value.trim();
          if (val.startsWith("{") && val.endsWith("}")) {
            const parsed = JSON.parse(val);
            if (parsed.videoUrl || parsed.youtubeUrl) {
              const vInput = document.getElementById("videoUrl");
              if (vInput) vInput.value = parsed.videoUrl || parsed.youtubeUrl;
            }
          }
        } catch (e) {}
      });
    });

    // Bắt sự kiện click vào nút 1-Click để tự điền videoUrl nếu có trong JSON
    document.addEventListener("click", () => {
      setTimeout(() => {
        allTextareas.forEach(ta => {
          try {
            const val = ta.value.trim();
            if (val.startsWith("{") && val.endsWith("}")) {
              const parsed = JSON.parse(val);
              const vInput = document.getElementById("videoUrl");
              if (vInput && (parsed.videoUrl || parsed.youtubeUrl) && !vInput.value) {
                vInput.value = parsed.videoUrl || parsed.youtubeUrl;
              }
            }
          } catch (e) {}
        });
      }, 80);
    });

    // Can thiệp tự động vào window.fetch để đảm bảo khi bấm Lưu sản phẩm, trường videoUrl luôn được gửi kèm trong JSON payload
    if (!window.__patchedFetchForVideo) {
      window.__patchedFetchForVideo = true;
      const origFetch = window.fetch;
      window.fetch = async function(input, init) {
        try {
          if (init && init.method && init.method.toUpperCase() === "POST" && typeof init.body === "string") {
            const vInput = document.getElementById("videoUrl");
            if (vInput && init.body.trim().startsWith("{")) {
              const bodyObj = JSON.parse(init.body);
              bodyObj.videoUrl = vInput.value.trim();
              init.body = JSON.stringify(bodyObj);
            }
          }
        } catch (e) {}
        return origFetch.apply(this, arguments);
      };
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", injectYouTubeAdminField);
  } else {
    injectYouTubeAdminField();
  }
  document.addEventListener("astro:page-load", injectYouTubeAdminField);
  // === END ADMIN YOUTUBE FIELD ===

</script>
</AdminLayout>
