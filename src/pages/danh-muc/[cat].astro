  },
  'xe-cho-gia-cam': {
    title: 'Xe Tải Chở Gia Cầm (Chở Gà, Vịt Giống & Thịt) Thùng Lồng Chuẩn Đăng Kiểm',
    h1: 'Xe Tải Chở Gia Cầm Chuyên Dùng',
    desc: 'Phân phối và đóng mới xe tải chở gia cầm (chở gà, vịt) thùng lồng thông thoáng nhiều tầng trên nền Isuzu, Hino, Hyundai, Chenglong, Dongfeng hỗ trợ vay 80%.',
    intro: 'Dòng xe tải chuyên dùng chở gia cầm thiết kế thùng khung xương kẽm/Inox 304 chắc chắn, sàn chống trượt dễ vệ sinh khử khuẩn và tối ưu đối lưu không khí.'
  },
  'xe-16-29-cho': {
    title: 'Xe Khách 16 - 29 Chỗ Chính Hãng (Solati, Sunray, County, Thaco) | Phú Cường Auto',
    h1: 'Xe Khách 16 - 29 Chỗ',
    desc: 'Phân phối các dòng xe khách từ 16 chỗ đến 29 chỗ chính hãng phục vụ đưa đón cán bộ nhân viên, chạy tuyến cố định và hợp đồng du lịch. Hỗ trợ vay 80%.',
    intro: 'Tổng hợp các dòng xe khách 16 chỗ - 29 chỗ vận hành êm ái, tiết kiệm nhiên liệu, nội thất rộng rãi và đầy đủ hồ sơ đăng kiểm.'
  },
  'xe-30-47-cho': {
    title: 'Xe Khách 30 - 47 Chỗ & Giường Nằm Chính Hãng Giá Tốt | Phú Cường Auto',
    h1: 'Xe Khách 30 - 47 Chỗ',
    desc: 'Bảng giá và thông số kỹ thuật các dòng xe khách 30 chỗ, 34 chỗ, 47 chỗ ghế ngồi và giường nằm cao cấp. Hỗ trợ trả góp ngân hàng lên đến 80%.',
    intro: 'Các mẫu xe khách 30 - 47 chỗ thân dài, hệ thống treo bầu hơi êm ái, động cơ công suất lớn chuyên chạy tuyến đường dài và du lịch lữ hành.'
  },
  'xe-limousine': {
    title: 'Xe Limousine Cao Cấp (9 - 29 Chỗ) Nội Thất Thương Gia | Phú Cường Auto',
    h1: 'Xe Limousine Cao Cấp',
    desc: 'Thiết kế và phân phối các dòng xe Limousine ghế massage hạng thương gia trên nền Hyundai Solati, Ford Transit, Thaco, Samco chuẩn đăng kiểm.',
    intro: 'Dòng xe Limousine nâng cấp nội thất thương gia sang trọng, ghế bọc da cao cấp tích hợp massage, cổng sạc USB và hệ thống giải trí hiện đại.'
  },
  'xe-khach': {
    title: 'Xe Khách & Minibus Gaz, Thaco, Hyundai Chính Hãng Giá Tốt',
    h1: 'Xe Khách & Minibus Thương Mại',
    desc: 'Phân phối các dòng xe khách, xe minibus 16 chỗ - 47 chỗ phục vụ đưa đón cán bộ nhân viên, chạy tuyến cố định và hợp đồng du lịch.',
    intro: 'Các mẫu xe khách và minibus vận hành bền bỉ, tiết kiệm nhiên liệu, hỗ trợ vay trả góp ngân hàng lên đến 80%.'
  },
  'xe-cu': {
    title: 'Xe Chuyên Dùng Đã Qua Sử Dụng (Xe Lướt Chất Lượng Cao)',
    h1: 'Xe Chuyên Dùng Đã Qua Sử Dụng & Thanh Lý Chính Hãng',
    desc: 'Danh sách xe tải chuyên dùng, xe cứu hộ, xe bồn cám, xe cẩu đã qua sử dụng được kiểm định kỹ thuật nghiêm ngặt tại Ô Tô Chuyên Dùng Phú Cường.',
    intro: 'Tổng hợp các mẫu xe chuyên dùng lướt, xe đã qua sử dụng còn nguyên bản, hồ sơ pháp lý rõ ràng, sang tên ngay trong ngày.'
  }
};

// Xác định nhóm danh mục cùng loại (Xe Chuyên Dùng / Ô Tô Khách / Xe Cũ)
const mainMenu = Array.isArray(navData?.mainMenu) ? navData.mainMenu : [];
let menuMatchedTitle = '';
let activeGroupRootUrl = '/danh-muc/xe-tai-chuyen-dung';
let activeGroupLabel = 'Tất cả xe chuyên dùng';
let siblingCategoryLinks: { title: string; slug: string }[] = [];

const extractSlugFromUrl = (u: string) => {
  if (typeof u !== 'string') return '';
  if (u.includes('cat=')) return u.split('cat=')[1].split('&')[0].trim();
  if (u.startsWith('/danh-muc/')) return u.replace('/danh-muc/', '').split('?')[0].replace(/\/$/, '').trim();
  return '';
};

const vehicleGroups = mainMenu.filter((m: any) => Array.isArray(m.children) && m.url?.startsWith('/danh-muc/'));

let matchedGroup = vehicleGroups.find((g: any) => {
  const rootSlug = normalizeStr(extractSlugFromUrl(g.url));
  if (rootSlug === normCat) return true;
  return g.children.some((c: any) => normalizeStr(extractSlugFromUrl(c.url)) === normCat);
});

if (!matchedGroup) {
  if (normCat.includes('cho') || normCat.includes('khach')) {
    matchedGroup = vehicleGroups.find((g: any) => g.url === '/danh-muc/xe-khach');
  } else if (normCat.includes('cu') && !normCat.includes('cuu-ho')) {
    matchedGroup = vehicleGroups.find((g: any) => g.url === '/danh-muc/xe-cu');
  } else {
    matchedGroup = vehicleGroups[0];
  }
}

if (matchedGroup) {
  activeGroupRootUrl = matchedGroup.url;
  activeGroupLabel =
    matchedGroup.url === '/danh-muc/xe-khach'
      ? 'Tất cả ô tô khách'
      : matchedGroup.url === '/danh-muc/xe-cu'
      ? 'Tất cả xe cũ'
      : 'Tất cả xe chuyên dùng';

  matchedGroup.children.forEach((child: any) => {
    const cSlug = extractSlugFromUrl(child.url);
    if (cSlug) {
      if (!siblingCategoryLinks.some((x) => x.slug === cSlug)) {
        siblingCategoryLinks.push({ title: child.title, slug: cSlug });
      }
      if (normalizeStr(cSlug) === normCat) {
        menuMatchedTitle = child.title;
      }
    }
  });
}

const seoMeta = CATEGORY_SEO_META[rawCat] || {
  title: menuMatchedTitle
    ? `${menuMatchedTitle} Chính Hãng | Báo Giá & Thông Số Đăng Kiểm Mới Nhất`
    : 'Kho Xe Tải Chuyên Dùng Chính Hãng | Ô Tô Phú Cường',
  h1: menuMatchedTitle || 'Kho Xe Tải Chuyên Dùng Phú Cường',
  desc: `Danh sách các dòng ${menuMatchedTitle || 'xe tải chuyên dùng'} chính hãng tại Ô Tô Chuyên Dùng Phú Cường. Hỗ trợ vay trả góp ngân hàng 60% - 85%, giao xe toàn quốc.`,
  intro: `Khám phá các mẫu ${menuMatchedTitle || 'xe tải chuyên dùng'} được thiết kế, nhập khẩu và phân phối chính hãng tại Ô Tô Chuyên Dùng Phú Cường với đầy đủ hồ sơ đăng kiểm.`
};

const vehicleList = Array.isArray(allVehicles) ? allVehicles : [];
const filteredVehicles = vehicleList.filter((v: any) => {
  const vSubKey = normalizeStr(v.subKey || '');
  const nNorm = normalizeStr(v.name || '');
  // Hỗ trợ lọc thông minh theo 3 phân khúc Xe Khách mới
  if (normCat === 'xe-16-29-cho') {
    const isBusCat = normalizeStr(v.category || '').includes('khach') || vSubKey.includes('cho') || vSubKey.includes('khach');
    if (!isBusCat || nNorm.includes('limousine')) return false;
    return vSubKey === 'xe-16-29-cho' || /\b(1[6-9]|2[0-9])\s*cho\b/.test(nNorm);
  }
  if (normCat === 'xe-30-47-cho') {
    const isBusCat = normalizeStr(v.category || '').includes('khach') || vSubKey.includes('cho') || vSubKey.includes('khach');
    if (!isBusCat || nNorm.includes('limousine')) return false;
    return vSubKey === 'xe-30-47-cho' || /\b(3[0-9]|4[0-7])\s*cho\b/.test(nNorm) || nNorm.includes('giuong nam');
  }
  if (normCat === 'xe-limousine') {
    return vSubKey === 'xe-limousine' || nNorm.includes('limousine');
  }

  const vSubCat = normalizeStr(v.subCategory || '');
  const vCat = normalizeStr(v.category || '');
  const normMenuTitle = normalizeStr(menuMatchedTitle);
  const isUsedItem = (vSubKey.includes('cu') && !vSubKey.includes('cuu-ho')) || vSubCat.includes('xe cu') || vCat === 'xe-cu';
  const isBusItem = (vCat === 'xe-khach' || vSubKey.endsWith('-cho') || vSubKey.includes('limousine') || vSubCat.includes('khach')) && !vSubKey.includes('gia-cam');

  if (normCat === 'xe-cho-gia-cam') {
    return vSubKey === 'xe-cho-gia-cam' || nNorm.includes('gia cam') || vSubCat.includes('gia cam') || normalizeStr(v.slug || '').includes('gia-cam');
  }

  if (!rawCat || rawCat === 'all' || rawCat === 'xe-tai-chuyen-dung') {
    return !isUsedItem && !isBusItem;
  }
  if (rawCat === 'xe-khach') {
    return isBusItem && !isUsedItem;
  }
  if (rawCat === 'xe-cu') {
    return isUsedItem;
  }

  return (
    vSubKey === normCat ||
    vCat === normCat ||
    (normMenuTitle && vSubCat === normMenuTitle) ||
    (normCat === 'bon-thuc-pham' && vSubCat.includes('bon cam')) ||
    (normCat === 'bon-hut-chat-thai' && (vSubCat.includes('hut chat thai') || vSubCat.includes('moi truong'))) ||
    (normCat === 'ep-rac' && vSubCat.includes('ep rac')) ||
    (normCat === 'quet-duong-hut-bui' && vSubCat.includes('quet duong')) ||
    (normCat === 'bon-nuoc' && (vSubCat.includes('bon nuoc') || vSubCat.includes('phun nuoc'))) ||
    (normCat === 'xe-cau' && vSubCat.includes('cau') && !vSubCat.includes('cuu ho') && !vSubCat.includes('dau keo')) ||
    ((normCat === 'cuu-ho' || normCat === 'xe-cuu-ho-giao-thong') && vSubCat.includes('cuu ho')) ||
    (normCat === 'nang-dau' && vSubCat.includes('nang dau')) ||
    (normCat === 'xe-dau-keo-gan-cau' && vSubCat.includes('dau keo'))
  );
});

// Màng lọc an toàn: Khi ở danh mục Xe Khách, loại bỏ triệt để xe tải chở gia cầm, xe bồn, xe cứu hộ...
if ((normCat.includes("xe-khach") || normCat.endsWith("-cho") || normCat === "xe-limousine") && !normCat.includes("gia-cam")) {
  const nonBusKeywords = ["gia cam", "cho ga", "cho vit", "bon ", "cuu ho", "xe cau", "xe ben", "dong lanh", "ep rac", "tai thung"];
  for (let i = filteredVehicles.length - 1; i >= 0; i--) {
    const nNorm = normalizeStr(filteredVehicles[i]?.name || "");
    const scNorm = normalizeStr(filteredVehicles[i]?.subCategory || "");
    if (nonBusKeywords.some((kw) => nNorm.includes(kw) || scNorm.includes(kw))) {
      filteredVehicles.splice(i, 1);
    }
  }
}

function extractWeightsInKg(v: any): { payloadKg: number; grossKg: number } {
  const cs = v?.chassisSpecs || v?.chassis_specs || {};
  const ss = v?.specialSpecs || v?.special_specs || {};
  const entries = [...Object.entries(cs), ...Object.entries(ss)];

  let payloadKg = 0;
  let grossKg = 0;

  const parseNumToKg = (valStr: string): number => {
    const s = String(valStr || '').toLowerCase();
    const kgMatch = s.match(/(\d{1,2}[.,]\d{3}|\d{3,5})\s*kg/);
    if (kgMatch) {
      return parseFloat(kgMatch[1].replace(/[.,]/g, ''));
    }
    const tonMatch = s.match(/(\d+(?:[.,]\d+)?)\s*(?:tấn|tan|t\b)/);
    if (tonMatch) {
      return Math.round(parseFloat(tonMatch[1].replace(',', '.')) * 1000);
    }
    return 0;
  };

  for (const [k, val] of entries) {
    const kl = normalizeStr(k);
    if (!payloadKg && (kl.includes('tai trong cho phep') || kl.includes('tai trong chuyen cho') || kl.includes('khoi luong hang'))) {
      payloadKg = parseNumToKg(String(val));
    }
    if (!grossKg && (kl.includes('khoi luong toan bo') || kl.includes('tong tai') || kl.includes('tong trong tai'))) {
      grossKg = parseNumToKg(String(val));
    }
  }

  if (!payloadKg && v?.name) {
    payloadKg = parseNumToKg(String(v.name));
  }

  return { payloadKg, grossKg };
}

const brandCountMap = new Map<string, number>();
filteredVehicles.forEach((v: any) => {
  const b = String(v?.brand || '').trim().toUpperCase();
  if (b) brandCountMap.set(b, (brandCountMap.get(b) || 0) + 1);
});
const availableBrands = Array.from(brandCountMap.entries()).sort((a, b) => a[0].localeCompare(b[0]));

const canonicalUrl = `https://chuyendungphucuong.vn/danh-muc/${rawCat}`;

function hasVideo(v: any) {
  const u = v?.videoUrl || v?.youtubeUrl || '';
  return typeof u === 'string' && u.trim().length > 5;
}

function getBadges(v: any): string[] {
  if (Array.isArray(v?.customBadges) && v.customBadges.length > 0) {
    return v.customBadges.slice(0, 3);
  }
  const list: string[] = [];
  const cs = v?.chassisSpecs || v?.chassis_specs || {};
  const payload = cs['Tải trọng cho phép chở'] || cs['Khối lượng hàng chuyên chở'];
  if (payload) list.push(`Tải: ${payload}`);
  if (v?.brand) list.push(v.brand);
  return list.slice(0, 2);
}

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": seoMeta.h1,
  "description": seoMeta.desc,
  "url": canonicalUrl,
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": filteredVehicles.length,
    "itemListElement": filteredVehicles.map((v: any, idx: number) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "url": `https://chuyendungphucuong.vn/san-pham/${v.slug}`,
      "name": v.name
    }))
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Trang chủ", "item": "https://chuyendungphucuong.vn/" },
    { "@type": "ListItem", "position": 2, "name": "Kho xe chuyên dùng", "item": "https://chuyendungphucuong.vn/danh-muc/xe-tai-chuyen-dung" },
    { "@type": "ListItem", "position": 3, "name": seoMeta.h1, "item": canonicalUrl }
  ]
};
---

<BaseLayout title={`${seoMeta.title} | Ô Tô Chuyên Dùng Phú Cường`} description={seoMeta.desc} canonicalUrl={canonicalUrl}>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <style is:inline>
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>

  <main class="container mx-auto px-4 py-6 sm:py-8 max-w-7xl">
    <!-- Breadcrumb điều hướng đồng nhất -->
    <nav class="text-xs sm:text-sm text-slate-500 mb-4 flex flex-wrap items-center gap-1.5" aria-label="Breadcrumb">
      <a href="/" class="hover:text-blue-700 font-medium">Trang chủ</a>
      <span>/</span>
      <a href="/danh-muc/xe-tai-chuyen-dung" class="hover:text-blue-700 font-medium">Kho xe chuyên dùng</a>
      {rawCat !== 'xe-tai-chuyen-dung' && (
        <>
          <span>/</span>
          <span class="text-slate-900 font-bold">{seoMeta.h1}</span>
        </>
      )}
    </nav>

    <!-- Header Danh mục đồng bộ màu xanh dương chủ đạo & Menu trượt ngang 1 dòng cùng nhóm -->
    <header class="bg-gradient-to-r from-blue-900 via-blue-800 to-indigo-900 text-white rounded-2xl p-5 sm:p-7 mb-6 shadow-md">
      <div class="max-w-4xl space-y-2">
        <span class="inline-block bg-red-600 text-white text-[11px] font-extrabold px-3 py-1 rounded-full uppercase tracking-wider shadow-sm">
          Chuyên Mục Sản Phẩm Chính Hãng ({filteredVehicles.length} mẫu xe)
        </span>
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold leading-tight">
          {seoMeta.h1}
        </h1>
        <p class="text-xs sm:text-sm lg:text-base text-blue-100 leading-relaxed">
          {seoMeta.intro}
        </p>
      </div>

      <!-- Menu trượt ngang 1 dòng duy nhất (chỉ hiển thị các danh mục cùng nhóm) -->
      {siblingCategoryLinks.length > 0 && (
        <div class="mt-5 pt-4 border-t border-white/15 flex items-center gap-2">
          <button
            type="button"
            id="btnCatSlidePrev"
            aria-label="Cuộn danh mục sang trái"
            class="shrink-0 w-8 h-8 rounded-lg bg-white/15 hover:bg-white/25 text-white flex items-center justify-center transition cursor-pointer font-bold text-xs border border-white/15"
          >
            &#10094;
          </button>

          <div
            id="siblingCatTrack"
            class="flex items-center gap-2 overflow-x-auto no-scrollbar scroll-smooth flex-1 py-0.5"
          >
            <a
              href={activeGroupRootUrl}
              data-active-cat={normalizeStr(extractSlugFromUrl(activeGroupRootUrl)) === normCat ? 'true' : 'false'}
              class={`shrink-0 whitespace-nowrap px-3.5 py-1.5 rounded-xl text-xs font-bold transition ${
                normalizeStr(extractSlugFromUrl(activeGroupRootUrl)) === normCat
                  ? 'bg-red-600 text-white font-extrabold shadow-sm border border-red-500'
                  : 'bg-white/10 hover:bg-white/20 text-white border border-white/15'
              }`}
            >
              {activeGroupLabel}
            </a>

            {siblingCategoryLinks.map((item) => {
              const active = normalizeStr(item.slug) === normCat;
              return (
                <a
                  href={`/danh-muc/${item.slug}`}
                  data-active-cat={active ? 'true' : 'false'}
                  class={`shrink-0 whitespace-nowrap px-3.5 py-1.5 rounded-xl text-xs font-bold transition ${
                    active
                      ? 'bg-red-600 text-white font-extrabold shadow-sm border border-red-500'
                      : 'bg-white/10 hover:bg-white/20 text-white border border-white/15'
                  }`}
                >
                  {item.title}
                </a>
              );
            })}
          </div>

          <button
            type="button"
            id="btnCatSlideNext"
            aria-label="Cuộn danh mục sang phải"
            class="shrink-0 w-8 h-8 rounded-lg bg-white/15 hover:bg-white/25 text-white flex items-center justify-center transition cursor-pointer font-bold text-xs border border-white/15"
          >
            &#10095;
          </button>
        </div>
      )}
    </header>

    <!-- THANH CÔNG CỤ TÌM KIẾM, LỌC THƯƠNG HIỆU, LỌC GIÁ & SẮP XẾP (Sạch icon, gọn gàng) -->
    <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4 sm:p-5 mb-6 space-y-3.5">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3">
        <!-- 1. Ô tìm kiếm từ khóa -->
        <div class="lg:col-span-4 relative">
          <input
            type="text"
            id="catSearchInput"
            placeholder="Tìm tên xe, model, số khối, tải trọng..."
            class="w-full pl-3.5 pr-9 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm font-medium text-slate-900 placeholder:text-slate-400 focus:bg-white focus:border-blue-600 focus:outline-none transition"
          />
          <button
            type="button"
            id="btnClearSearch"
            title="Xóa tìm kiếm"
            class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-red-600 font-bold text-sm cursor-pointer"
          >
            ×
          </button>
        </div>

        <!-- 2. Lọc theo Thương hiệu -->
        <div class="lg:col-span-3">
          <select
            id="catBrandFilter"
            aria-label="Lọc theo thương hiệu"
            class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm font-bold text-slate-800 focus:bg-white focus:border-blue-600 focus:outline-none cursor-pointer"
          >
            <option value="all">Tất cả thương hiệu ({availableBrands.length})</option>
            {availableBrands.map(([brandName, count]) => (
              <option value={brandName}>{brandName} ({count} xe)</option>
            ))}
          </select>
        </div>

        <!-- 3. Lọc theo Khoảng giá -->
        <div class="lg:col-span-2">
          <select
            id="catPriceFilter"
            aria-label="Lọc theo khoảng giá"
            class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-sm font-bold text-slate-800 focus:bg-white focus:border-blue-600 focus:outline-none cursor-pointer"
          >
            <option value="all">Tất cả mức giá</option>
            <option value="under-800">Dưới 800 Triệu</option>
            <option value="800-1200">800 Triệu – 1,2 Tỷ</option>
            <option value="1200-1800">1,2 Tỷ – 1,8 Tỷ</option>
            <option value="over-1800">Trên 1,8 Tỷ</option>
            <option value="contact">Giá liên hệ / Dự án</option>
          </select>
        </div>

        <!-- 4. Sắp xếp theo Giá / Tải trọng / Tổng trọng tải -->
        <div class="lg:col-span-3">
          <select
            id="catSortSelect"
            aria-label="Sắp xếp sản phẩm"
            class="w-full px-3.5 py-2.5 bg-blue-50/70 border border-blue-200 rounded-xl text-sm font-bold text-blue-900 focus:bg-white focus:border-blue-600 focus:outline-none cursor-pointer"
          >
            <option value="default">Sắp xếp: Mặc định nổi bật</option>
            <option value="price-asc">Giá bán: Thấp đến Cao</option>
            <option value="price-desc">Giá bán: Cao đến Thấp</option>
            <option value="payload-desc">Tải trọng: Lớn đến Nhỏ</option>
            <option value="payload-asc">Tải trọng: Nhỏ đến Lớn</option>
            <option value="gross-desc">Tổng trọng tải: Lớn đến Nhỏ</option>
            <option value="gross-asc">Tổng trọng tải: Nhỏ đến Lớn</option>
          </select>
        </div>
      </div>

      <!-- Thanh trạng thái số lượng kết quả & nút đặt lại bộ lọc -->
      <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-slate-100 text-xs sm:text-sm">
        <p class="text-slate-600 font-medium">
          Hiển thị <strong id="visibleVehicleCount" class="text-blue-700 font-extrabold">{filteredVehicles.length}</strong> / {filteredVehicles.length} mẫu xe phù hợp
        </p>
        <button
          type="button"
          id="btnResetFilters"
          class="hidden text-red-600 hover:text-red-700 font-bold cursor-pointer"
        >
          Đặt lại bộ lọc
        </button>
      </div>
    </section>

    <!-- LƯỚI DANH SÁCH SẢN PHẨM THUỘC DANH MỤC -->
    {filteredVehicles.length === 0 ? (
      <div class="bg-white rounded-2xl p-10 text-center border border-slate-200 space-y-4">
        <p class="text-lg font-bold text-slate-700">Hiện đang cập nhật thêm cấu hình xe mới cho danh mục này.</p>
        <a href="/danh-muc/xe-tai-chuyen-dung" class="inline-block bg-blue-700 hover:bg-blue-800 text-white font-bold px-6 py-3 rounded-xl text-sm transition">
          Xem toàn bộ kho xe chuyên dùng
        </a>
      </div>
    ) : (
      <>
        <div id="categoryVehicleGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {filteredVehicles.map((v: any, idx: number) => {
            const basePrice = Number(v.price || 0);
            const downPayment = basePrice > 0 ? Math.round((basePrice * 0.2) / 1000000) : 0;
            const badges = getBadges(v);
            const { payloadKg, grossKg } = extractWeightsInKg(v);
            const searchBlob = normalizeStr(`${v.name || ''} ${v.brand || ''} ${v.subCategory || ''} ${JSON.stringify(v.specialSpecs || {})}`);

            return (
              <article
                data-order={idx}
                data-brand={String(v.brand || '').trim().toUpperCase()}
                data-price={basePrice}
                data-payload={payloadKg}
                data-gross={grossKg}
                data-search={searchBlob}
                data-slug={v.slug}
                data-name={v.name}
                data-img={v.images?.[0] || '/Logo.png'}
                data-downpayment={downPayment > 0 ? `~${downPayment.toLocaleString('vi-VN')} Triệu` : 'Từ 20% giá xe'}
                data-specs={JSON.stringify({ ...(v.specialSpecs || {}), ...(v.chassisSpecs || {}) })}
                class="cat-vehicle-card bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-lg hover:border-blue-400 transition-all duration-300 overflow-hidden flex flex-col justify-between group"
              >
                <div>
                  <a href={`/san-pham/${v.slug}`} class="relative block aspect-[4/3] overflow-hidden bg-slate-100">
                    <img
                      src={v.images?.[0] || '/Logo.png'}
                      alt={v.name}
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                    {v.brand && (
                      <span class="absolute top-3 left-3 bg-blue-800/95 backdrop-blur-sm text-white text-[10px] font-extrabold px-2.5 py-1 rounded-md uppercase tracking-wider shadow-sm">
                        {v.brand}
                      </span>
                    )}
                    {hasVideo(v) && (
                      <span class="absolute bottom-2 right-2 bg-red-600 text-white text-[10px] font-extrabold px-2.5 py-1 rounded-md shadow">
                        Có Video
                      </span>
                    )}
                  </a>

                  <div class="p-4 space-y-2">
                    <div class="text-[11px] font-bold text-blue-700 uppercase tracking-wide line-clamp-1">
                      {v.subCategory || seoMeta.h1}
                    </div>
                    <h2 class="text-sm sm:text-base font-extrabold text-slate-900 group-hover:text-blue-700 transition leading-snug">
                      <a href={`/san-pham/${v.slug}`}>{v.name}</a>
                    </h2>

                    {badges.length > 0 && (
                      <div class="flex flex-wrap gap-1.5 pt-0.5">
                        {badges.map((b: string) => (
                          <span class="bg-slate-100 text-slate-700 border border-slate-200/80 text-[11px] font-bold px-2 py-0.5 rounded-md">
                            {b}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                </div>

                <div class="p-4 pt-0 mt-auto space-y-2.5">
                  <div class="bg-red-50/70 border border-red-100 rounded-xl p-2.5">
                    <span class="block text-[11px] text-slate-600 font-bold uppercase tracking-wide">Vốn đối ứng nhận xe:</span>
                    {downPayment > 0 ? (
                      <span class="text-sm sm:text-base font-black text-red-600">
                        Trả trước chỉ từ ~{downPayment.toLocaleString('vi-VN')} Triệu
                      </span>
                    ) : (
                      <span class="text-sm sm:text-base font-black text-red-600">Trả trước chỉ từ 20% giá xe</span>
                    )}
                  </div>

                  <div class="grid grid-cols-2 gap-2">
                    <a
                      href={`/san-pham/${v.slug}`}
                      class="text-center bg-blue-700 hover:bg-blue-800 text-white font-bold py-2.5 px-3 rounded-xl text-xs transition shadow-sm"
                    >
                      Chi tiết xe
                    </a>
                    <a
                      href={`/tinh-lan-banh?xe=${v.slug}`}
                      class="text-center bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold py-2.5 px-3 rounded-xl text-xs transition"
                    >
                      Tính lăn bánh
                    </a>
                  </div>
                  <button
                    type="button"
                    data-compare-slug={v.slug}
                    class="btn-compare-toggle w-full py-2 px-3 rounded-xl border border-slate-200 hover:border-blue-600 text-slate-700 hover:text-blue-700 font-bold text-xs transition flex items-center justify-center gap-1.5 cursor-pointer bg-slate-50/70"
                  >
                    + Chọn so sánh cấu hình
                  </button>
                </div>
              </article>
            );
          })}
        </div>

        <div id="emptyFilterNotice" class="hidden bg-white rounded-2xl border border-slate-200 p-10 text-center space-y-3 mt-4">
          <p class="text-base sm:text-lg font-extrabold text-slate-800">Không tìm thấy mẫu xe nào khớp với điều kiện lọc hiện tại.</p>
          <p class="text-xs sm:text-sm text-slate-500">Anh/chị có thể thử chọn lại hãng xe khác hoặc nhấn đặt lại bộ lọc để xem toàn bộ danh mục.</p>
          <button
            type="button"
            id="btnResetFiltersEmpty"
            class="inline-block bg-blue-700 hover:bg-blue-800 text-white font-bold px-5 py-2.5 rounded-xl text-xs sm:text-sm transition cursor-pointer"
          >
            Xem tất cả xe trong mục này
          </button>
        </div>
      </>
    )}
  
    <!-- BƯỚC 3: THANH SO SÁNH NHANH & BẢNG ĐỐI CHIẾU SONG SONG 2-3 MẪU XE -->
    <div id="compareFloatingBar" class="hidden fixed bottom-16 md:bottom-5 left-1/2 -translate-x-1/2 z-40 w-[95%] max-w-3xl bg-slate-900 text-white rounded-2xl shadow-2xl border border-slate-700 p-3.5 sm:px-5 flex flex-col sm:flex-row items-center justify-between gap-3">
      <div class="flex items-center gap-2.5 flex-wrap justify-center sm:justify-start">
        <span class="text-xs font-extrabold uppercase tracking-wider text-sky-300">Đang chọn so sánh (<span id="compareCountBadge">0</span>/3):</span>
        <div id="compareSelectedNames" class="flex flex-wrap gap-1.5 text-xs"></div>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <button type="button" id="btnClearCompare" class="px-3 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-xs font-bold cursor-pointer">
          Xóa chọn
        </button>
        <button type="button" id="btnOpenCompareModal" class="px-4 py-2 rounded-xl bg-red-600 hover:bg-red-700 text-white text-xs font-extrabold shadow-sm cursor-pointer">
          So sánh chi tiết ngay
        </button>
      </div>
    </div>

    <div id="compareResultModal" class="hidden fixed inset-0 z-50 bg-slate-900/75 backdrop-blur-xs flex items-center justify-center p-3 sm:p-6">
      <div class="bg-white rounded-2xl max-w-5xl w-full max-h-[88vh] overflow-hidden flex flex-col shadow-2xl border border-slate-200">
        <div class="bg-gradient-to-r from-blue-900 to-blue-800 text-white px-5 py-4 flex items-center justify-between">
          <div>
            <span class="text-[11px] font-bold uppercase tracking-wider text-sky-300">Tư Vấn Lựa Chọn Cấu Hình</span>
            <h3 class="text-base sm:text-xl font-extrabold">Bảng Đối Chiếu Thông Số Kỹ Thuật &amp; Vốn Đầu Tư</h3>
          </div>
          <button type="button" id="btnCloseCompareModal" class="w-8 h-8 rounded-lg bg-white/15 hover:bg-white/25 text-white font-bold flex items-center justify-center cursor-pointer">
            ×
          </button>
        </div>
        <div id="compareTableContainer" class="p-4 sm:p-6 overflow-auto flex-1"></div>
      </div>
    </div>

    <script is:inline>
      (function() {
        const selectedSlugs = new Set();
        const toggleBtns = document.querySelectorAll('.btn-compare-toggle');
        const floatingBar = document.getElementById('compareFloatingBar');
        const countBadge = document.getElementById('compareCountBadge');
        const namesContainer = document.getElementById('compareSelectedNames');
        const btnClear = document.getElementById('btnClearCompare');
        const btnOpenModal = document.getElementById('btnOpenCompareModal');
        const modal = document.getElementById('compareResultModal');
        const btnCloseModal = document.getElementById('btnCloseCompareModal');
        const tableContainer = document.getElementById('compareTableContainer');

        function getCardData(slug) {
          const card = document.querySelector(`.cat-vehicle-card[data-slug="${slug}"]`);
          if (!card) return null;
          let specsObj = {};
          try {
            specsObj = JSON.parse(card.getAttribute('data-specs') || '{}');
          } catch (e) {}
          return {
            slug,
            name: card.getAttribute('data-name') || slug,
            brand: card.getAttribute('data-brand') || '',
            img: card.getAttribute('data-img') || '/Logo.png',
            downPayment: card.getAttribute('data-downpayment') || 'Từ 20% giá xe',
            payloadKg: Number(card.getAttribute('data-payload') || 0),
            grossKg: Number(card.getAttribute('data-gross') || 0),
            specs: specsObj
          };
        }

        function syncCompareUI() {
          toggleBtns.forEach((btn) => {
            const s = btn.getAttribute('data-compare-slug');
            const isSelected = selectedSlugs.has(s);
            if (isSelected) {
              btn.className = "btn-compare-toggle w-full py-2 px-3 rounded-xl border border-blue-700 bg-blue-700 text-white font-extrabold text-xs transition flex items-center justify-center gap-1.5 cursor-pointer";
              btn.textContent = "✓ Đã chọn so sánh";
            } else {
              btn.className = "btn-compare-toggle w-full py-2 px-3 rounded-xl border border-slate-200 hover:border-blue-600 text-slate-700 hover:text-blue-700 font-bold text-xs transition flex items-center justify-center gap-1.5 cursor-pointer bg-slate-50/70";
              btn.textContent = "+ Chọn so sánh cấu hình";
            }
          });

          if (countBadge) countBadge.textContent = String(selectedSlugs.size);
          if (floatingBar) {
            floatingBar.classList.toggle('hidden', selectedSlugs.size === 0);
          }
          if (namesContainer) {
            namesContainer.innerHTML = Array.from(selectedSlugs).map((s) => {
              const info = getCardData(s);
              return `<span class="bg-white/15 px-2.5 py-1 rounded-lg font-semibold truncate max-w-[160px]">${info?.name || s}</span>`;
            }).join('');
          }
        }

        toggleBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const slug = btn.getAttribute('data-compare-slug');
            if (!slug) return;
            if (selectedSlugs.has(slug)) {
              selectedSlugs.delete(slug);
            } else {
              if (selectedSlugs.size >= 3) {
                alert('Anh/chị chỉ có thể chọn tối đa 3 mẫu xe để đối chiếu cùng lúc.');
                return;
              }
              selectedSlugs.add(slug);
            }
            syncCompareUI();
          });
        });

        btnClear?.addEventListener('click', () => {
          selectedSlugs.clear();
          syncCompareUI();
        });

        btnOpenModal?.addEventListener('click', () => {
          if (selectedSlugs.size < 2) {
            alert('Vui lòng chọn ít nhất 2 mẫu xe để bắt đầu so sánh thông số.');
            return;
          }
          const items = Array.from(selectedSlugs).map(getCardData).filter(Boolean);

          // Bộ ánh xạ gom nhóm thông số đồng nghĩa về đúng 1 tiêu chí chuẩn
          const STANDARD_ROWS = [
            { label: 'Kích thước tổng thể (D x R x C)', keys: ['kích thước tổng thể', 'kích thước bao', 'kích thước xe'] },
            { label: 'Chiều dài cơ sở', keys: ['chiều dài cơ sở', 'khoảng cách trục'] },
            { label: 'Động cơ & Dung tích xy-lanh', keys: ['động cơ', 'kiểu động cơ', 'loại động cơ', 'dung tích'] },
            { label: 'Công suất cực đại', keys: ['công suất', 'công suất lớn nhất'] },
            { label: 'Hộp số & Cỡ lốp', keys: ['hộp số', 'cỡ lốp', 'lốp xe'] },
            { label: 'Thể tích / Dung tích chuyên dùng', keys: ['thể tích', 'dung tích bồn', 'dung tích chứa', 'sức chứa'] },
            { label: 'Vật liệu chế tạo thùng / bồn', keys: ['vật liệu', 'chất liệu', 'inox', 'thép'] },
            { label: 'Số khoang / Kết cấu sàn', keys: ['số khoang', 'kích thước lòng', 'kích thước sàn', 'sàn trượt'] },
            { label: 'Cơ chế xả / Thiết bị chuyên dùng', keys: ['cơ chế xả', 'hệ thống xả', 'trục vít', 'thổi khí', 'tời', 'cẩu', 'càng kéo', 'chức năng', 'hệ thống chuyên dùng'] },
            { label: 'Hệ thống thủy lực & Bơm', keys: ['thủy lực', 'bơm', 'pto', 'van'] }
          ];

          function extractStandardValue(specsObj, aliases) {
            if (!specsObj) return '';
            const entries = Object.entries(specsObj);
            // Ưu tiên khớp chính xác cụm từ khóa
            for (const alias of aliases) {
              for (const [k, v] of entries) {
                if (k.toLowerCase().includes(alias) && String(v).trim()) {
                  return String(v).trim();
                }
              }
            }
            return '';
          }

          // Lọc các tiêu chí chuẩn mà có ít nhất 1 trong các xe đang chọn có dữ liệu
          const populatedStandardRows = STANDARD_ROWS.map((row) => {
            const values = items.map((it) => extractStandardValue(it.specs, row.keys));
            const hasAny = values.some((v) => v !== '');
            const uniqueNonEmpty = new Set(values.filter(Boolean));
            const isDifferent = uniqueNonEmpty.size > 1;
            return { label: row.label, values, hasAny, isDifferent };
          }).filter((r) => r.hasAny);

          let html = `<div class="mb-3 flex flex-wrap items-center justify-between gap-2 text-xs text-slate-600 bg-blue-50/80 border border-blue-100 px-3.5 py-2 rounded-xl">
            <span>💡 Hệ thống tự động chuẩn hóa &amp; gom nhóm các thông số tương đương để đối chiếu chính xác.</span>
            <span class="font-bold text-blue-800">Các dòng tô nền vàng nhạt là điểm khác biệt giữa các xe</span>
          </div>
          <div class="overflow-x-auto border border-slate-200 rounded-xl">
          <table class="w-full table-fixed text-left border-collapse text-xs sm:text-sm min-w-[680px]">
            <colgroup>
              <col class="w-40 sm:w-48" />
              ${items.map(() => `<col style="width: calc((100% - 12rem) / ${items.length});" />`).join('')}
            </colgroup>
            <thead>
              <tr class="border-b border-slate-200">
                <th class="p-3 bg-slate-100 font-extrabold text-slate-800 border-r border-slate-200">Tiêu chí đối chiếu</th>
                ${items.map((it) => `
                  <th class="p-3 align-top bg-white border-r last:border-r-0 border-slate-200">
                    <img src="${it.img}" alt="${it.name}" class="w-full h-32 object-cover rounded-xl mb-2 border border-slate-200" />
                    <a href="/san-pham/${it.slug}" class="font-extrabold text-blue-800 hover:underline block leading-snug">${it.name}</a>
                  </th>
                `).join('')}
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              <tr>
                <td class="p-3 border-r last:border-r-0 border-slate-200/80 break-words align-top bg-slate-50 font-bold text-slate-700">Thương hiệu</td>
                ${items.map((it) => `<td class="p-3 border-r last:border-r-0 border-slate-200/80 break-words align-top font-extrabold text-slate-900 uppercase">${it.brand || 'Chính hãng'}</td>`).join('')}
              </tr>
              <tr>
                <td class="p-3 border-r last:border-r-0 border-slate-200/80 break-words align-top bg-slate-50 font-bold text-slate-700">Vốn đối ứng nhận xe</td>
                ${items.map((it) => `<td class="p-3 border-r last:border-r-0 border-slate-200/80 break-words align-top font-black text-red-600">${it.downPayment}</td>`).join('')}
              </tr>
              <tr class="bg-amber-50/40">
                <td class="p-3 border-r last:border-r-0 border-slate-200/80 break-words align-top bg-slate-50 font-bold text-slate-700">Tải trọng cho phép</td>
                ${items.map((it) => `<td class="p-3 border-r last:border-r-0 border-slate-200/80 break-words align-top font-extrabold text-blue-900">${it.payloadKg > 0 ? (it.payloadKg / 1000).toFixed(2).replace(/\.?0+$/, '') + ' Tấn' : 'Theo phiếu ĐK'}</td>`).join('')}
              </tr>
              <tr>
                <td class="p-3 border-r last:border-r-0 border-slate-200/80 break-words align-top bg-slate-50 font-bold text-slate-700">Tổng trọng tải</td>
                ${items.map((it) => `<td class="p-3 border-r last:border-r-0 border-slate-200/80 break-words align-top font-bold text-slate-900">${it.grossKg > 0 ? (it.grossKg / 1000).toFixed(2).replace(/\.?0+$/, '') + ' Tấn' : 'Theo phiếu ĐK'}</td>`).join('')}
              </tr>
              ${populatedStandardRows.map((row) => `
                <tr class="${row.isDifferent ? 'bg-amber-50/50' : ''}">
                  <td class="p-3 border-r last:border-r-0 border-slate-200/80 break-words align-top bg-slate-50 font-bold text-slate-700">${row.label}</td>
                  ${row.values.map((val) => `<td class="p-3 border-r last:border-r-0 border-slate-200/80 break-words align-top ${row.isDifferent && val ? 'font-bold text-slate-950' : 'text-slate-700'}">${val || '<span class="text-slate-400 italic">Theo cấu hình chuẩn</span>'}</td>`).join('')}
                </tr>
              `).join('')}
              <tr>
                <td class="p-3 border-r last:border-r-0 border-slate-200/80 break-words align-top bg-slate-50 font-bold text-slate-700">Chi tiết &amp; Hồ sơ</td>
                ${items.map((it) => `
                  <td class="p-3">
                    <a href="/san-pham/${it.slug}" class="inline-block w-full text-center bg-blue-700 hover:bg-blue-800 text-white font-bold py-2.5 px-3 rounded-xl text-xs shadow-xs">
                      Xem chi tiết &amp; Xuất PDF
                    </a>
                  </td>
                `).join('')}
              </tr>
            </tbody>
          </table>
          </div>`;

          if (tableContainer) tableContainer.innerHTML = html;
          modal?.classList.remove('hidden');
        });

        btnCloseModal?.addEventListener('click', () => modal?.classList.add('hidden'));
        modal?.addEventListener('click', (e) => {
          if (e.target === modal) modal.classList.add('hidden');
        });
      })();
    </script>

  
    <!-- KHỐI HỎI ĐÁP CHUYÊN GIA & FAQ SCHEMA TỐI ƯU GOOGLE AI OVERVIEW -->
