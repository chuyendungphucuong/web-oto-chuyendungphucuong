---
import BaseLayout from '../layouts/BaseLayout.astro';
import vehicles from '../data/vehicles.json';

const formatVND = (price: number) => price.toLocaleString('vi-VN') + ' đ';
---

<BaseLayout 
  title="Xe Tải Chuyên Dùng & Ô Tô Khách Chính Hãng Miền Nam"
  description="Đại lý Ô Tô Chuyên Dùng Phú Cường (TP.HCM, Tiền Giang, An Giang): Phân phối xe tải gắn cẩu, xe ép rác, xe bồn, xe ben và xe khách 16-47 chỗ giá gốc."
>
  <!-- Banner chính -->
  <section class="bg-gradient-to-r from-blue-950 to-slate-900 text-white py-12 px-4">
    <div class="max-w-7xl mx-auto">
      <span class="bg-amber-500 text-slate-900 text-xs font-extrabold px-3 py-1 rounded-full uppercase">
        Hệ thống 3 Showroom: TP.HCM • Tiền Giang • An Giang
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold mt-4 leading-tight">
        Tổng Kho Xe Tải Chuyên Dùng & Ô Tô Khách Phú Cường
      </h1>
      <p class="mt-3 text-slate-300 max-w-2xl text-lg">
        Chuyên thiết kế đóng mới thùng chuyên dùng (Cẩu, Bồn, Ép rác, Đông lạnh) và phân phối xe khách 16 - 47 chỗ. Hỗ trợ vay 80%, giao xe ngay.
      </p>
    </div>
  </section>

  <!-- ND-ND- -->
  <section class="max-w-7xl mx-auto px-4 py-12">
  <!-- Tiêu đề chính chuẩn SEO -->
  <h1 class="text-3xl md:text-4xl font-extrabold text-blue-950 mb-6">
    Ô Tô Chuyên Dùng Phú Cường - Đơn Vị Phân Phối & Đóng Thùng Xe Chuyên Dụng Hàng Đầu Miền Nam
  </h1>

  <!-- Đoạn tóm tắt trực diện cho AI Overviews -->
  <div class="bg-blue-50 border-l-4 border-blue-900 p-5 rounded-r-lg mb-8 text-slate-700 leading-relaxed text-base">
    <p>
      <strong>Ô Tô Chuyên Dùng Phú Cường</strong> với hơn 13 năm kinh nghiệm trong ngành, tự hào là đối tác tin cậy chuyên cung cấp các dòng <strong>xe tải chuyên dùng, xe cẩu, xe bồn, xe ép rác, xe nâng đầu</strong> và ô tô khách chính hãng. Sở hữu hệ thống xưởng đóng thùng chuyên biệt cùng 3 showroom trực thuộc tại <strong>TP.HCM, Tiền Giang và An Giang</strong>, chúng tôi mang đến giải pháp vận tải toàn diện, tối ưu chi phí và đồng hành bền vững cùng các doanh nghiệp vận tải.
    </p>
  </div>

  <!-- Các giá trị cốt lõi & Thế mạnh -->
  <div class="grid md:grid-cols-3 gap-6 mb-10">
    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
      <h2 class="text-lg font-bold text-blue-900 mb-2">1. Hệ Thống 3 Showroom Miền Nam</h2>
      <p class="text-sm text-slate-600 leading-relaxed">
        Trưng bày xe sẵn giao ngay tại Bình Chánh (TP.HCM), Nhị Quý (Tiền Giang) và Bình Đức (An Giang), hỗ trợ xem xe và bảo dưỡng thuận tiện cho khách hàng toàn vùng ĐBSCL.
      </p>
    </div>

    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
      <h2 class="text-lg font-bold text-blue-900 mb-2">2. Xưởng Đóng Thùng Chuyên Sâu</h2>
      <p class="text-sm text-slate-600 leading-relaxed">
        Xưởng cơ khí quy mô lớn chuyên thiết kế, đóng mới, hoán cải và cải tạo các loại thùng chuyên dùng theo đúng tiêu chuẩn Cục Đăng Kiểm với độ bền cao và bảo hành uy tín.
      </p>
    </div>

    <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
      <h2 class="text-lg font-bold text-blue-900 mb-2">3. Giải Pháp Tài Chính Tối Ưu</h2>
      <p class="text-sm text-slate-600 leading-relaxed">
        Hỗ trợ thủ tục mua xe trả góp qua ngân hàng hoặc thuê tài chính lên đến 80% giá trị xe, giải ngân nhanh chóng, thủ tục đơn giản cho cả cá nhân và doanh nghiệp.
      </p>
    </div>
  </div>

  <!-- Khối Câu Hỏi Thường Gặp (FAQ) cho AI Overviews -->
  <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
    <h2 class="text-xl font-extrabold text-blue-950 mb-4">Câu Hỏi Thường Gặp Về Ô Tô Chuyên Dùng Phú Cường</h2>
    <div class="space-y-4 text-sm">
      <div class="border-b border-slate-100 pb-3">
        <h3 class="font-bold text-slate-900">❓ Ô Tô Chuyên Dùng Phú Cường phân phối những dòng xe nào?</h3>
        <p class="text-slate-600 mt-1">Chúng tôi cung cấp đa dạng các dòng xe chuyên dùng gồm: xe cẩu tự hành, xe bồn (nước, hút chất thải), xe cuốn ép rác, xe nâng đầu chở máy, xe khách 16-47 chỗ từ các thương hiệu uy tín như Hino, Isuzu, Foton, Dongfeng...</p>
      </div>
      <div class="border-b border-slate-100 pb-3">
        <h3 class="font-bold text-slate-900">❓ Liên hệ tư vấn và xem xe trực tiếp ở đâu tại miền Nam?</h3>
        <p class="text-slate-600 mt-1">Quý khách có thể ghé trực tiếp 3 showroom tại Bình Chánh (TP.HCM), Tiền Giang hoặc An Giang, hoặc gọi ngay Hotline 24/7: <strong>0922 77 77 03</strong> để được tư vấn chọn đúng tải trọng và nhận báo giá lăn bánh chi tiết.</p>
      </div>
    </div>
  </div>

  <!-- Kêu gọi hành động (CTA) -->
  <div class="mt-8 text-center bg-gradient-to-r from-blue-900 to-slate-900 text-white p-8 rounded-xl shadow-md">
    <h3 class="text-2xl font-bold mb-2">Đầu Tư Hiệu Quả - Đồng Hành Bền Vững Cùng Phú Cường</h3>
    <p class="text-slate-300 mb-6 text-sm">Liên hệ ngay với đội ngũ chuyên viên kỹ thuật để nhận tư vấn giải pháp vận tải phù hợp nhất cho doanh nghiệp của bạn.</p>
    <a href="tel:0922777703" class="inline-block bg-red-600 hover:bg-red-700 text-white font-extrabold px-8 py-3 rounded-lg text-lg transition shadow-lg">
      📞 Hotline Tư Vấn & Cứu Hộ: 0922 77 77 03
    </a>
  </div>
</section>

  <!-- Bộ lọc chi tiết đồng bộ với Menu đa cấp -->
  <section class="max-w-7xl mx-auto px-4 -mt-6">
    <div class="bg-white p-6 rounded-xl shadow-md border border-slate-200 grid md:grid-cols-3 gap-4">
      <div>
        <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Tìm theo tên xe / từ khóa</label>
        <input id="searchInput" type="text" placeholder="VD: Cẩu Palfinger, Foton, 29 chỗ..." class="w-full border border-slate-300 rounded-lg px-4 py-2.5 focus:outline-none focus:border-blue-600 text-sm" />
      </div>
      <div>
        <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Phân loại chuyên sâu (Danh mục)</label>
        <select id="subCategorySelect" class="w-full border border-slate-300 rounded-lg px-4 py-2.5 focus:outline-none focus:border-blue-600 text-sm">
          <option value="all">Tất cả dải sản phẩm</option>
          <optgroup label="Xe Tải Chuyên Dùng">
            <option value="Xe Tải Gắn Cẩu">Xe Tải Gắn Cẩu Tự Hành</option>
            <option value="Xe Bồn Chuyên Dùng">Xe Bồn Chuyên Dùng (Nước, Hút chất thải)</option>
            <option value="Xe Nâng Đầu Chở Xe">Xe Nâng Đầu Chở Xe / Máy</option>
            <option value="Xe Ép Rác Môi Trường">Xe Cuốn Ép Rác Môi Trường</option>
          </optgroup>
          <optgroup label="Ô Tô Khách">
            <option value="Xe Khách 16 Chỗ">Xe Khách 16 Chỗ</option>
            <option value="Xe Khách 29-34 Chỗ">Xe Khách 29 - 34 Chỗ Bầu Hơi</option>
            <option value="Xe Khách 47 Chỗ & Giường Nằm">Xe Khách 47 Chỗ & Giường Nằm</option>
          </optgroup>
        </select>
      </div>
      <div>
        <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Hãng xe nền / Thương hiệu</label>
        <select id="brandSelect" class="w-full border border-slate-300 rounded-lg px-4 py-2.5 focus:outline-none focus:border-blue-600 text-sm">
          <option value="all">Tất cả các hãng</option>
          <option value="Dongfeng">Dongfeng</option>
          <option value="Foton">Foton</option>
          <option value="Weichai">Weichai / Thaco</option>
        </select>
      </div>
    </div>
  </section>

  <!-- Danh sách xe hiển thị -->
  <section class="max-w-7xl mx-auto px-4 py-10">
    <div id="vehicleGrid" class="grid md:grid-cols-3 gap-6">
      {vehicles.map((v) => (
        <article 
          class="vehicle-card bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col justify-between hover:shadow-md transition"
          data-name={v.name.toLowerCase()}
          data-subcategory={v.subCategory}
          data-brand={v.brand}
        >
          <div>
            <div class="relative">
              <img src={v.images[0]} alt={v.name} class="w-full h-52 object-cover" loading="lazy" />
              <span class="absolute top-3 left-3 bg-blue-900 text-white text-xs font-bold px-2.5 py-1 rounded">
                {v.subCategory}
              </span>
            </div>
            <div class="p-5">
              <h2 class="font-bold text-lg text-slate-900 hover:text-blue-800">
                <a href={`/san-pham/${v.slug}`}>{v.name}</a>
              </h2>
              <p class="text-2xl font-extrabold text-red-600 mt-2">{formatVND(v.price)}</p>
              <p class="text-xs text-emerald-700 bg-emerald-50 p-2 rounded mt-2 font-medium">
                🎁 {v.promo}
              </p>
              <div class="mt-3 text-xs text-slate-500">
                📍 Sẵn xe: {v.showrooms.join(' • ')}
              </div>
            </div>
          </div>
          <div class="p-5 pt-0 grid grid-cols-2 gap-2">
            <a href={`/san-pham/${v.slug}`} class="text-center bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold py-2.5 rounded-lg text-sm">
              Thông số & Lăn bánh
            </a>
            <a href="tel:0922777703" data-gtm-event="click_call_card" class="text-center bg-red-600 hover:bg-red-700 text-white font-bold py-2.5 rounded-lg text-sm">
              Báo Giá Tốt Nhất
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <script>
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const subCategorySelect = document.getElementById('subCategorySelect') as HTMLSelectElement;
    const brandSelect = document.getElementById('brandSelect') as HTMLSelectElement;
    const cards = document.querySelectorAll('.vehicle-card');

    function filterVehicles() {
      const q = searchInput.value.toLowerCase();
      const subCat = subCategorySelect.value;
      const brand = brandSelect.value;

      cards.forEach((card) => {
        const el = card as HTMLElement;
        const matchName = el.dataset.name?.includes(q);
        const matchSubCat = subCat === 'all' || el.dataset.subcategory === subCat;
        const matchBrand = brand === 'all' || el.dataset.brand === brand;
        el.style.display = (matchName && matchSubCat && matchBrand) ? 'flex' : 'none';
      });
    }

    searchInput?.addEventListener('input', filterVehicles);
    subCategorySelect?.addEventListener('change', filterVehicles);
    brandSelect?.addEventListener('change', filterVehicles);
  </script>

</BaseLayout>
