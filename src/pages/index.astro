---
import BaseLayout from '../layouts/BaseLayout.astro';
import vehicles from '../data/vehicles.json';

const formatVND = (price: number) => price.toLocaleString('vi-VN') + ' đ';
---

<BaseLayout 
  title="Xe Tải Chuyên Dùng & Ô Tô Khách Chính Hãng Miền Nam"
  description="Đại lý Ô Tô Chuyên Dùng Phú Cường (TP.HCM, Tiền Giang, An Giang): Phân phối xe tải gắn cẩu, xe ép rác, xe bồn, xe ben và xe khách 16-47 chỗ giá gốc."
>
  <!-- Banner chính -->
  <section class="bg-gradient-to-r from-blue-950 to-slate-900 text-white py-12 px-4">
    <div class="max-w-7xl mx-auto">
      <span class="bg-amber-500 text-slate-900 text-xs font-extrabold px-3 py-1 rounded-full uppercase">
        Hệ thống 3 Showroom: TP.HCM • Tiền Giang • An Giang
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold mt-4 leading-tight">
        Tổng Kho Xe Tải Chuyên Dùng & Ô Tô Khách Phú Cường
      </h1>
      <p class="mt-3 text-slate-300 max-w-2xl text-lg">
        Chuyên thiết kế đóng mới thùng chuyên dùng (Cẩu, Bồn, Ép rác, Đông lạnh) và phân phối xe khách 16 - 47 chỗ. Hỗ trợ vay 80%, giao xe ngay.
      </p>
    </div>
  </section>

  <!-- Bộ lọc tức thì (Zero-Latency Filter) -->
  <section class="max-w-7xl mx-auto px-4 -mt-6">
    <div class="bg-white p-6 rounded-xl shadow-md border border-slate-200 grid md:grid-cols-3 gap-4">
      <div>
        <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Tìm theo tên xe / tải trọng / số chỗ</label>
        <input id="searchInput" type="text" placeholder="VD: Hino 8 tấn, cẩu Unic, 29 chỗ..." class="w-full border border-slate-300 rounded-lg px-4 py-2.5 focus:outline-none focus:border-blue-600" />
      </div>
      <div>
        <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Phân loại xe</label>
        <select id="categorySelect" class="w-full border border-slate-300 rounded-lg px-4 py-2.5 focus:outline-none focus:border-blue-600">
          <option value="all">Tất cả dòng xe</option>
          <option value="xe-tai-chuyen-dung">🚛 Xe Tải Chuyên Dùng</option>
          <option value="xe-khach">🚌 Ô Tô Khách</option>
        </select>
      </div>
      <div>
        <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Hãng xe nền / Động cơ</label>
        <select id="brandSelect" class="w-full border border-slate-300 rounded-lg px-4 py-2.5 focus:outline-none focus:border-blue-600">
          <option value="all">Tất cả hãng</option>
          <option value="Hino">Hino</option>
          <option value="Isuzu">Isuzu</option>
          <option value="Weichai">Weichai / Thaco</option>
        </select>
      </div>
    </div>
  </section>

  <!-- Danh sách xe -->
  <section class="max-w-7xl mx-auto px-4 py-10">
    <div id="vehicleGrid" class="grid md:grid-cols-3 gap-6">
      {vehicles.map((v) => (
        <article 
          class="vehicle-card bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col justify-between hover:shadow-md transition"
          data-name={v.name.toLowerCase()}
          data-category={v.category}
          data-brand={v.brand}
        >
          <div>
            <div class="relative">
              <img src={v.image} alt={v.name} class="w-full h-52 object-cover" loading="lazy" />
              <span class="absolute top-3 left-3 bg-blue-900 text-white text-xs font-bold px-2.5 py-1 rounded">
                {v.subCategory}
              </span>
            </div>
            <div class="p-5">
              <h2 class="font-bold text-lg text-slate-900 hover:text-blue-800">
                <a href={`/san-pham/${v.slug}`}>{v.name}</a>
              </h2>
              <p class="text-2xl font-extrabold text-red-600 mt-2">{formatVND(v.price)}</p>
              <p class="text-xs text-emerald-700 bg-emerald-50 p-2 rounded mt-2 font-medium">
                🎁 {v.promo}
              </p>
              <div class="mt-3 text-xs text-slate-500">
                📍 Sẵn xe: {v.showrooms.join(' • ')}
              </div>
            </div>
          </div>
          <div class="p-5 pt-0 grid grid-cols-2 gap-2">
            <a href={`/san-pham/${v.slug}`} class="text-center bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold py-2.5 rounded-lg text-sm">
              Thông số & Lăn bánh
            </a>
            <a href="tel:0900000000" data-gtm-event="click_call_card" class="text-center bg-red-600 hover:bg-red-700 text-white font-semibold py-2.5 rounded-lg text-sm">
              Báo Giá Tốt Nhất
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <script>
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const categorySelect = document.getElementById('categorySelect') as HTMLSelectElement;
    const brandSelect = document.getElementById('brandSelect') as HTMLSelectElement;
    const cards = document.querySelectorAll('.vehicle-card');

    function filterVehicles() {
      const q = searchInput.value.toLowerCase();
      const cat = categorySelect.value;
      const brand = brandSelect.value;

      cards.forEach((card) => {
        const el = card as HTMLElement;
        const matchName = el.dataset.name?.includes(q);
        const matchCat = cat === 'all' || el.dataset.category === cat;
        const matchBrand = brand === 'all' || el.dataset.brand === brand;
        el.style.display = (matchName && matchCat && matchBrand) ? 'flex' : 'none';
      });
    }

    searchInput?.addEventListener('input', filterVehicles);
    categorySelect?.addEventListener('change', filterVehicles);
    brandSelect?.addEventListener('change', filterVehicles);
  </script>
</BaseLayout>
