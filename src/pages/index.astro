---
import BaseLayout from '../layouts/BaseLayout.astro';
import { allVehicles } from '../data/vehicles.js';
import postsData from '../data/posts.json';

const vehicleList = Array.isArray(allVehicles) ? allVehicles : [];

const coreServices = [
  { title: "Cứu Hộ Chuyên Dùng 24/7", desc: "Đội ngũ xe sàn trượt và cẩu trực chiến hỗ trợ khẩn cấp mọi lúc mọi nơi.", icon: "🚨", link: "/dich-vu/cuu-ho-chuyen-dung" },
  { title: "Sửa Chữa Động Cơ & Thủy Lực", desc: "Đại tu động cơ Cummins, Yuchai, Hino và phục hồi hệ thống bơm van.", icon: "⚙️", link: "/dich-vu/sua-xe-chuyen-dung" },
  { title: "Sửa Chữa & Gia Cố Thùng Bồn", desc: "Hàn vá bồn xitec, gia cố khung xương thùng xe tải, chống rò rỉ.", icon: "🚛", link: "/dich-vu/sua-thung-bon" },
  { title: "Đăng Kiểm & Cải Tạo Hồ Sơ", desc: "Trọn gói thủ tục thiết kế hoán cải, đăng kiểm và cấp biển số vàng.", icon: "📄", link: "/dich-vu/cai-tao-ho-so" }
];

const factoryCapabilities = [
  {
    badge: "01. Trực Tiếp Thiết Kế & Đóng Mới",
    title: "Xưởng Cơ Khí Chuyên Dùng Thực Tế",
    desc: "Trực tiếp gia công bồn cám, sàn trượt cứu hộ và lắp đặt cẩu tại xưởng Bình Chánh (TP.HCM). Khách hàng nghiệm thu từng công đoạn từ khung phụ, thân bồn đến sơn hoàn thiện.",
    specs: ["Hồ sơ thiết kế Cục Đăng Kiểm VN", "Chủ động tiến độ đóng thùng/bồn"]
  },
  {
    badge: "02. Minh Bạch Vật Liệu & Thủy Lực",
    title: "Kiểm Soát Độ Dày & Linh Kiện Chính Hãng",
    desc: "Cam kết đúng chủng loại thép SS400 hoặc Inox SUS304 theo hợp đồng. Hệ thống bơm, van, tời thủy lực, mô-tơ trục vít và PTO nhập khẩu đồng bộ, thử tải thực tế trước khi xuất xưởng.",
    specs: ["Đúng mác thép & độ dày cam kết", "Thử tải & kiểm tra độ kín 100%"]
  },
  {
    badge: "03. Bảo Hành Đồng Bộ Một Đầu Mối",
    title: "Trách Nhiệm Trọn Đời Xe & Chuyên Dùng",
    desc: "Bảo hành song song cả xe cơ sở (Chassis) và thiết bị chuyên dùng (bồn, trục vít, xi-lanh thủy lực). Đội xe cứu hộ và kỹ thuật lưu động hỗ trợ khẩn cấp tận nơi 24/7 khi có sự cố.",
    specs: ["Bảo hành bồn & thủy lực 12–24 tháng", "Hỗ trợ kỹ thuật lưu động tận trại/công trình"]
  }
];

const handoverPosts = ((Array.isArray(postsData) ? postsData.filter((p) => !p?.isHidden) : []))
  .filter((p: any) => {
    const t = String(p.title || "").toLowerCase();
    const c = String(p.category || "").toLowerCase();
    return c.includes("bàn giao") || t.includes("bàn giao") || t.includes("nghiệm thu") || t.includes("xuất xưởng") || t.includes("khách hàng");
  })
  .slice(0, 4);

const latestPosts = Array.isArray(postsData) ? postsData.slice(0, 24) : [];

function normalizeHomeNewsCat(cat: any) {
  const s = String(cat || "").toLowerCase()
    .normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[đĐ]/g, "d");
  if (s.includes("so sanh") || s.includes("danh gia") || s.includes("tu van")) return "danh-gia-so-sanh";
  if (s.includes("phap ly") || s.includes("dang kiem") || s.includes("thu tuc")) return "phap-ly-dang-kiem";
  if (s.includes("kinh nghiem") || s.includes("dau tu") || s.includes("van tai")) return "kinh-nghiem-van-tai";
  if (s.includes("ban giao") || s.includes("showroom") || s.includes("tin tuc")) return "tin-tuc-ban-giao";
  return "khac";
}

const homeNewsCategories = [
  { key: "danh-gia-so-sanh", label: "Đánh Giá & So Sánh Xe" },
  { key: "phap-ly-dang-kiem", label: "Thủ Tục Pháp Lý & Đăng Kiểm" },
  { key: "kinh-nghiem-van-tai", label: "Kinh Nghiệm Vận Tải & Đầu Tư" },
  { key: "tin-tuc-ban-giao", label: "Tin Tức & Bàn Giao Xe Showroom" }
];

function itemHasVideo(item: any) {
  if (!item) return false;
  if (item.videoUrl && String(item.videoUrl).trim() !== "") return true;
  if (item.youtubeUrl && String(item.youtubeUrl).trim() !== "") return true;
  const bodyText = String(item.description || item.content || "");
  return /(?:youtube\.com\/(?:watch\?v=|shorts\/|embed\/)|youtu\.be\/)[a-zA-Z0-9_-]{11}/i.test(bodyText);
}

function getCardSpecBadges(p: any) {
  if (!p) return [];
  if (p.customBadges) {
    const manualList = Array.isArray(p.customBadges)
      ? p.customBadges.map((s: any) => String(s).trim()).filter(Boolean)
      : String(p.customBadges).split(/[,|]/).map((s: string) => s.trim()).filter(Boolean);
    if (manualList.length > 0) return manualList.slice(0, 3);
  }
  const badges = [];
  const chassis = p.chassisSpecs || {};
  const special = p.specialSpecs || {};
  const all = [...Object.entries(chassis), ...Object.entries(special)];

  for (const [k, v] of all) {
    const kl = String(k).toLowerCase();
    const vs = String(v);
    if (kl.includes("thể tích") || kl.includes("dung tích")) {
      const m = vs.match(/(\d+(?:[.,]\d+)?)\s*(?:khối|khoi|m3|m³)/i);
      if (m) {
        badges.push(`🛢️ Bồn ${m[1]} Khối`);
        break;
      }
    }
  }

  for (const [k, v] of all) {
    const kl = String(k).toLowerCase();
    const vs = String(v);
    if (kl.includes("tải trọng cho phép") || kl.includes("tải trọng chuyên chở") || kl.includes("khối lượng hàng") || kl.includes("tải trọng chở")) {
      const kgMatch = vs.match(/(\d{1,2}\.\d{3}|\d{3,5})\s*kg/i);
      if (kgMatch) {
        const ton = (parseFloat(kgMatch[1].replace(".", "")) / 1000).toFixed(2).replace(/\.?0+$/, "");
        badges.push(`⚖️ Tải ${ton} Tấn`);
        break;
      }
      const tonMatch = vs.match(/(\d+(?:[.,]\d+)?)\s*(?:tấn|tan)/i);
      if (tonMatch) {
        badges.push(`⚖️ Tải ${tonMatch[1]} Tấn`);
        break;
      }
    }
  }

  for (const [k, v] of all) {
    if (badges.length >= 2) break;
    const vs = String(v);
    if (/inox\s*304/i.test(vs)) {
      badges.push("🛡️ Inox 304");
      break;
    } else if (/sàn trượt/i.test(vs) && /càng kéo/i.test(vs)) {
      badges.push("🔧 Sàn trượt + Càng kéo");
      break;
    } else if (/kích thước.*sàn|lòng thùng/i.test(String(k))) {
      const dim = vs.match(/(\d[.,]\d+|\d{4})\s*x\s*(\d[.,]\d+|\d{4})/i);
      if (dim) {
        const d1 = dim[1].length === 4 ? (parseInt(dim[1]) / 1000).toFixed(1) + "m" : dim[1] + "m";
        badges.push(`📏 Sàn dài ${d1}`);
        break;
      }
    }
  }

  const nameStr = String(p.name || "");
  if (badges.length === 0) {
    const vMatch = nameStr.match(/(\d+(?:[.,]\d+)?)\s*(?:khối|khoi|m3|m³)/i);
    if (vMatch) badges.push(`🛢️ Bồn ${vMatch[1]} Khối`);

    const tMatch1 = nameStr.match(/(\d+)t(\d+)/i);
    if (tMatch1) badges.push(`⚖️ Tải ${tMatch1[1]}.${tMatch1[2]} Tấn`);
    else {
      const tMatch2 = nameStr.match(/(\d+(?:[.,]\d+)?)\s*(?:tấn|tan|t\b)/i);
      if (tMatch2) badges.push(`⚖️ Tải ${tMatch2[1]} Tấn`);
    }

    const sMatch = nameStr.match(/(\d+)\s*chỗ/i);
    if (sMatch) badges.push(`💺 ${sMatch[1]} Chỗ ngồi`);
  }

  if (badges.length < 2) {
    if (/2 chức năng/i.test(nameStr) && !badges.some(b => b.includes("Sàn trượt"))) {
      badges.push("🔧 Sàn trượt + Càng kéo");
    } else if (/3 chức năng/i.test(nameStr)) {
      badges.push("🏗️ Cẩu + Sàn + Càng kéo");
    } else if (/trục vít/i.test(nameStr)) {
      badges.push("⚙️ Bơm trục vít");
    } else if (/cám thổi|khí nén/i.test(nameStr)) {
      badges.push("💨 Bơm khí nén");
    }
  }

  return badges.slice(0, 2);
}

const feedTrucksRaw = vehicleList.filter((v: any) => {
  const subKey = String(v.subKey || "").toLowerCase();
  const subCat = String(v.subCategory || "").toLowerCase();
  const name = String(v.name || "").toLowerCase();
  return subKey.includes("bon-cho-cam") || subKey.includes("bon-cam") || subCat.includes("bồn cám") || subCat.includes("thức ăn chăn nuôi") || name.includes("bồn cám") || name.includes("chở cám");
});
const featuredFeed = feedTrucksRaw.filter((v: any) => v.isFeatured === true);
const feedTrucks = featuredFeed.length > 0 ? featuredFeed : feedTrucksRaw;

const feedSlugs = new Set(feedTrucks.map((v: any) => v.slug));
const otherVehiclesRaw = vehicleList.filter((v: any) => !feedSlugs.has(v.slug));
const featuredOther = otherVehiclesRaw.filter((v: any) => v.isFeatured === true);
const otherVehicles = featuredOther.length > 0 ? featuredOther : otherVehiclesRaw;
---

<BaseLayout title="Ô Tô Chuyên Dùng Phú Cường | Xe Tải, Xe Bồn, Xe Cứu Hộ Hàng Đầu">
  <style is:inline>
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>

  <main class="space-y-12 pb-16 bg-white text-slate-900">

    <!-- HERO SECTION -->
    <section class="bg-gradient-to-r from-blue-900 via-blue-800 to-indigo-900 text-white py-12 lg:py-16 px-4 shadow-sm">
      <div class="container mx-auto max-w-7xl grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-6">
          <span class="bg-red-600 text-white text-xs font-bold px-3.5 py-1.5 rounded-full uppercase tracking-wider inline-block shadow-sm border border-red-500">
            ⭐ Đại Lý Phân Phối &amp; Đóng Mới Độc Quyền
          </span>
          <h1 class="text-3xl md:text-5xl font-extrabold leading-tight tracking-tight text-white">
            Ô Tô Chuyên Dùng <span class="text-sky-300">Phú Cường</span>
          </h1>
          <p class="text-blue-100 text-base md:text-lg max-w-xl leading-relaxed font-normal">
            Chuyên cung cấp và đóng mới các dòng xe tải chuyên dùng, xe bồn, xe cẩu, xe cứu hộ và ô tô khách chất lượng cao. Hỗ trợ trả góp lên đến 90%, bảo hành toàn quốc.
          </p>
          <div class="flex flex-wrap gap-4 pt-2">
            <a href="/san-pham" class="bg-red-600 hover:bg-red-700 text-white font-bold px-8 py-3.5 rounded-xl transition shadow-md text-base">
              🚗 Khám Phá Kho Xe ({vehicleList.length}+ Mẫu)
            </a>
            <a href="/tinh-lan-banh" class="bg-white/10 hover:bg-white/20 border border-white/25 text-white font-bold px-6 py-3.5 rounded-xl transition text-base backdrop-blur-sm">
              🧮 Tính Giá Lăn Bánh
            </a>
          </div>
        </div>
        <div class="lg:col-span-5">
          <div class="bg-slate-900/40 backdrop-blur-md p-6 rounded-2xl border border-white/15 shadow-xl space-y-4">
            <h3 class="text-xl font-bold border-b border-white/15 pb-3 text-white flex items-center gap-2">
              <span>📍</span> Hệ Thống Showroom Miền Nam
            </h3>
            <div class="space-y-3 text-sm text-blue-100">
              <p><strong>Showroom 1:</strong> 2466 Lê Khả Phiêu, Xã Bình Chánh, TP. HCM</p>
              <p><strong>Showroom 2:</strong> 95 Quốc lộ 1A, Nhị Quý, Tiền Giang</p>
              <p><strong>Showroom 3:</strong> 26 Trần Hưng Đạo, Bình Đức, An Giang</p>
            </div>
            <a href="tel:0922777703" class="block bg-red-600 hover:bg-red-700 text-white font-bold py-3 rounded-xl text-center transition shadow-sm">
              📞 Hotline Tư Vấn: 0922 77 77 03
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- KHỐI SẢN PHẨM NỔI BẬT -->
    <section class="container mx-auto px-4 max-w-7xl space-y-12 pt-4">
      
      <!-- HÀNG 1: XE BỒN CHỞ THỨC ĂN CHĂN NUÔI -->
      {feedTrucks.length > 0 && (
        <div>
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end mb-5 border-b border-slate-200 pb-3.5 gap-3">
            <div>
              <span class="text-blue-700 font-bold text-xs uppercase tracking-wider">Sản Phẩm Thế Mạnh</span>
              <h2 class="text-xl md:text-2xl font-extrabold text-slate-900 mt-0.5">Xe Bồn Chở Thức Ăn Chăn Nuôi (Bồn Cám)</h2>
            </div>
            <div class="flex items-center gap-3 self-end sm:self-auto">
              <div class="flex items-center gap-1.5">
                <button
                  type="button"
                  id="btnPrevFeed"
                  aria-label="Xe bồn cám trước"
                  class="w-9 h-9 rounded-xl border border-slate-300 bg-white hover:bg-blue-700 hover:text-white hover:border-blue-700 text-slate-700 flex items-center justify-center transition shadow-sm cursor-pointer font-bold text-sm"
                >
                  &#10094;
                </button>
                <button
                  type="button"
                  id="btnNextFeed"
                  aria-label="Xe bồn cám tiếp theo"
                  class="w-9 h-9 rounded-xl border border-slate-300 bg-white hover:bg-blue-700 hover:text-white hover:border-blue-700 text-slate-700 flex items-center justify-center transition shadow-sm cursor-pointer font-bold text-sm"
                >
                  &#10095;
                </button>
              </div>
              <a href="/danh-muc/xe-bon-cho-cam" class="text-blue-700 hover:text-blue-800 font-bold text-sm flex items-center gap-1 ml-1">
                Xem tất cả ({feedTrucks.length}) &rarr;
              </a>
            </div>
          </div>

          <div
            id="feedTruckCarousel"
            class="flex gap-6 overflow-x-auto no-scrollbar pb-2"
          >
            {feedTrucks.map((vehicle: any) => (
              <div class="shrink-0 w-[86%] sm:w-[calc(50%-12px)] md:w-[calc(33.333%-16px)] lg:w-[calc(25%-18px)] min-w-[260px] bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden flex flex-col justify-between hover:shadow-md hover:border-blue-400 transition group">
                <div>
                  <div class="relative overflow-hidden bg-slate-100 h-48">
                    <span class="absolute top-3 left-3 bg-red-600 text-white text-[11px] font-extrabold px-2.5 py-1 rounded-md shadow-sm z-10 flex items-center gap-1">⭐ Sản Phẩm Thế Mạnh</span>
                    <a href={`/san-pham/${vehicle.slug}`} class="block w-full h-full">
                      <img src={vehicle.images?.[0] || '/Logo.png'} alt={vehicle.name} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                    </a>
                    {itemHasVideo(vehicle) && (
                      <span class="absolute bottom-2 right-2 bg-red-600 text-white text-[11px] font-bold px-2.5 py-1 rounded-md shadow-md flex items-center gap-1 z-10 pointer-events-none">🎬 Có Video</span>
                    )}
                  </div>
                  <div class="p-4 space-y-2">
                    <span class="text-xs font-bold text-slate-500 uppercase">{vehicle.brand}</span>
                    {getCardSpecBadges(vehicle).length > 0 && (
                      <div class="flex flex-wrap gap-1.5 mb-2">
                        {getCardSpecBadges(vehicle).map((badge: string) => (
                          <span class="inline-flex items-center bg-slate-100 text-slate-700 border border-slate-200 text-[11px] font-bold px-2 py-0.5 rounded-md">
                            {badge}
                          </span>
                        ))}
                      </div>
                    )}
                    <h3 class="font-bold text-base text-slate-900 break-words leading-snug group-hover:text-blue-700 transition">
                      <a href={`/san-pham/${vehicle.slug}`}>{vehicle.name}</a>
                    </h3>
                    <p class="text-xs text-slate-600 font-medium bg-slate-50 p-2 rounded-xl break-words leading-relaxed border border-slate-200/60">
                      {vehicle.specialSpecs ? Object.values(vehicle.specialSpecs)[0] : 'Đóng mới chuẩn cục Đăng kiểm'}
                    </p>
                  </div>
                </div>
                <div class="p-4 pt-0 mt-auto space-y-3">
                  <div class="bg-red-50/70 border border-red-100 rounded-xl p-2.5">
                    <p class="text-[11px] font-bold text-slate-600 uppercase tracking-wide">
                      💳 Vốn đối ứng nhận xe :
                    </p>
                    <p class="text-red-600 font-black text-base sm:text-lg leading-snug break-words">
                      {vehicle.price && Number(vehicle.price) > 0
                        ? `Trả trước chỉ từ ~${Math.round((Number(vehicle.price) * 0.2) / 1000000).toLocaleString('vi-VN')} Triệu`
                        : 'Trả trước chỉ từ 20% giá xe'}
                    </p>
                    <p class="text-[11px] font-semibold text-blue-700 mt-0.5">
                      🔒 Báo giá chi tiết: Nhắn Zalo / Email
                    </p>
                  </div>
                  <a href={`/san-pham/${vehicle.slug}`} class="block w-full bg-blue-700 hover:bg-blue-800 text-white font-bold py-2.5 rounded-xl text-center transition text-sm shadow-sm">
                    Xem thông số &amp; Báo giá
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- HÀNG 2: CÁC DÒNG XE CHUYÊN DÙNG KHÁC -->
      {otherVehicles.length > 0 && (
        <div>
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end mb-5 border-b border-slate-200 pb-3.5 gap-3">
            <div>
              <span class="text-blue-700 font-bold text-xs uppercase tracking-wider">Sản Phẩm Nổi Bật</span>
              <h2 class="text-xl md:text-2xl font-extrabold text-slate-900 mt-0.5">Xe Cứu Hộ, Xe Cẩu &amp; Chuyên Dùng Khác</h2>
            </div>
            <div class="flex items-center gap-3 self-end sm:self-auto">
              <div class="flex items-center gap-1.5">
                <button
                  type="button"
                  id="btnPrevOther"
                  aria-label="Xe chuyên dùng trước"
                  class="w-9 h-9 rounded-xl border border-slate-300 bg-white hover:bg-blue-700 hover:text-white hover:border-blue-700 text-slate-700 flex items-center justify-center transition shadow-sm cursor-pointer font-bold text-sm"
                >
                  &#10094;
                </button>
                <button
                  type="button"
                  id="btnNextOther"
                  aria-label="Xe chuyên dùng tiếp theo"
                  class="w-9 h-9 rounded-xl border border-slate-300 bg-white hover:bg-blue-700 hover:text-white hover:border-blue-700 text-slate-700 flex items-center justify-center transition shadow-sm cursor-pointer font-bold text-sm"
                >
                  &#10095;
                </button>
              </div>
              <a href="/san-pham" class="text-blue-700 hover:text-blue-800 font-bold text-sm flex items-center gap-1 ml-1">
                Xem tất cả ({vehicleList.length}) &rarr;
              </a>
            </div>
          </div>

          <div
            id="otherVehicleCarousel"
            class="flex gap-6 overflow-x-auto no-scrollbar pb-2"
          >
            {otherVehicles.map((vehicle: any) => (
              <div class="shrink-0 w-[86%] sm:w-[calc(50%-12px)] md:w-[calc(33.333%-16px)] lg:w-[calc(25%-18px)] min-w-[260px] bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden flex flex-col justify-between hover:shadow-md hover:border-blue-400 transition group">
                <div>
                  <div class="relative overflow-hidden bg-slate-100 h-48">
                    <span class="absolute top-3 left-3 bg-red-600 text-white text-[11px] font-extrabold px-2.5 py-1 rounded-md shadow-sm z-10 flex items-center gap-1">🔥 Sản Phẩm Nổi Bật</span>
                    <a href={`/san-pham/${vehicle.slug}`} class="block w-full h-full">
                      <img src={vehicle.images?.[0] || '/Logo.png'} alt={vehicle.name} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                    </a>
                    {itemHasVideo(vehicle) && (
                      <span class="absolute bottom-2 right-2 bg-red-600 text-white text-[11px] font-bold px-2.5 py-1 rounded-md shadow-md flex items-center gap-1 z-10 pointer-events-none">🎬 Có Video</span>
                    )}
                  </div>
                  <div class="p-4 space-y-2">
                    <span class="text-xs font-bold text-slate-500 uppercase">{vehicle.brand}</span>
                    {getCardSpecBadges(vehicle).length > 0 && (
                      <div class="flex flex-wrap gap-1.5 mb-2">
                        {getCardSpecBadges(vehicle).map((badge: string) => (
                          <span class="inline-flex items-center bg-slate-100 text-slate-700 border border-slate-200 text-[11px] font-bold px-2 py-0.5 rounded-md">
                            {badge}
