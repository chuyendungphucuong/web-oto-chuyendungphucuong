    <script is:inline>
      (function() {
        const btnOpen = document.getElementById('btnOpenTechPdfModal');
        const btnClose = document.getElementById('btnCloseTechModal');
        const modal = document.getElementById('techProposalModal');
        const btnPrintAction = document.getElementById('btnPrintTechSheetAction');
        const inputCustName = document.getElementById('inputTechCustomerName');
        const previewCustLine = document.getElementById('previewTechCustLine');
        const printTechCustomerLine = document.getElementById('printTechCustomerLine');
        const printTechDate = document.getElementById('printTechDate');

        btnOpen?.addEventListener('click', () => {
          modal?.classList.remove('hidden');
        });
        btnClose?.addEventListener('click', () => {
          modal?.classList.add('hidden');
        });
        modal?.addEventListener('click', (e) => {
          if (e.target === modal) modal.classList.add('hidden');
        });

        inputCustName?.addEventListener('input', () => {
          const val = (inputCustName.value || '').trim();
          if (val) {
            if (previewCustLine) {
              previewCustLine.innerText = 'Kính gửi: ' + val;
              previewCustLine.classList.remove('hidden');
            }
            if (printTechCustomerLine) {
              printTechCustomerLine.innerText = 'Kính gửi: ' + val;
              printTechCustomerLine.classList.remove('hidden');
            }
          } else {
            previewCustLine?.classList.add('hidden');
            printTechCustomerLine?.classList.add('hidden');
          }
        });

        btnPrintAction?.addEventListener('click', () => {
          const now = new Date();
          const day = String(now.getDate()).padStart(2, '0');
          const month = String(now.getMonth() + 1).padStart(2, '0');
          const year = now.getFullYear();
          if (printTechDate) {
            printTechDate.innerText = 'Ngày xuất hồ sơ: ' + day + '/' + month + '/' + year;
          }
          window.print();
        });
      })();
    </script>
  
  </main>

  <script is:inline define:vars={{ rawImages: images, basePrice: vehicle.price || 0, roadTax: dynamicRoadTax, insurance: dynamicInsuranceTNDS, otherFixed: fixedServiceAndPlate }}>
    let currentImgIdx = 0;
    const imagesList = Array.isArray(rawImages) ? rawImages : [];

    function updateMainImage(idx) {
      if (imagesList.length === 0) return;
      if (idx < 0) currentImgIdx = imagesList.length - 1;
      else if (idx >= imagesList.length) currentImgIdx = 0;
      else currentImgIdx = idx;

      const mainImg = document.getElementById('mainProductImg');
      if (mainImg) mainImg.src = imagesList[currentImgIdx];

      document.querySelectorAll('.thumb-btn').forEach((btn, bIdx) => {
        if (bIdx === currentImgIdx) {
          btn.className = 'thumb-btn overflow-hidden rounded-lg border-2 bg-gray-50 h-16 cursor-pointer transition border-blue-600 ring-2 ring-blue-600/20';
        } else {
          btn.className = 'thumb-btn overflow-hidden rounded-lg border-2 bg-gray-50 h-16 cursor-pointer transition border-gray-200 hover:border-blue-600';
        }
      });
    }

    document.getElementById('btnPrevImg')?.addEventListener('click', () => {
      updateMainImage(currentImgIdx - 1);
    });

    document.getElementById('btnNextImg')?.addEventListener('click', () => {
      updateMainImage(currentImgIdx + 1);
    });

    document.querySelectorAll('.thumb-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt(e.currentTarget.getAttribute('data-index') || '0');
        updateMainImage(idx);
      });
    });

    function calculateRollout() {
      const fixedFees = roadTax + insurance + otherFixed;
      const regFee = basePrice * 0.02;
      const total = basePrice + regFee + fixedFees;

      const elReg = document.getElementById('lblRegistration');
      const elTotal = document.getElementById('lblTotalRollout');
      const elRatio = document.getElementById('selectLoanRatio');
      const elTerm = document.getElementById('selectLoanTerm');

      if (elReg) elReg.innerText = regFee.toLocaleString('vi-VN') + ' đ';
      if (elTotal) elTotal.innerText = total.toLocaleString('vi-VN') + ' đ';

      const ratio = elRatio ? parseFloat(elRatio.value) : 0.75;
      const months = elTerm ? parseInt(elTerm.value) : 60;

      const loanAmount = Math.round(basePrice * ratio);
      const downPayment = total - loanAmount;

      const monthlyInterestRate = 0.095 / 12;
      const monthlyPrincipal = loanAmount / months;
      const monthlyInterest = loanAmount * monthlyInterestRate;
      const monthlyPayment = monthlyPrincipal + monthlyInterest;

      const elDown = document.getElementById('lblDownPayment');
      const elLoan = document.getElementById('lblLoanAmount');
      const elMonthly = document.getElementById('lblMonthlyPayment');

      if (elDown) elDown.innerText = downPayment.toLocaleString('vi-VN') + ' đ';
      if (elLoan) elLoan.innerText = loanAmount.toLocaleString('vi-VN') + ' đ';
      if (elMonthly) elMonthly.innerText = Math.round(monthlyPayment).toLocaleString('vi-VN') + ' đ / tháng';
    }

    document.getElementById('selectLoanRatio')?.addEventListener('change', calculateRollout);
    document.getElementById('selectLoanTerm')?.addEventListener('change', calculateRollout);
    calculateRollout();

    // Điều khiển Popup Báo Giá Nhanh & Form Dự Toán Lăn Bánh
    const quickModal = document.getElementById('quickQuoteModal');
    document.getElementById('btnOpenQuickQuote')?.addEventListener('click', () => {
      quickModal?.classList.remove('hidden');
    });
    document.getElementById('btnCloseQuickQuote')?.addEventListener('click', () => {
      quickModal?.classList.add('hidden');
    });
    quickModal?.addEventListener('click', (e) => {
      if (e.target === quickModal) quickModal.classList.add('hidden');
    });

    // Tự động cập nhật nội dung trường message ẩn khi khách đổi Tỷ lệ vay / Thời hạn vay
    const selectRatioEl = document.getElementById('selectLoanRatio');
    const selectTermEl = document.getElementById('selectLoanTerm');
    const inlineMsgInput = document.getElementById('inlineHiddenMessage');
    const pageCarTitle = document.querySelector('h1')?.innerText?.trim() || 'Xe chuyên dùng';

    function updateInlineMessageField() {
      if (!inlineMsgInput) return;
      const ratioTxt = selectRatioEl ? (selectRatioEl.options[selectRatioEl.selectedIndex]?.text || selectRatioEl.value) : 'Vay 80%';
      const termTxt = selectTermEl ? (selectTermEl.options[selectTermEl.selectedIndex]?.text || selectTermEl.value) : '5 Năm';
      inlineMsgInput.value = `Yêu cầu gửi Bảng Báo Giá Chi Tiết & Lịch Trả Góp mẫu xe: ${pageCarTitle} | Phương án chọn: ${ratioTxt} - Thời hạn: ${termTxt}`;
    }
    selectRatioEl?.addEventListener('change', updateInlineMessageField);
    selectTermEl?.addEventListener('change', updateInlineMessageField);
    updateInlineMessageField();

    // 1. Xử lý gửi Form Dự Toán Lăn Bánh (#inlineRolloutLeadForm) - Y hệt 100% cơ chế của quickQuoteForm
    const inlineForm = document.getElementById('inlineRolloutLeadForm');
    const btnInlineSubmit = document.getElementById('btnSubmitInlineRollout');

    async function sendInlineProductLead() {
      if (!inlineForm) return;
      if (!inlineForm.reportValidity()) return;
      updateInlineMessageField();
      if (btnInlineSubmit) {
        btnInlineSubmit.disabled = true;
        btnInlineSubmit.innerText = '⏳ Đang gửi...';
      }
      try {
        const fd = new FormData(inlineForm);
        await fetch('https://api.web3forms.com/submit', { method: 'POST', body: fd });
        window.location.href = '/cam-on';
      } catch (err) {
        window.location.href = '/cam-on';
      }
    }

    btnInlineSubmit?.addEventListener('click', sendInlineProductLead);
    inlineForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      sendInlineProductLead();
    });

    // 2. Xử lý gửi Form Popup Báo Giá Nhanh (#quickQuoteForm)
    const quickForm = document.getElementById('quickQuoteForm');
    const btnQuickSubmit = document.getElementById('btnSubmitQuickQuote');
    quickForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (btnQuickSubmit) {
        btnQuickSubmit.disabled = true;
        btnQuickSubmit.innerText = '⏳ Đang gửi...';
      }
      try {
        const fd = new FormData(quickForm);
        const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: fd });
        const data = await res.json();
        if (data.success) {
          window.location.href = '/cam-on';
        } else {
          alert('❌ Không thể gửi biểu mẫu: ' + (data.message || 'Vui lòng thử lại'));
          if (btnQuickSubmit) {
            btnQuickSubmit.disabled = false;
            btnQuickSubmit.innerText = '🚀 Gửi Yêu Cầu Ngay';
          }
        }
      } catch (err) {
        window.location.href = '/cam-on';
      }
    });
  </script>
</BaseLayout>
