---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allVehicles } from '../../data/vehicles.js';
import { FINANCIAL_CONFIG } from '../../data/config.js';

export function getStaticPaths() {
  const vehicles = Array.isArray(allVehicles) ? allVehicles : [];
  return vehicles.map((vehicle) => ({
    params: { slug: vehicle.slug },
    props: { vehicle },
  }));
}

const { slug } = Astro.params;
const vehicles = Array.isArray(allVehicles) ? allVehicles : [];
const vehicle = Astro.props?.vehicle || vehicles.find((v: any) => v.slug === slug);

if (!vehicle) {
  return Astro.redirect('/404');
}

const specs = vehicle.chassisSpecs || vehicle.chassis_specs || {};
const specialSpecs = vehicle.specialSpecs || vehicle.special_specs || {};
const faqs = Array.isArray(vehicle.faqs) ? vehicle.faqs : [];
const images = Array.isArray(vehicle.images) && vehicle.images.length > 0 
  ? vehicle.images 
  : ['/Logo.png'];
const showrooms = Array.isArray(vehicle.showrooms) ? vehicle.showrooms : ['Bình Chánh, TP.HCM', 'Nhị Quý, Tiền Giang', 'Bình Đức, An Giang'];

const cleanDescription = (vehicle.description || vehicle.summary || '')
  .replace(/&lt;/g, '<')
  .replace(/&gt;/g, '>')
  .replace(/&amp;/g, '&');

const metrics = FINANCIAL_CONFIG.extractVehicleMetrics(vehicle);
const dynamicRoadTax = FINANCIAL_CONFIG.getRoadTax(metrics.totalWeightKg, metrics.isBus, metrics.seats);
const dynamicInsuranceTNDS = FINANCIAL_CONFIG.getInsuranceTNDS(metrics.payloadKg, metrics.seats, metrics.isBus);
const fixedServiceAndPlate = FINANCIAL_CONFIG.serviceAndInspectionFee + FINANCIAL_CONFIG.plateFeeProvince;

// 1. Tạo cấu trúc Product Schema (JSON-LD) cho Google & AI Overviews
const productSchema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": vehicle.name,
  "image": images,
  "description": vehicle.summary || vehicle.name,
  "brand": {
    "@type": "Brand",
    "name": vehicle.brand || "Ô Tô Phú Cường"
  },
  "offers": {
    "@type": "Offer",
    "url": `https://phucuongauto.vn/san-pham/${vehicle.slug}`,
    "priceCurrency": "VND",
    "price": vehicle.price || 0,
    "itemCondition": "https://schema.org/NewCondition",
    "availability": "https://schema.org/InStock",
    "seller": {
      "@type": "Organization",
      "name": "Ô Tô Phú Cường - Nhà Cung Cấp Và Sản Xuất Ô Tô Chuyên Dùng"
    }
  }
};

// 2. Tạo cấu trúc FAQ Schema (JSON-LD) nếu xe có danh sách câu hỏi
const faqSchema = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f: any) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
} : null;

// === START YOUTUBE HELPER ===
function extractYouTubeId(url) {
  if (!url || typeof url !== "string") return null;
  const regExp = /(?:youtube\.com\/(?:[^\/]+\/.+\/|Spin\/|v\/|e(?:mbed)?\/|.*[?&]v=|shorts\/)|youtu\.be\/)([^"&?\/\s]{11})/i;
  const match = url.match(regExp);
  return match ? match[1] : null;
}
const ytVideoId = extractYouTubeId(vehicle?.videoUrl || vehicle?.youtubeUrl || "");
const videoSchema = ytVideoId ? {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": `Video thực tế ${vehicle?.name || "Xe chuyên dùng Phú Cường"}`,
  "description": vehicle?.summary || vehicle?.name || "Video quay thực tế tại bãi xe Ô Tô Chuyên Dùng Phú Cường",
  "thumbnailUrl": [`https://i.ytimg.com/vi/${ytVideoId}/hqdefault.jpg`],
  "uploadDate": "2026-11-01T08:00:00+07:00",
  "embedUrl": `https://www.youtube.com/embed/${ytVideoId}`
} : null;
// === END YOUTUBE HELPER ===

// === START B2B & AI OVERVIEW HELPERS ===
function buildKeyTakeaways(v, specsObj, specialObj) {
  const all = { ...(specsObj || {}), ...(specialObj || {}) };
  let payload = "";
  let totalWeight = "";
  let engine = "";
  let bodySpec = "";

  for (const [k, val] of Object.entries(all)) {
    const kl = k.toLowerCase();
    const vs = String(val).trim();
    if (!vs) continue;
    if (!payload && (kl.includes("tải trọng cho phép") || kl.includes("tải trọng chuyên chở") || kl.includes("khối lượng hàng") || kl.includes("tải trọng chở") || kl.includes("thể tích"))) {
      payload = `${k}: ${vs}`;
    }
    if (!totalWeight && (kl.includes("tổng tải") || kl.includes("khối lượng toàn bộ"))) {
      totalWeight = vs;
    }
    if (!engine && (kl.includes("động cơ") || kl.includes("công suất"))) {
      engine = vs;
    }
    if (!bodySpec && (kl.includes("kích thước lòng") || kl.includes("kích thước sàn") || kl.includes("vật liệu") || kl.includes("hệ thống chuyên dùng") || kl.includes("loại thiết bị"))) {
      bodySpec = `${k}: ${vs}`;
    }
  }

  // Tự động phân tích gợi ý hạng bằng lái dựa trên Tổng tải trọng (metrics.totalWeightKg)
  let licenseHint = "Phù hợp quy chuẩn đăng kiểm hiện hành";
  if (metrics && metrics.isBus) {
    licenseHint = metrics.seats <= 30 ? "Bằng D2 / D (theo số chỗ ngồi đăng kiểm)" : "Bằng D (xe khách trên 30 chỗ)";
  } else if (metrics && metrics.totalWeightKg > 0) {
    if (metrics.totalWeightKg <= 3500) {
      licenseHint = `Tổng tải ${totalWeight || metrics.totalWeightKg + " kg"} — Phù hợp bằng B / B2 cũ hoặc C1 mới`;
    } else if (metrics.totalWeightKg <= 7500) {
      licenseHint = `Tổng tải ${totalWeight || metrics.totalWeightKg + " kg"} — Phù hợp bằng C1 mới (3.5T - 7.5T) hoặc bằng C`;
    } else {
      licenseHint = `Tổng tải ${totalWeight || metrics.totalWeightKg + " kg"} (> 7.5 tấn) — Yêu cầu bằng lái hạng C trở lên`;
    }
  } else if (totalWeight) {
    licenseHint = `Tổng tải trọng: ${totalWeight}`;
  }

  return { payload, engine, bodySpec, licenseHint };
}

const keyTakeaways = buildKeyTakeaways(vehicle, specs, specialSpecs);

function extractShortBadge(v) {
  if (!v) return [];
  if (v.customBadges) {
    const manualList = Array.isArray(v.customBadges)
      ? v.customBadges.map(s => String(s).trim()).filter(Boolean)
      : String(v.customBadges).split(/[,|]/).map(s => s.trim()).filter(Boolean);
    if (manualList.length > 0) return manualList.slice(0, 3);
  }
  const badges = [];
  const all = { ...(v?.chassisSpecs || {}), ...(v?.specialSpecs || {}) };
  for (const [k, val] of Object.entries(all)) {
    const kl = k.toLowerCase();
    const vs = String(val);
    if (kl.includes("thể tích") || kl.includes("dung tích")) {
      const m = vs.match(/(\d+(?:[.,]\d+)?)\s*(?:khối|m3|m³)/i);
      if (m) badges.push(`🛢️ Bồn ${m[1]} Khối`);
    }
    if (kl.includes("tải trọng cho phép") || kl.includes("khối lượng hàng") || kl.includes("tải trọng chở")) {
      const kgM = vs.match(/(\d{1,2}\.\d{3}|\d{3,5})\s*kg/i);
      if (kgM) {
        const ton = (parseFloat(kgM[1].replace(".", "")) / 1000).toFixed(2).replace(/\.?0+$/, "");
        badges.push(`⚖️ Tải ${ton} Tấn`);
      } else {
        const tM = vs.match(/(\d+(?:[.,]\d+)?)\s*tấn/i);
        if (tM) badges.push(`⚖️ Tải ${tM[1]} Tấn`);
      }
    }
  }
  if (badges.length === 0 && v?.name) {
    const mVol = v.name.match(/(\d+(?:[.,]\d+)?)\s*(?:khối|m3|m³)/i);
    if (mVol) badges.push(`🛢️ ${mVol[1]} Khối`);
    const mTon = v.name.match(/(\d+(?:[.,]\d+)?)\s*(?:tấn|tan|t\b)/i);
    if (mTon) badges.push(`⚖️ ${mTon[1]} Tấn`);
  }
  if (v?.brand) badges.push(`🏭 ${v.brand.toUpperCase()}`);
  return badges.slice(0, 2);
}

// Lọc tối đa 4 xe cùng phân khúc (ưu tiên trùng subKey hoặc subCategory)
// Lọc xe cùng phân khúc chuẩn xác (Ưu tiên tuyệt đối xe trùng subKey, sau đó đến subCategory)
  let relatedVehicles = vehicles.filter((item) => item.slug !== vehicle.slug && vehicle.subKey && item.subKey === vehicle.subKey);
  if (relatedVehicles.length < 4) {
    const backupByCat = vehicles.filter((item) => item.slug !== vehicle.slug && !relatedVehicles.includes(item) && vehicle.subCategory && item.subCategory === vehicle.subCategory);
    relatedVehicles = [...relatedVehicles, ...backupByCat];
  }
  if (relatedVehicles.length < 4) {
    const backupGeneral = vehicles.filter((item) => item.slug !== vehicle.slug && !relatedVehicles.includes(item) && item.category === (vehicle.category || "xe-tai-chuyen-dung"));
    relatedVehicles = [...relatedVehicles, ...backupGeneral];
  }
  relatedVehicles = relatedVehicles.slice(0, 4);
// === END B2B & AI OVERVIEW HELPERS ===
---

<BaseLayout title={`${vehicle.name} | Ô Tô Chuyên Dùng Phú Cường`} description={vehicle.summary || vehicle.name} image={images[0]}>
  <!-- NHÚNG MÃ JSON-LD SCHEMA ẨN CHO SEO & AI OVERVIEWS -->
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <main class="container mx-auto px-4 py-8 max-w-7xl">
    <nav class="text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-blue-600">Trang chủ</a> &gt; 
      <a href="/san-pham" class="hover:text-blue-600">Sản phẩm</a> &gt; 
      <span class="text-gray-900 font-semibold line-clamp-1">{vehicle.name}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 bg-white p-6 lg:p-8 rounded-2xl shadow-sm border border-gray-100">
      <div class="lg:col-span-6 space-y-6">
        <div class="space-y-3">
          <div class="relative overflow-hidden rounded-xl border border-gray-200 bg-gray-50 group">
            <img id="mainProductImg" src={images[0]} alt={vehicle.name} class="w-full h-[350px] object-contain p-2 transition duration-300" />
            
            {images.length > 1 && (
              <>
                <button 
                  type="button" 
                  id="btnPrevImg"
                  aria-label="Hình trước"
                  class="absolute left-2 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/70 text-white w-10 h-10 rounded-full flex items-center justify-center font-bold text-lg transition cursor-pointer shadow-md"
                >
                  &#10094;
                </button>
                <button 
                  type="button" 
                  id="btnNextImg"
                  aria-label="Hình tiếp theo"
                  class="absolute right-2 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/70 text-white w-10 h-10 rounded-full flex items-center justify-center font-bold text-lg transition cursor-pointer shadow-md"
                >
                  &#10095;
                </button>
              </>
            )}
          </div>

          {images.length > 1 && (
            <div class="grid grid-cols-5 gap-2 max-h-44 overflow-y-auto p-1">
              {images.map((imgUrl, index) => (
                <button 
                  type="button"
                  data-index={index}
                  class={`thumb-btn overflow-hidden rounded-lg border-2 bg-gray-50 h-16 cursor-pointer transition hover:border-blue-600 ${index === 0 ? 'border-blue-600 ring-2 ring-blue-600/20' : 'border-gray-200'}`}
                >
                  <img src={imgUrl} alt={`${vehicle.name} - hình ${index + 1}`} class="w-full h-full object-cover" />
                </button>
              ))}
            </div>
          )}
        </div>
        
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-sm text-blue-900">
          <p class="font-bold mb-1">📍 Hệ thống Showroom toàn quốc:</p>
          <p>{showrooms.join(' | ')}</p>
        </div>

        <!-- CÔNG CỤ TÍNH GIÁ LĂN BÁNH -->
        <div class="bg-gray-50 border border-gray-200 rounded-2xl p-5 shadow-inner">
          <div class="flex justify-between items-center mb-3">
            <h3 class="text-lg font-bold text-gray-900">
              Dự toán giá lăn bánh & Trả góp (dự kiến)
            </h3>
            <a href={`/tinh-lan-banh?car=${vehicle.slug}`} class="text-xs font-extrabold bg-blue-600 hover:bg-blue-700 text-white px-3 py-1.5 rounded-lg transition shadow-sm">
              🖨️ Xuất Báo Giá PDF &rarr;
            </a>
          </div>
          
          <div class="space-y-3 text-sm">
            <div class="flex justify-between border-b pb-2">
              <span class="text-gray-600">Giá xe tham khảo:</span>
              <span id="lblPrice" class="font-bold text-gray-900" data-price={vehicle.price}>{Number(vehicle.price || 0).toLocaleString('vi-VN')} đ</span>
            </div>
            <div class="flex justify-between border-b pb-2">
              <span class="text-gray-600">Lệ phí trước bạ (2%):</span>
              <span id="lblRegistration" class="font-semibold text-gray-800">0 đ</span>
            </div>
            <div class="flex justify-between border-b pb-2">
              <span class="text-gray-600">Phí sử dụng đường bộ (1 năm):</span>
              <span class="font-semibold text-gray-800">{Number(dynamicRoadTax).toLocaleString('vi-VN')} đ</span>
            </div>
            <div class="flex justify-between border-b pb-2">
              <span class="text-gray-600">
                {metrics.isBus ? `Bảo hiểm TNDS (${metrics.seats} chỗ):` : `BH TNDS Chuyên dùng (${(metrics.payloadKg/1000).toFixed(1)}T + ${metrics.seats} ghế):`}
              </span>
              <span class="font-semibold text-blue-700">{Number(dynamicInsuranceTNDS).toLocaleString('vi-VN')} đ</span>
            </div>
            <div class="flex justify-between border-b pb-2">
              <span class="text-gray-600">Đăng kiểm, Biển số & Dịch vụ trọn gói:</span>
              <span class="font-semibold text-gray-800">{Number(fixedServiceAndPlate).toLocaleString('vi-VN')} đ</span>
            </div>
            <div class="flex justify-between bg-blue-50 p-2.5 rounded-lg font-bold text-blue-800 text-base">
              <span>Tổng giá lăn bánh dự kiến:</span>
              <span id="lblTotalRollout">0 đ</span>
            </div>

            <div class="pt-3 border-t mt-4 space-y-3">
              <h4 class="font-bold text-gray-900">Tính toán vay mua xe trả góp:</h4>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs text-gray-600 mb-1">Tỷ lệ vay vốn:</label>
                  <select id="selectLoanRatio" class="w-full p-2 border rounded-lg text-sm bg-white font-semibold">
                    <option value="0.5">Vay 50% giá trị xe</option>
                    <option value="0.6">Vay 60% giá trị xe</option>
                    <option value="0.65">Vay 65% giá trị xe</option>
                    <option value="0.7">Vay 70% giá trị xe</option>
                    <option value="0.75" selected>Vay 75% giá trị xe</option>
                    <option value="0.8">Vay 80% giá trị xe</option>
                    <option value="0.85">Vay 85% giá trị xe</option>
                    <option value="0.9">Vay 90% giá trị xe</option>
                  </select>
                </div>
                <div>
                  <label class="block text-xs text-gray-600 mb-1">Thời hạn vay:</label>
                  <select id="selectLoanTerm" class="w-full p-2 border rounded-lg text-sm bg-white font-semibold">
                    <option value="12">1 Năm (12 tháng)</option>
                    <option value="24">2 Năm (24 tháng)</option>
                    <option value="36">3 Năm (36 tháng)</option>
                    <option value="48">4 Năm (48 tháng)</option>
                    <option value="60" selected>5 Năm (60 tháng)</option>
                    <option value="72">6 Năm (72 tháng)</option>
                    <option value="84">7 Năm (84 tháng)</option>
                  </select>
                </div>
              </div>
              <div class="bg-white p-3 rounded-xl border border-gray-200 text-xs space-y-1.5">
                <div class="flex justify-between">
                  <span class="text-gray-600">Vốn đối ứng ban đầu (Trả trước):</span>
                  <span id="lblDownPayment" class="font-bold text-blue-600">0 đ</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600">Số tiền vay ngân hàng:</span>
                  <span id="lblLoanAmount" class="font-bold text-gray-800">0 đ</span>
                </div>
                <div class="flex justify-between pt-1 border-t">
                  <span class="text-gray-600 font-semibold">Ước tính trả góp tháng đầu (Gốc + Lãi):</span>
                  <span id="lblMonthlyPayment" class="font-bold text-red-600 text-sm">0 đ</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Cột Thông tin & Báo giá -->
      <div class="lg:col-span-6 flex flex-col justify-between">
        <div>
          <span class="inline-block bg-blue-100 text-blue-800 text-xs font-extrabold px-3 py-1 rounded-full mb-3 uppercase tracking-wider">{vehicle.subCategory || vehicle.categoryName || 'Xe Chuyên Dùng'}</span>
          <h1 class="text-2xl lg:text-3xl font-extrabold text-gray-900 mb-4 leading-snug">{vehicle.name}</h1>
          
          <div class="bg-gradient-to-br from-slate-50 to-blue-50/50 p-5 rounded-2xl mb-6 border border-blue-200/80 shadow-sm space-y-3">
            {Number(vehicle.price || 0) > 0 ? (
              <>
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <span class="text-xs font-bold text-slate-600 uppercase tracking-wide">Giá tham khảo tiêu chuẩn:</span>
                  <span class="text-[11px] font-bold text-blue-700 bg-blue-100 px-2.5 py-0.5 rounded-full">Chưa trừ chiết khấu tháng này</span>
                </div>
                <p class="text-3xl lg:text-4xl font-black text-red-600 leading-none">
                  {Number(vehicle.price).toLocaleString('vi-VN')} đ
                </p>
                <div class="bg-white border border-emerald-200 rounded-xl p-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2 shadow-2xs">
                  <div>
                    <p class="text-xs font-extrabold text-emerald-800">
                      💳 Trả trước dự kiến (20%): ~{Math.round((Number(vehicle.price) * 0.2) / 1000000).toLocaleString('vi-VN')} Triệu đồng
                    </p>
                    <p class="text-[11px] text-slate-500">Hỗ trợ vay ngân hàng 75% – 85% giá trị xe, thời hạn đến 7 năm</p>
                  </div>
                  <button
                    type="button"
                    onclick="document.getElementById('btnOpenQuickQuote')?.click()"
                    class="shrink-0 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-extrabold px-3 py-2 rounded-lg transition cursor-pointer shadow-2xs"
                  >
                    Nhận bảng tính Zalo &rarr;
                  </button>
                </div>
              </>
            ) : (
              <>
                <div class="flex items-center justify-between gap-2">
                  <span class="text-xs font-bold text-slate-600 uppercase tracking-wide">Báo giá theo cấu hình đóng thùng / thiết bị:</span>
                  <span class="text-[11px] font-bold text-emerald-700 bg-emerald-100 px-2.5 py-0.5 rounded-full">Ưu đãi trực tiếp từ xưởng</span>
                </div>
                <p class="text-2xl lg:text-3xl font-black text-red-600">
                  {vehicle.priceText || "Liên hệ: 0922 77 77 03"}
                </p>
                <div class="bg-white border border-blue-200 rounded-xl p-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                  <p class="text-xs font-bold text-blue-900">
                    💳 Hỗ trợ vay trả góp 75% – 85% (Chỉ cần trả trước từ 15% – 20% nhận xe ngay)
                  </p>
                  <button
                    type="button"
                    onclick="document.getElementById('btnOpenQuickQuote')?.click()"
                    class="shrink-0 bg-blue-600 hover:bg-blue-700 text-white text-xs font-extrabold px-3 py-2 rounded-lg transition cursor-pointer"
                  >
                    Nhận báo giá Zalo &rarr;
                  </button>
                </div>
              </>
            )}
            {vehicle.promo && (
              <div class="bg-red-600 text-white p-3 text-sm rounded-xl shadow-sm">
                <span class="font-bold">🎁 Ưu đãi đặc biệt:</span> {vehicle.promo}
              </div>
            )}
          </div>
            )}
          </div>

          <div class="mb-6">
            <h3 class="font-bold text-gray-800 mb-2">Tổng quan sản phẩm:</h3>
            <p class="text-gray-600 leading-relaxed text-sm lg:text-base">{vehicle.summary}</p>
          </div>
          <!-- === START KEY TAKEAWAYS BOX === -->
          <div class="mb-6 bg-amber-50/90 border border-amber-200 rounded-xl p-4 shadow-sm">
            <div class="flex items-center gap-2 mb-2.5">
              <span class="bg-amber-400 text-slate-950 text-[11px] font-black px-2 py-0.5 rounded uppercase">⚡ Điểm Chính Cho Chủ Đầu Tư</span>
              <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wide">Tóm tắt cấu hình &amp; Pháp lý</h3>
            </div>
            <ul class="space-y-1.5 text-xs sm:text-sm text-slate-800">
              {keyTakeaways.payload && (
                <li class="flex items-start gap-2">
                  <span class="text-emerald-600 font-bold">✔</span>
                  <span><strong>Năng lực chuyên chở:</strong> {keyTakeaways.payload}</span>
                </li>
              )}
              {keyTakeaways.bodySpec && (
                <li class="flex items-start gap-2">
                  <span class="text-emerald-600 font-bold">✔</span>
                  <span><strong>Cấu hình chuyên dùng:</strong> {keyTakeaways.bodySpec}</span>
                </li>
              )}
              {keyTakeaways.engine && (
                <li class="flex items-start gap-2">
                  <span class="text-emerald-600 font-bold">✔</span>
