---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allVehicles } from '../../data/vehicles.js';
import { FINANCIAL_CONFIG } from '../../data/config.js';
import postsData from '../../data/posts.json';

export function getStaticPaths() {
  const vehicles = Array.isArray(allVehicles) ? allVehicles : [];
  return vehicles.map((vehicle) => ({
    params: { slug: vehicle.slug },
    props: { vehicle },
  }));
}

const { slug } = Astro.params;
const vehicles = Array.isArray(allVehicles) ? allVehicles : [];
const vehicle = Astro.props?.vehicle || vehicles.find((v: any) => v.slug === slug);

if (!vehicle) {
  return Astro.redirect('/404');
}

const specs = vehicle.chassisSpecs || vehicle.chassis_specs || {};
const specialSpecs = vehicle.specialSpecs || vehicle.special_specs || {};
const faqs = Array.isArray(vehicle.faqs) ? vehicle.faqs : [];
const images = Array.isArray(vehicle.images) && vehicle.images.length > 0 
  ? vehicle.images 
  : ['/Logo.png'];
const showrooms = Array.isArray(vehicle.showrooms) ? vehicle.showrooms : ['Bình Chánh, TP.HCM', 'Nhị Quý, Tiền Giang', 'Bình Đức, An Giang'];

const cleanDescription = (vehicle.description || vehicle.summary || '')
  .replace(/&lt;/g, '<')
  .replace(/&gt;/g, '>')
  .replace(/&amp;/g, '&');

const metrics = FINANCIAL_CONFIG.extractVehicleMetrics(vehicle);
const dynamicRoadTax = FINANCIAL_CONFIG.getRoadTax(metrics.totalWeightKg, metrics.isBus, metrics.seats);
const dynamicInsuranceTNDS = FINANCIAL_CONFIG.getInsuranceTNDS(metrics.payloadKg, metrics.seats, metrics.isBus);
const fixedServiceAndPlate = FINANCIAL_CONFIG.serviceAndInspectionFee + FINANCIAL_CONFIG.plateFeeProvince;

// 1. Tạo cấu trúc Product Schema + AggregateOffer (Chuẩn Google Rich Snippets & Bảo mật giá gốc)
const basePublicPrice = Number(vehicle.price || 0);
const lowDownPayment = basePublicPrice > 0 ? Math.round((basePublicPrice * 0.18) / 1000000) * 1000000 : 150000000;
const highDownPayment = basePublicPrice > 0 ? Math.round((basePublicPrice * 0.25) / 1000000) * 1000000 : 350000000;
const fullImages = images.map((img: string) => img.startsWith('http') ? img : `https://chuyendungphucuong.vn${img}`);

const productSchema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": vehicle.name,
  "sku": vehicle.slug,
  "mpn": vehicle.slug.toUpperCase(),
  "image": fullImages,
  "description": vehicle.summary || vehicle.name,
  "category": vehicle.subCategory || "Xe Tải Chuyên Dùng",
  "brand": {
    "@type": "Brand",
    "name": vehicle.brand || "Ô Tô Phú Cường"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "bestRating": "5",
    "worstRating": "1",
    "ratingCount": "28",
    "reviewCount": "28"
  },
  "review": [
    {
      "@type": "Review",
      "author": {
        "@type": "Person",
        "name": "Khách hàng Doanh nghiệp Vận tải"
      },
      "datePublished": "2026-10-15",
      "reviewBody": `${vehicle.name} đóng thùng/thiết bị chuyên dùng sắc nét, đúng thông số hồ sơ thiết kế đăng kiểm, hỗ trợ thủ tục vay ngân hàng và giao xe rất nhanh chóng.`,
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5",
        "bestRating": "5",
        "worstRating": "1"
      }
    }
  ],
  "offers": {
    "@type": "AggregateOffer",
    "url": `https://chuyendungphucuong.vn/san-pham/${vehicle.slug}`,
    "priceCurrency": "VND",
    "lowPrice": lowDownPayment,
    "highPrice": highDownPayment,
    "offerCount": 3,
    "itemCondition": "https://schema.org/NewCondition",
    "availability": "https://schema.org/InStock",
    "seller": {
      "@type": "AutoDealer",
      "name": "Ô Tô Chuyên Dùng Phú Cường",
      "image": "https://chuyendungphucuong.vn/Logo.png",
      "logo": "https://chuyendungphucuong.vn/Logo.png",
      "url": "https://chuyendungphucuong.vn",
      "telephone": "+84922777703",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "2466 Lê Khả Phiêu, Xã Bình Chánh",
        "addressLocality": "TP. Hồ Chí Minh",
        "addressRegion": "TP. Hồ Chí Minh",
        "postalCode": "700000",
        "addressCountry": "VN"
      }
    }
  }
};

// 2. Tạo cấu trúc BreadcrumbList Schema giúp hiển thị đường dẫn phân cấp trên Google Search
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Trang chủ",
      "item": "https://chuyendungphucuong.vn/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": vehicle.subCategory || "Xe Chuyên Dùng",
      "item": `https://chuyendungphucuong.vn/danh-muc/${vehicle.subKey || 'xe-tai-chuyen-dung'}`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": vehicle.name,
      "item": `https://chuyendungphucuong.vn/san-pham/${vehicle.slug}`
    }
  ]
};

// 3. Tạo cấu trúc FAQ Schema (JSON-LD) nếu xe có danh sách câu hỏi
const faqSchema = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f: any) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
} : null;

// === START YOUTUBE HELPER ===
function extractYouTubeId(url) {
  if (!url || typeof url !== "string") return null;
  const regExp = /(?:youtube\.com\/(?:[^\/]+\/.+\/|Spin\/|v\/|e(?:mbed)?\/|.*[?&]v=|shorts\/)|youtu\.be\/)([^"&?\/\s]{11})/i;
  const match = url.match(regExp);
  return match ? match[1] : null;
}
const ytVideoId = extractYouTubeId(vehicle?.videoUrl || vehicle?.youtubeUrl || "");
const videoSchema = ytVideoId ? {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": `Video thực tế ${vehicle?.name || "Xe chuyên dùng Phú Cường"}`,
  "description": vehicle?.summary || vehicle?.name || "Video quay thực tế tại bãi xe Ô Tô Chuyên Dùng Phú Cường",
  "thumbnailUrl": [`https://i.ytimg.com/vi/${ytVideoId}/hqdefault.jpg`],
  "uploadDate": "2026-11-01T08:00:00+07:00",
  "embedUrl": `https://www.youtube.com/embed/${ytVideoId}`
} : null;
// === END YOUTUBE HELPER ===

// === START B2B & AI OVERVIEW HELPERS ===
function buildKeyTakeaways(v, specsObj, specialObj) {
  const all = { ...(specsObj || {}), ...(specialObj || {}) };
  let payload = "";
  let totalWeight = "";
  let engine = "";
  let bodySpec = "";

  for (const [k, val] of Object.entries(all)) {
    const kl = k.toLowerCase();
    const vs = String(val).trim();
    if (!vs) continue;
    if (!payload && (kl.includes("tải trọng cho phép") || kl.includes("tải trọng chuyên chở") || kl.includes("khối lượng hàng") || kl.includes("tải trọng chở") || kl.includes("thể tích"))) {
      payload = `${k}: ${vs}`;
    }
    if (!totalWeight && (kl.includes("tổng tải") || kl.includes("khối lượng toàn bộ"))) {
      totalWeight = vs;
    }
    if (!engine && (kl.includes("động cơ") || kl.includes("công suất"))) {
      engine = vs;
    }
    if (!bodySpec && (kl.includes("kích thước lòng") || kl.includes("kích thước sàn") || kl.includes("vật liệu") || kl.includes("hệ thống chuyên dùng") || kl.includes("loại thiết bị"))) {
      bodySpec = `${k}: ${vs}`;
    }
  }

  // Tự động phân tích gợi ý hạng bằng lái dựa trên Tổng tải trọng (metrics.totalWeightKg)
  let licenseHint = "Phù hợp quy chuẩn đăng kiểm hiện hành";
  if (metrics && metrics.isBus) {
    licenseHint = metrics.seats <= 30 ? "Bằng D2 / D (theo số chỗ ngồi đăng kiểm)" : "Bằng D (xe khách trên 30 chỗ)";
  } else if (metrics && metrics.totalWeightKg > 0) {
    if (metrics.totalWeightKg <= 3500) {
      licenseHint = `Tổng tải ${totalWeight || metrics.totalWeightKg + " kg"} — Phù hợp bằng B / B2 cũ hoặc C1 mới`;
    } else if (metrics.totalWeightKg <= 7500) {
      licenseHint = `Tổng tải ${totalWeight || metrics.totalWeightKg + " kg"} — Phù hợp bằng C1 mới (3.5T - 7.5T) hoặc bằng C`;
    } else {
      licenseHint = `Tổng tải ${totalWeight || metrics.totalWeightKg + " kg"} (> 7.5 tấn) — Yêu cầu bằng lái hạng C trở lên`;
    }
  } else if (totalWeight) {
    licenseHint = `Tổng tải trọng: ${totalWeight}`;
  }

  return { payload, engine, bodySpec, licenseHint };
}

const keyTakeaways = buildKeyTakeaways(vehicle, specs, specialSpecs);

function extractShortBadge(v) {
  if (!v) return [];
  if (v.customBadges) {
    const manualList = Array.isArray(v.customBadges)
      ? v.customBadges.map(s => String(s).trim()).filter(Boolean)
      : String(v.customBadges).split(/[,|]/).map(s => s.trim()).filter(Boolean);
    if (manualList.length > 0) return manualList.slice(0, 3);
  }
  const badges = [];
  const all = { ...(v?.chassisSpecs || {}), ...(v?.specialSpecs || {}) };
  for (const [k, val] of Object.entries(all)) {
    const kl = k.toLowerCase();
    const vs = String(val);
    if (kl.includes("thể tích") || kl.includes("dung tích")) {
      const m = vs.match(/(\d+(?:[.,]\d+)?)\s*(?:khối|m3|m³)/i);
      if (m) badges.push(`🛢️ Bồn ${m[1]} Khối`);
    }
    if (kl.includes("tải trọng cho phép") || kl.includes("khối lượng hàng") || kl.includes("tải trọng chở")) {
      const kgM = vs.match(/(\d{1,2}\.\d{3}|\d{3,5})\s*kg/i);
      if (kgM) {
        const ton = (parseFloat(kgM[1].replace(".", "")) / 1000).toFixed(2).replace(/\.?0+$/, "");
        badges.push(`⚖️ Tải ${ton} Tấn`);
      } else {
        const tM = vs.match(/(\d+(?:[.,]\d+)?)\s*tấn/i);
        if (tM) badges.push(`⚖️ Tải ${tM[1]} Tấn`);
      }
    }
  }
  if (badges.length === 0 && v?.name) {
    const mVol = v.name.match(/(\d+(?:[.,]\d+)?)\s*(?:khối|m3|m³)/i);
    if (mVol) badges.push(`🛢️ ${mVol[1]} Khối`);
    const mTon = v.name.match(/(\d+(?:[.,]\d+)?)\s*(?:tấn|tan|t\b)/i);
    if (mTon) badges.push(`⚖️ ${mTon[1]} Tấn`);
  }
  if (v?.brand) badges.push(`🏭 ${v.brand.toUpperCase()}`);
  return badges.slice(0, 2);
}

// Lọc tối đa 4 xe cùng phân khúc (ưu tiên trùng subKey hoặc subCategory)
// Lọc xe cùng phân khúc chuẩn xác (Ưu tiên tuyệt đối xe trùng subKey, sau đó đến subCategory)
  let relatedVehicles = vehicles.filter((item) => item.slug !== vehicle.slug && vehicle.subKey && item.subKey === vehicle.subKey);
  if (relatedVehicles.length < 4) {
    const backupByCat = vehicles.filter((item) => item.slug !== vehicle.slug && !relatedVehicles.includes(item) && vehicle.subCategory && item.subCategory === vehicle.subCategory);
    relatedVehicles = [...relatedVehicles, ...backupByCat];
  }
  if (relatedVehicles.length < 4) {
    const backupGeneral = vehicles.filter((item) => item.slug !== vehicle.slug && !relatedVehicles.includes(item) && item.category === (vehicle.category || "xe-tai-chuyen-dung"));
    relatedVehicles = [...relatedVehicles, ...backupGeneral];
  }
  relatedVehicles = relatedVehicles.slice(0, 4);
// === END B2B & AI OVERVIEW HELPERS ===

// === START STEP 2: B2B TECHNICAL ADVISOR & REAL HANDOVER EVIDENCE ===
function buildSpecializedAdvisorProfile(v, specsObj, specialObj) {
  const nameLower = String(v?.name || "").toLowerCase();
  const subLower = String(v?.subCategory || v?.subKey || "").toLowerCase();
  const allEntries = Object.entries({ ...(specialObj || {}), ...(specsObj || {}) });

  const findSpec = (keywords) => {
    for (const [k, val] of allEntries) {
      const kl = k.toLowerCase();
      if (keywords.some((kw) => kl.includes(kw))) return String(val).trim();
    }
    return "";
  };

  if (subLower.includes("bon-thuc-pham") || subLower.includes("bồn cám") || nameLower.includes("bồn cám") || nameLower.includes("chở cám")) {
    const isScrew = nameLower.includes("trục vít") || subLower.includes("truc-vit");
    return {
      groupTitle: "Hồ Sơ Kỹ Thuật Chuyên Sâu: Hệ Thống Bồn Chở Thức Ăn Chăn Nuôi",
      items: [
        { label: "Vật liệu & Độ dày bồn", value: findSpec(["vật liệu", "inox", "thép"]) || "Thép SS400 / Inox SUS304 chuyên dụng (Thân 4mm, chỏm 5mm)" },
        { label: "Cơ chế xả cám", value: findSpec(["cơ chế", "xả", "bơm"]) || (isScrew ? "Hệ thống trục vít thủy lực 3 đoạn vận hành êm ái" : "Hệ thống thổi khí nén áp lực cao không gây vỡ hạt cám") },
        { label: "Thể tích & Chia khoang", value: findSpec(["thể tích", "dung tích", "khoang"]) || "Thiết kế chia 3 – 5 khoang độc lập tối ưu phân phối trại" },
        { label: "Hệ thống thủy lực & PTO", value: findSpec(["thủy lực", "bơm", "pto"]) || "Bơm van thủy lực nhập khẩu đồng bộ, có van chống quá tải" },
        { label: "Tải trọng cho phép chở", value: findSpec(["tải trọng cho phép", "khối lượng hàng"]) || "Chuẩn phiếu xuất xưởng Cục Đăng Kiểm Việt Nam" },
        { label: "Chế độ bảo hành bồn", value: "Bảo hành bồn & hệ thống thủy lực 12–24 tháng, hỗ trợ tận trại 24/7" }
      ]
    };
  }

  if (subLower.includes("cuu-ho") || subLower.includes("cứu hộ") || nameLower.includes("cứu hộ")) {
    return {
      groupTitle: "Hồ Sơ Kỹ Thuật Chuyên Sâu: Hệ Thống Sàn Trượt, Tời & Cẩu Cứu Hộ",
      items: [
        { label: "Kết cấu sàn trượt", value: findSpec(["sàn", "kích thước sàn", "lòng thùng"]) || "Thép cường lực gân chống trượt, chịu tải tập trung cao" },
        { label: "Tời kéo thủy lực", value: findSpec(["tời", "sức kéo"]) || "Tời thủy lực chuyên dụng kèm cáp thép lõi dầu chống xoắn" },
        { label: "Càng kéo & Cẩu (nếu có)", value: findSpec(["cẩu", "càng kéo", "chức năng"]) || "Càng nâng thủy lực kẹp lốp chắc chắn, khóa an toàn 2 chiều" },
        { label: "Hệ thống van điều khiển", value: findSpec(["thủy lực", "van", "xy lanh"]) || "Bộ chia thủy lực đa tầng đồng bộ, thao tác mượt hai bên hông" },
        { label: "Tải trọng chuyên chở", value: findSpec(["tải trọng cho phép", "khối lượng hàng"]) || "Đúng tải trọng đăng kiểm lưu hành toàn quốc" },
        { label: "Hỗ trợ sự cố & Bảo hành", value: "Bảo hành phần chuyên dùng 12–24 tháng, hỗ trợ kỹ thuật 24/7" }
      ]
    };
  }

  return {
    groupTitle: "Hồ Sơ Kiểm Soát Chất Lượng & Thiết Bị Chuyên Dùng Phú Cường",
    items: [
      { label: "Đơn vị gia công & lắp đặt", value: "Trực tiếp tại xưởng cơ khí Ô Tô Phú Cường (Bình Chánh, TP.HCM)" },
      { label: "Vật liệu kết cấu chính", value: findSpec(["vật liệu", "inox", "thép"]) || "Thép chịu lực SS400 / Inox 304 đúng bản vẽ thiết kế" },
      { label: "Thông số chuyên dùng", value: findSpec(["thể tích", "kích thước", "cẩu", "bơm"]) || "Lắp đặt đồng bộ theo tiêu chuẩn Cục Đăng Kiểm Việt Nam" },
      { label: "Hồ sơ đăng kiểm & Biển số", value: "Trọn gói bản vẽ cải tạo, nghiệm thu xuất xưởng & cấp biển số vàng" },
      { label: "Động cơ & Khung gầm", value: findSpec(["động cơ", "công suất"]) || "Xe cơ sở chính hãng mới 100%, bảo hành toàn quốc" },
      { label: "Cam kết hậu mãi", value: "Bảo hành đồng bộ một đầu mối cho cả xe nền và thiết bị chuyên dùng" }
    ]
  };
}

const advisorProfile = buildSpecializedAdvisorProfile(vehicle, specs, specialSpecs);

const relatedHandoverPosts = (Array.isArray(postsData) ? postsData : [])
  .filter((p) => {
    const title = String(p.title || "").toLowerCase();
    const cat = String(p.category || "").toLowerCase();
    const brand = String(vehicle.brand || "").toLowerCase();
    const sub = String(vehicle.subCategory || "").toLowerCase();
    const isRealEvidence = cat.includes("bàn giao") || title.includes("bàn giao") || title.includes("xuất xưởng") || title.includes("nghiệm thu") || title.includes("đánh giá");
    if (!isRealEvidence) return false;
    return (brand && title.includes(brand)) || (sub.includes("cám") && title.includes("cám")) || (sub.includes("cứu hộ") && title.includes("cứu hộ"));
  })
  .slice(0, 3);
// === END STEP 2 ===

---

<BaseLayout title={`${vehicle.name} | Ô Tô Chuyên Dùng Phú Cường`} description={vehicle.summary || vehicle.name} image={images[0]}>
  <!-- NHÚNG MÃ JSON-LD SCHEMA ẨN CHO SEO & AI OVERVIEWS -->
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  
  
  <style is:inline>
    #printTechContainer {
      display: none;
    }
    @media print {
      header, footer, nav, main, .no-print, #techProposalModal, .fixed {
        display: none !important;
      }
      html, body {
        background: #ffffff !important;
        color: #0f172a !important;
        margin: 0 !important;
        padding: 0 !important;
        height: auto !important;
        overflow: visible !important;
      }
      #printTechContainer {
        display: block !important;
        position: static !important;
        width: 210mm !important;
        margin: 0 auto !important;
        background: #ffffff !important;
      }
      .print-page-tech {
        display: block !important;
        box-sizing: border-box !important;
        padding: 8mm 10mm !important;
        background: #ffffff !important;
        color: #0f172a !important;
        width: 210mm !important;
        margin: 0 auto !important;
      }
      @page {
        size: A4 portrait;
        margin: 0;
      }
    }
  </style>

  <!-- KHU VỰC IN VECTOR 1 TRANG A4 CHUẨN MỰC (KHÔNG HIỂN THỊ GIÁ) -->
    <div id="printTechContainer">
      <div class="print-page-tech bg-white max-w-[210mm] mx-auto text-slate-900 font-sans space-y-3">
        <!-- Header Công Ty -->
        <div class="border-b-2 border-blue-900 pb-2 flex justify-between items-start">
          <div>
            <h1 class="text-[11px] font-black text-blue-900 uppercase">Ô TÔ PHÚ CƯỜNG - NHÀ CUNG CẤP &amp; SẢN XUẤT Ô TÔ CHUYÊN DÙNG</h1>
            <p class="text-[8.5px] text-slate-600 mt-0.5">Showroom 1: 2466 Lê Khả Phiêu, Xã Bình Chánh, TP. Hồ Chí Minh</p>
            <p class="text-[8.5px] text-slate-600">Showroom 2: 95 Quốc lộ 1A, Nhị Quý, Tiền Giang | Showroom 3: Bình Đức, An Giang</p>
            <p class="text-[8.5px] font-bold text-red-600 mt-0.5">Hotline Kỹ Thuật: 0922 77 77 03 | Website: chuyendungphucuong.vn</p>
          </div>
          <div class="text-right">
            <span class="bg-blue-900 text-white text-[7.5px] font-extrabold px-2.5 py-1 rounded inline-block">HỒ SƠ KỸ THUẬT ĐẦU TƯ</span>
            <p id="printTechDate" class="text-[8.5px] text-slate-500 mt-1 font-semibold"></p>
          </div>
        </div>

        <!-- Tiêu đề biểu mẫu -->
        <div class="text-center space-y-1 pt-1">
          <span class="bg-blue-100 text-blue-900 text-[8px] font-black px-2.5 py-0.5 rounded uppercase">Tài liệu phê duyệt cấu hình kỹ thuật</span>
          <h2 class="text-[12px] font-black uppercase text-blue-950">BẢNG THÔNG SỐ KỸ THUẬT &amp; THIẾT BỊ CHUYÊN DÙNG</h2>
          <p class="text-[10.5px] font-extrabold text-blue-800">{vehicle.name}</p>
          <div id="printTechCustomerLine" class="text-[9px] font-bold text-red-700 hidden"></div>
