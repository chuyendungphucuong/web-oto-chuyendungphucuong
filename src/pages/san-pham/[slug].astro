---
import BaseLayout from '../../layouts/BaseLayout.astro';
import vehicles from '../../data/vehicles.json';

export function getStaticPaths() {
  return vehicles.map((vehicle) => ({
    params: { slug: vehicle.slug },
    props: { vehicle },
  }));
}

const { vehicle } = Astro.props;
const formatVND = (n: number) => n.toLocaleString('vi-VN') + ' đ';

// Schema kết hợp Vehicle + FAQPage giúp Google AI Overviews trích xuất trực tiếp
const combinedSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Vehicle",
    "name": vehicle.name,
    "brand": { "@type": "Brand", "name": vehicle.brand },
    "category": vehicle.categoryName,
    "image": vehicle.image,
    "offers": {
      "@type": "Offer",
      "priceCurrency": "VND",
      "price": vehicle.price,
      "availability": "https://schema.org/InStock",
      "seller": { "@type": "AutoDealer", "name": "Ô Tô Chuyên Dùng Phú Cường" }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": vehicle.faqs.map((f: { question: string; answer: string }) => ({
      "@type": "Question",
      "name": f.question,
      "acceptedAnswer": { "@type": "Answer", "text": f.answer }
    }))
  }
];
---

<BaseLayout 
  title={`${vehicle.name} - Giá Lăn Bánh & Trả Góp`}
  description={`Bảng giá lăn bánh ${vehicle.name} tại TP.HCM, Tiền Giang, An Giang. ${vehicle.promo}.`}
  schema={combinedSchema}
>
  <div class="max-w-7xl mx-auto px-4 py-8">
    <!-- Breadcrumb -->
    <nav class="text-sm text-slate-500 mb-4">
      <a href="/" class="hover:underline">Trang chủ</a> / 
      <span>{vehicle.categoryName}</span> / 
      <strong class="text-slate-800">{vehicle.name}</strong>
    </nav>

    <!-- Khối thông tin chính -->
    <div class="grid md:grid-cols-2 gap-8 bg-white p-6 rounded-xl shadow-sm border border-slate-200">
      <div>
        <img src={vehicle.image} alt={vehicle.name} class="w-full rounded-lg object-cover h-80" />
      </div>
      <div>
        <span class="bg-blue-100 text-blue-900 text-xs font-bold px-3 py-1 rounded">{vehicle.subCategory}</span>
        <h1 class="text-2xl md:text-3xl font-extrabold text-slate-900 mt-2">{vehicle.name}</h1>
        <p class="text-3xl font-extrabold text-red-600 mt-3">{formatVND(vehicle.price)}</p>
        <p class="text-xs text-slate-500 mt-1">* Giá đã bao gồm VAT, chưa bao gồm chi phí đăng ký lăn bánh.</p>

        <div class="bg-amber-50 border border-amber-200 p-4 rounded-lg mt-4">
          <p class="font-bold text-amber-900 text-sm">🔥 Ưu đãi tháng này tại Chuyên Dùng Phú Cường:</p>
          <p class="text-sm text-amber-800 mt-1">{vehicle.promo}</p>
        </div>

        <div class="mt-4 text-sm">
          <p class="font-semibold text-slate-700">📍 Xem xe & Lái thử trực tiếp tại 3 Showroom:</p>
          <div class="flex gap-2 mt-2 flex-wrap">
            {vehicle.showrooms.map((sr: string) => (
              <span class="bg-slate-100 border border-slate-300 px-3 py-1 rounded text-xs font-medium">{sr}</span>
            ))}
          </div>
        </div>

        <div class="mt-6 grid grid-cols-2 gap-3">
          <a href="tel:0900000000" data-gtm-event="click_call_detail" class="bg-red-600 hover:bg-red-700 text-white font-bold py-3 rounded-lg text-center text-sm">
            📞 Nhận Báo Giá Kín
          </a>
          <a href="https://zalo.me/0900000000" data-gtm-event="click_zalo_detail" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-lg text-center text-sm">
            💬 Gửi Catalogue Zalo
          </a>
        </div>
      </div>
    </div>

    <!-- Bảng tính Giá Lăn Bánh (Trước bạ 2%) & Trả Góp -->
    <section id="bao-gia" class="mt-10 bg-white p-6 rounded-xl shadow-sm border border-slate-200">
      <h2 class="text-xl font-extrabold text-blue-950 mb-4">
        🧮 Dự Toán Chi Phí Lăn Bánh & Trả Góp (Chuẩn Xe Thương Mại Trước Bạ 2%)
      </h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-bold text-slate-700 mb-1">Khu vực đăng ký biển số (Showroom phụ trách):</label>
            <select id="provinceSelect" class="w-full border border-slate-300 rounded-lg px-4 py-2.5">
              <option value="500000">TP. Hồ Chí Minh (Phí biển số 500.000đ)</option>
              <option value="150000">Tiền Giang & Miền Tây (Phí biển số 150.000đ)</option>
              <option value="150000">An Giang & ĐBSCL (Phí biển số 150.000đ)</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-bold text-slate-700 mb-1">Tỷ lệ vay ngân hàng / Thuê tài chính: <span id="loanPercentLabel" class="text-blue-700">75%</span></label>
            <input id="loanSlider" type="range" min="50" max="85" step="5" value="75" class="w-full" />
          </div>
        </div>

        <div class="bg-slate-50 p-5 rounded-lg border border-slate-200 space-y-2 text-sm">
          <div class="flex justify-between"><span>Giá xe niêm yết:</span> <strong>{formatVND(vehicle.price)}</strong></div>
          <div class="flex justify-between"><span>Lệ phí trước bạ (2%):</span> <strong id="taxFee"></strong></div>
          <div class="flex justify-between"><span>Phí bảo trì đường bộ (1 năm):</span> <strong>{formatVND(vehicle.roadTaxPerYear)}</strong></div>
          <div class="flex justify-between"><span>Bảo hiểm TNDS + Đăng kiểm + Phù hiệu GPS:</span> <strong id="otherFee"></strong></div>
          <hr class="my-2" />
          <div class="flex justify-between text-base font-extrabold text-red-600">
            <span>TỔNG LĂN BÁNH TẠM TÍNH:</span> <span id="totalRolling"></span>
          </div>
          <div class="flex justify-between text-base font-extrabold text-emerald-700 pt-2">
            <span>CẦN TRẢ TRƯỚC ĐỂ NHẬN XE:</span> <span id="downPayment"></span>
          </div>
        </div>
      </div>
    </section>

    <!-- Bảng Thông số kỹ thuật -->
    <section class="mt-10 grid md:grid-cols-2 gap-8">
      <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
        <h2 class="text-lg font-extrabold text-blue-950 mb-4">1. Thông Số Xe Cơ Sở (Chassis)</h2>
        <table class="w-full text-sm">
          <tbody>
            {Object.entries(vehicle.chassisSpecs).map(([key, val]) => (
              <tr class="border-b border-slate-100">
                <th class="py-2.5 text-left text-slate-600 font-medium w-1/2">{key}</th>
                <td class="py-2.5 text-right font-semibold text-slate-900">{val}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
        <h2 class="text-lg font-extrabold text-red-700 mb-4">2. Thông Số Thiết Bị Chuyên Dùng</h2>
        <table class="w-full text-sm">
          <tbody>
            {Object.entries(vehicle.specialSpecs).map(([key, val]) => (
              <tr class="border-b border-slate-100">
                <th class="py-2.5 text-left text-slate-600 font-medium w-1/2">{key}</th>
                <td class="py-2.5 text-right font-semibold text-slate-900">{val}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Câu hỏi thường gặp (FAQ) -->
    <section class="mt-10 bg-white p-6 rounded-xl shadow-sm border border-slate-200">
      <h2 class="text-xl font-extrabold text-blue-950 mb-4">Câu Hỏi Thường Gặp Về {vehicle.name}</h2>
      <div class="space-y-4">
        {vehicle.faqs.map((faq: { question: string; answer: string }) => (
          <div class="border-b border-slate-100 pb-4">
            <h3 class="font-bold text-slate-900">❓ {faq.question}</h3>
            <p class="text-slate-600 text-sm mt-1 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>
  </div>

  <script define:vars={{ basePrice: vehicle.price, roadTax: vehicle.roadTaxPerYear, ins: vehicle.insuranceTNDS }}>
    const provinceSelect = document.getElementById('provinceSelect');
    const loanSlider = document.getElementById('loanSlider');
    const loanPercentLabel = document.getElementById('loanPercentLabel');
    const taxFeeEl = document.getElementById('taxFee');
    const otherFeeEl = document.getElementById('otherFee');
    const totalRollingEl = document.getElementById('totalRolling');
    const downPaymentEl = document.getElementById('downPayment');

    const fmt = (n) => Math.round(n).toLocaleString('vi-VN') + ' đ';

    function calculate() {
      const plateFee = Number(provinceSelect.value);
      const loanRatio = Number(loanSlider.value) / 100;
      loanPercentLabel.textContent = loanSlider.value + '%';

      const registrationTax = basePrice * 0.02; // 2% trước bạ
      const gpsAndInspection = 3500000;
      const otherFees = ins + plateFee + gpsAndInspection;
      const totalRolling = basePrice + registrationTax + roadTax + otherFees;
      const loanAmount = basePrice * loanRatio;
      const downPayment = totalRolling - loanAmount;

      taxFeeEl.textContent = fmt(registrationTax);
      otherFeeEl.textContent = fmt(otherFees);
      totalRollingEl.textContent = fmt(totalRolling);
      downPaymentEl.textContent = fmt(downPayment);
    }

    provinceSelect.addEventListener('change', calculate);
    loanSlider.addEventListener('input', calculate);
    calculate();
  </script>
</BaseLayout>
