<script is:inline>
  function initInlineYouTubeEmbeds() {
    // 1. Kích hoạt click phát video cho mọi khung .yt-facade
    document.addEventListener("click", function (e) {
      const facade = e.target.closest && e.target.closest(".yt-facade");
      if (!facade || facade.dataset.loaded === "1") return;
      const vid = facade.getAttribute("data-yt-id");
      if (!vid) return;
      facade.dataset.loaded = "1";
      facade.innerHTML = `<iframe class="w-full h-full border-0" src="https://www.youtube.com/embed/${vid}?autoplay=1&rel=0" title="YouTube video player" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>`;
    });

    function getYtId(url) {
      if (!url || typeof url !== "string") return null;
      const m = url.match(/(?:youtube\.com\/(?:[^\/]+\/.+\/|v\/|e(?:mbed)?\/|.*[?&]v=|shorts\/)|youtu\.be\/)([^"&?\/\s]{11})/i);
      return m ? m[1] : null;
    }

    function buildFacadeElement(vid) {
      const pageHeading = document.querySelector("h1")?.textContent?.trim() || "Video Thực Tế Ô Tô Chuyên Dùng Phú Cường";
      const wrap = document.createElement("div");
      wrap.className = "my-6 not-prose";
      wrap.innerHTML = `
        <div class="yt-facade relative w-full overflow-hidden rounded-2xl bg-black aspect-video cursor-pointer group border border-slate-700 shadow-xl" data-yt-id="${vid}" title="Bấm để xem video">
          <img src="https://i.ytimg.com/vi/${vid}/hqdefault.jpg" alt="YouTube Video" loading="lazy" class="w-full h-full object-cover opacity-90 group-hover:scale-105 group-hover:opacity-100 transition-all duration-300" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-black/60"></div>

          <div class="absolute top-3 left-3 right-3 flex flex-wrap items-center justify-between gap-2 z-10 pointer-events-none">
            <div class="flex items-center gap-2 bg-slate-950/85 backdrop-blur-sm border border-white/15 px-3 py-1.5 rounded-lg shadow-md">
              <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-pulse"></span>
              <span class="text-[11px] sm:text-xs font-extrabold text-white tracking-wider uppercase">Ô TÔ CHUYÊN DÙNG PHÚ CƯỜNG</span>
            </div>
            <div class="bg-red-600/95 text-white text-[11px] sm:text-xs font-black px-3 py-1.5 rounded-lg shadow-md border border-red-400/40">
              📞 Hotline/Zalo: 0922 77 77 03
            </div>
          </div>

          <button type="button" aria-label="Phát video" class="absolute inset-0 m-auto w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-red-600 group-hover:bg-red-500 text-white flex items-center justify-center shadow-2xl group-hover:scale-110 transition-transform duration-200 z-10 ring-4 ring-white/25">
            <svg class="w-8 h-8 sm:w-10 sm:h-10 ml-1 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
          </button>

          <div class="absolute bottom-3 left-3.5 right-3.5 flex flex-col sm:flex-row sm:items-end justify-between gap-2 z-10 pointer-events-none">
            <div class="space-y-0.5 max-w-xl">
              <p class="text-white font-extrabold text-xs sm:text-sm line-clamp-1 drop-shadow">${pageHeading}</p>
              <p class="text-amber-300 font-bold text-[11px] sm:text-xs">Quay thực tế tại xưởng &amp; bãi xe Phú Cường • Hỗ trợ trả góp 85%</p>
            </div>
            <div class="flex items-center gap-1.5 shrink-0">
              <span class="text-[11px] text-slate-200 font-medium hidden sm:inline">🎬 Bấm để xem</span>
              <span class="bg-red-600 px-2.5 py-0.5 rounded text-white text-[11px] font-extrabold shadow">YouTube HD</span>
            </div>
          </div>
        </div>
      `;
      return wrap;
    }

    // 2. Quét trong vùng bài viết / mô tả (.prose) để biến link YouTube thành khung Video
    document.querySelectorAll(".prose a[href*='youtube.com'], .prose a[href*='youtu.be']").forEach(a => {
      const vid = getYtId(a.getAttribute("href"));
      if (!vid || a.dataset.ytProcessed === "1") return;
      a.dataset.ytProcessed = "1";

      const parentP = a.closest("p");
      // Nếu thẻ <p> chỉ chứa đường link YouTube (hoặc người dùng chèn link đứng riêng 1 dòng) -> Thay hẳn bằng khung phát Video
      if (parentP && parentP.textContent.trim() === a.textContent.trim()) {
        parentP.replaceWith(buildFacadeElement(vid));
      } else {
        // Nếu link nằm lẫn trong câu văn -> Chèn khung phát Video ngay bên dưới đoạn văn đó
        if (parentP && !parentP.dataset.hasVideoBelow) {
          parentP.dataset.hasVideoBelow = "1";
          parentP.after(buildFacadeElement(vid));
        }
      }
    });

    // 3. Trường hợp người dùng dán thẳng text URL YouTube mà không bôi đen bấm nút Link
    document.querySelectorAll(".prose p").forEach(p => {
      if (p.children.length === 0) {
        const txt = p.textContent.trim();
        if (/^https?:\/\/(?:www\.)?(?:youtube\.com|youtu\.be)\//i.test(txt)) {
          const vid = getYtId(txt);
          if (vid) p.replaceWith(buildFacadeElement(vid));
        }
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initInlineYouTubeEmbeds);
  } else {
    initInlineYouTubeEmbeds();
  }
  document.addEventListener("astro:page-load", initInlineYouTubeEmbeds);
</script>
<!-- === END INLINE YOUTUBE AUTO-EMBED === -->

</main>

  <script is:inline define:vars={{ rawImages: images, basePrice: vehicle.price || 0, roadTax: dynamicRoadTax, insurance: dynamicInsuranceTNDS, otherFixed: fixedServiceAndPlate }}>
    let currentImgIdx = 0;
    const imagesList = Array.isArray(rawImages) ? rawImages : [];

    function updateMainImage(idx) {
      if (imagesList.length === 0) return;
      if (idx < 0) currentImgIdx = imagesList.length - 1;
      else if (idx >= imagesList.length) currentImgIdx = 0;
      else currentImgIdx = idx;

      const mainImg = document.getElementById('mainProductImg');
      if (mainImg) mainImg.src = imagesList[currentImgIdx];

      document.querySelectorAll('.thumb-btn').forEach((btn, bIdx) => {
        if (bIdx === currentImgIdx) {
          btn.className = 'thumb-btn overflow-hidden rounded-lg border-2 bg-gray-50 h-16 cursor-pointer transition border-blue-600 ring-2 ring-blue-600/20';
        } else {
          btn.className = 'thumb-btn overflow-hidden rounded-lg border-2 bg-gray-50 h-16 cursor-pointer transition border-gray-200 hover:border-blue-600';
        }
      });
    }

    document.getElementById('btnPrevImg')?.addEventListener('click', () => {
      updateMainImage(currentImgIdx - 1);
    });

    document.getElementById('btnNextImg')?.addEventListener('click', () => {
      updateMainImage(currentImgIdx + 1);
    });

    document.querySelectorAll('.thumb-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt(e.currentTarget.getAttribute('data-index') || '0');
        updateMainImage(idx);
      });
    });

    function calculateRollout() {
      const fixedFees = roadTax + insurance + otherFixed;
      const regFee = basePrice * 0.02;
      const total = basePrice + regFee + fixedFees;

      const elReg = document.getElementById('lblRegistration');
      const elTotal = document.getElementById('lblTotalRollout');
      const elRatio = document.getElementById('selectLoanRatio');
      const elTerm = document.getElementById('selectLoanTerm');

      if (elReg) elReg.innerText = regFee.toLocaleString('vi-VN') + ' đ';
      if (elTotal) elTotal.innerText = total.toLocaleString('vi-VN') + ' đ';

      const ratio = elRatio ? parseFloat(elRatio.value) : 0.75;
      const months = elTerm ? parseInt(elTerm.value) : 60;

      const loanAmount = Math.round(basePrice * ratio);
      const downPayment = total - loanAmount;

      const monthlyInterestRate = 0.095 / 12;
      const monthlyPrincipal = loanAmount / months;
      const monthlyInterest = loanAmount * monthlyInterestRate;
      const monthlyPayment = monthlyPrincipal + monthlyInterest;

      const elDown = document.getElementById('lblDownPayment');
      const elLoan = document.getElementById('lblLoanAmount');
      const elMonthly = document.getElementById('lblMonthlyPayment');

      if (elDown) elDown.innerText = downPayment.toLocaleString('vi-VN') + ' đ';
      if (elLoan) elLoan.innerText = loanAmount.toLocaleString('vi-VN') + ' đ';
      if (elMonthly) elMonthly.innerText = Math.round(monthlyPayment).toLocaleString('vi-VN') + ' đ / tháng';
    }

    document.getElementById('selectLoanRatio')?.addEventListener('change', calculateRollout);
    document.getElementById('selectLoanTerm')?.addEventListener('change', calculateRollout);
    calculateRollout();

    // Điều khiển Popup Báo Giá Nhanh
    const quickModal = document.getElementById('quickQuoteModal');
    document.getElementById('btnOpenQuickQuote')?.addEventListener('click', () => {
      quickModal?.classList.remove('hidden');
    });
    document.getElementById('btnCloseQuickQuote')?.addEventListener('click', () => {
      quickModal?.classList.add('hidden');
    });
    quickModal?.addEventListener('click', (e) => {
      if (e.target === quickModal) quickModal.classList.add('hidden');
    });

    const quickForm = document.getElementById('quickQuoteForm');
    const btnQuickSubmit = document.getElementById('btnSubmitQuickQuote');
    quickForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (btnQuickSubmit) {
        btnQuickSubmit.disabled = true;
        btnQuickSubmit.innerText = '⏳ Đang gửi...';
      }
      try {
        const fd = new FormData(quickForm);
        await fetch('https://api.web3forms.com/submit', { method: 'POST', body: fd });
        window.location.href = '/cam-on';
      } catch (err) {
        window.location.href = '/cam-on';
      }
    });
  </script>
</BaseLayout>
