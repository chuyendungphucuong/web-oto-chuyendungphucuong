---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { allVehicles } from "../../data/vehicles.js";
import navData from "../../data/navigation.json";

const productList = Array.isArray(allVehicles) ? allVehicles : [];
const availableBrands = Array.from(new Set(productList.map((v: any) => String(v.brand || "").trim().toUpperCase()).filter(Boolean))).sort();

// Tự động đọc cấu trúc Menu Cha - Con từ navigation.json
const mainMenu = Array.isArray(navData?.mainMenu) ? navData.mainMenu : [];
const parentToChildrenMap: Record<string, string[]> = {};
const dynamicCategoryTitles: Record<string, string> = {
  "all": "Tất Cả Sản Phẩm Xe Chuyên Dùng, Ô Tô Khách & Xe Cũ",
  "xe-tai-chuyen-dung": "Tất Cả Các Dòng Xe Tải Chuyên Dùng",
  "xe-khach": "Tất Cả Các Dòng Ô Tô Khách (16 - 47 Chỗ)",
  "xe-cu": "Tất Cả Các Dòng Xe Cũ Chính Chủ Chất Lượng Cao"
};

function extractCatKey(urlStr: string) {
  if (!urlStr || typeof urlStr !== "string") return "";
  if (urlStr.includes("cat=")) {
    return urlStr.split("cat=")[1].split("&")[0].trim().toLowerCase();
  }
  return "";
}

mainMenu.forEach((menu: any) => {
  const parentKey = extractCatKey(menu.url);
  if (parentKey) {
    dynamicCategoryTitles[parentKey] = menu.title;
    if (!parentToChildrenMap[parentKey]) parentToChildrenMap[parentKey] = [];
  }
  if (Array.isArray(menu.children)) {
    menu.children.forEach((child: any) => {
      const childKey = extractCatKey(child.url);
      if (childKey) {
        dynamicCategoryTitles[childKey] = child.title;
        if (parentKey && childKey !== parentKey) {
          parentToChildrenMap[parentKey].push(childKey);
        }
      }
    });
  }
});

const categories = [
  { id: "all", name: "Tất cả sản phẩm" },
  { id: "xe-tai-chuyen-dung", name: "Tất cả Xe Chuyên Dùng" },
  { id: "bon-thuc-pham", name: "Xe Bồn Cám" },
  { id: "bon-nuoc", name: "Xe Bồn Nước & Hút Chất Thải" },
  { id: "xe-cau", name: "Xe Cẩu Tự Hành" },
  { id: "cuu-ho", name: "Xe Cứu Hộ & Nâng Đầu" },
  { id: "xe-khach", name: "Tất cả Ô Tô Khách" },
  { id: "xe-cu", name: "Tất cả Xe Cũ" },
  { id: "xe-4-7-cho-cu", name: "Xe 4 - 7 Chỗ Cũ" }
];

// === START PAYLOAD & VOLUME EXTRACTOR (CHUẨN ĐĂNG KIỂM) ===
function parseVietnameseNumber(rawStr) {
  if (!rawStr) return 0;
  const s = String(rawStr).trim();
  // Nếu có dạng 17.100 kg hoặc 12.770 (dấu chấm ngăn cách hàng nghìn: sau dấu chấm có đúng 3 chữ số)
  if (/^\d{1,3}(\.\d{3})+$/.test(s)) {
    return parseFloat(s.replace(/\./g, ""));
  }
  // Nếu có dấu phẩy thập phân kiểu VN: 16,5
  return parseFloat(s.replace(",", "."));
}

function getExactPayloadTons(p) {
  if (!p) return 0;
  const chassis = p.chassisSpecs || {};
  const special = p.specialSpecs || {};
  const allEntries = [...Object.entries(chassis), ...Object.entries(special)];

  // Bước 1: Quét chính xác trường Tải trọng cho phép chở / Khối lượng chuyên chở (Loại trừ Tổng tải & Tự trọng)
  for (const [k, v] of allEntries) {
    const kl = String(k).toLowerCase();
    const vs = String(v).toLowerCase();

    const isTotalOrCurb =
      kl.includes("toàn bộ") ||
      kl.includes("tổng tải") ||
      kl.includes("tổng khối lượng") ||
      kl.includes("bản thân") ||
      kl.includes("tự trọng") ||
      kl.includes("không tải");

    const isAllowedPayload =
      kl.includes("cho phép") ||
      kl.includes("chuyên chở") ||
      kl.includes("khối lượng hàng") ||
      kl.includes("tải trọng chở") ||
      kl.includes("tải trọng hàng") ||
      (kl.includes("tải trọng") && !isTotalOrCurb);

    if (isAllowedPayload && !isTotalOrCurb) {
      // Tìm số đi kèm kg
      const kgMatch = vs.match(/(\d{1,3}(?:\.\d{3})+|\d{3,6})\s*kg/i);
      if (kgMatch) {
        const kgVal = parseVietnameseNumber(kgMatch[1]);
        if (kgVal > 100) return +(kgVal / 1000).toFixed(3);
      }
      // Tìm số đi kèm tấn
      const tonMatch = vs.match(/(\d+(?:[.,]\d+)?)\s*(?:tấn|tan)/i);
      if (tonMatch) {
        return parseVietnameseNumber(tonMatch[1]);
      }
      // Nếu chỉ ghi số thuần (VD: "17.100" hoặc "17100")
      const rawNumMatch = vs.match(/(\d{1,3}(?:\.\d{3})+|\d+(?:[.,]\d+)?)/);
      if (rawNumMatch) {
        const val = parseVietnameseNumber(rawNumMatch[1]);
        return val > 100 ? +(val / 1000).toFixed(3) : val;
      }
    }
  }

  // Bước 2: Nếu xe chưa có bảng chassisSpecs, đọc từ customBadges hoặc tên xe (nhưng tránh chữ "tổng tải")
  const badgeText = Array.isArray(p.customBadges) ? p.customBadges.join(" ") : String(p.customBadges || "");
  const nameClean = (badgeText + " " + String(p.name || "")).replace(/tổng\s*tải\s*\d+(?:[.,]\d+)?\s*(?:tấn|tan|t\b)/gi, "");

  const tMatch1 = nameClean.match(/(\d+)t(\d+)/i);
  if (tMatch1) return parseFloat(tMatch1[1] + "." + tMatch1[2]);

  const tMatch2 = nameClean.match(/(?:tải\s*)?(\d+(?:[.,]\d+)?)\s*(?:tấn|tan|t\b)/i);
  if (tMatch2) return parseFloat(tMatch2[1].replace(",", "."));

  return 0;
}

function getExactVolumeM3(p) {
  if (!p) return 0;
  const chassis = p.chassisSpecs || {};
  const special = p.specialSpecs || {};
  const allEntries = [...Object.entries(special), ...Object.entries(chassis)];

  for (const [k, v] of allEntries) {
    const kl = String(k).toLowerCase();
    const vs = String(v).toLowerCase();
    // Không lấy thể tích làm việc của động cơ (cm3)
    if (kl.includes("động cơ") || kl.includes("làm việc") || vs.includes("cm³") || vs.includes("cm3") || vs.includes("cc")) continue;

    if (kl.includes("thể tích") || kl.includes("dung tích") || kl.includes("bồn") || kl.includes("xi téc")) {
      const m3Match = vs.match(/(\d+(?:[.,]\d+)?)\s*(?:khối|khoi|m3|m³)/i);
      if (m3Match) return parseVietnameseNumber(m3Match[1]);

      const litMatch = vs.match(/(\d{1,3}(?:\.\d{3})+|\d{4,6})\s*(?:lít|lit)/i);
      if (litMatch) {
        const litVal = parseVietnameseNumber(litMatch[1]);
        if (litVal >= 500) return +(litVal / 1000).toFixed(2);
      }
    }
  }

  const nameStr = String(p.name || "") + " " + (Array.isArray(p.customBadges) ? p.customBadges.join(" ") : String(p.customBadges || ""));
  const vMatch = nameStr.match(/(\d+(?:[.,]\d+)?)\s*(?:khối|khoi|m3|m³)/i);
  if (vMatch) return parseFloat(vMatch[1].replace(",", "."));

  return 0;
}
// === END PAYLOAD & VOLUME EXTRACTOR ===

// === START HAS VIDEO HELPER ===
function itemHasVideo(item) {
  if (!item) return false;
  if (item.videoUrl && String(item.videoUrl).trim() !== "") return true;
  if (item.youtubeUrl && String(item.youtubeUrl).trim() !== "") return true;
  const bodyText = String(item.description || item.content || "");
  return /(?:youtube\.com\/(?:watch\?v=|shorts\/|embed\/)|youtu\.be\/)[a-zA-Z0-9_-]{11}/i.test(bodyText);
}
// === END HAS VIDEO HELPER ===

// === START SPEC BADGE EXTRACTOR ===
function getCardSpecBadges(p) {
  if (!p) return [];
  if (p.customBadges) {
    const manualList = Array.isArray(p.customBadges)
      ? p.customBadges.map(s => String(s).trim()).filter(Boolean)
      : String(p.customBadges).split(/[,|]/).map(s => s.trim()).filter(Boolean);
    if (manualList.length > 0) return manualList.slice(0, 3);
  }
  const badges = [];
  const chassis = p.chassisSpecs || {};
  const special = p.specialSpecs || {};
  const all = [...Object.entries(chassis), ...Object.entries(special)];

  // 1. Tìm Thể tích bồn (Khối / m3) hoặc Kích thước sàn
  for (const [k, v] of all) {
    const kl = String(k).toLowerCase();
    const vs = String(v);
    if (kl.includes("thể tích") || kl.includes("dung tích")) {
      const m = vs.match(/(\d+(?:[.,]\d+)?)\s*(?:khối|khoi|m3|m³)/i);
      if (m) {
        badges.push(`🛢️ Bồn ${m[1]} Khối`);
        break;
      }
    }
  }

  // 2. Tìm Tải trọng cho phép chở (quy về Tấn gọn gàng)
  for (const [k, v] of all) {
    const kl = String(k).toLowerCase();
    const vs = String(v);
    if (kl.includes("tải trọng cho phép") || kl.includes("tải trọng chuyên chở") || kl.includes("khối lượng hàng") || kl.includes("tải trọng chở")) {
      const kgMatch = vs.match(/(\d{1,2}\.\d{3}|\d{3,5})\s*kg/i);
      if (kgMatch) {
        const ton = (parseFloat(kgMatch[1].replace(".", "")) / 1000).toFixed(2).replace(/\.?0+$/, "");
        badges.push(`⚖️ Tải ${ton} Tấn`);
        break;
      }
      const tonMatch = vs.match(/(\d+(?:[.,]\d+)?)\s*(?:tấn|tan)/i);
      if (tonMatch) {
        badges.push(`⚖️ Tải ${tonMatch[1]} Tấn`);
        break;
      }
    }
  }

  // 3. Tìm Vật liệu bồn (Inox 304 / SS400) hoặc Cơ cấu chuyên dùng (Sàn trượt / Càng kéo / Cẩu)
  for (const [k, v] of all) {
    if (badges.length >= 2) break;
    const vs = String(v);
    if (/inoxs*304/i.test(vs)) {
      badges.push("🛡️ Inox 304");
      break;
    } else if (/sàn trượt/i.test(vs) && /càng kéo/i.test(vs)) {
      badges.push("🔧 Sàn trượt + Càng kéo");
      break;
    } else if (/kích thước.*sàn|lòng thùng/i.test(String(k))) {
      const dim = vs.match(/(\d[.,]\d+|\d{4})\s*x\s*(\d[.,]\d+|\d{4})/i);
      if (dim) {
        const d1 = dim[1].length === 4 ? (parseInt(dim[1]) / 1000).toFixed(1) + "m" : dim[1] + "m";
        badges.push(`📏 Sàn dài ${d1}`);
        break;
      }
    }
  }

  // 4. Fallback đọc từ tên xe nếu xe chưa điền bảng chassisSpecs chi tiết
  const nameStr = String(p.name || "");
  if (badges.length === 0) {
    const vMatch = nameStr.match(/(\d+(?:[.,]\d+)?)\s*(?:khối|khoi|m3|m³)/i);
    if (vMatch) badges.push(`🛢️ Bồn ${vMatch[1]} Khối`);

    const tMatch1 = nameStr.match(/(\d+)t(\d+)/i);
    if (tMatch1) badges.push(`⚖️ Tải ${tMatch1[1]}.${tMatch1[2]} Tấn`);
    else {
      const tMatch2 = nameStr.match(/(\d+(?:[.,]\d+)?)\s*(?:tấn|tan|t\b)/i);
      if (tMatch2) badges.push(`⚖️ Tải ${tMatch2[1]} Tấn`);
    }

    const sMatch = nameStr.match(/(\d+)\s*chỗ/i);
    if (sMatch) badges.push(`💺 ${sMatch[1]} Chỗ ngồi`);
  }

  if (badges.length < 2) {
    if (/2 chức năng/i.test(nameStr) && !badges.some(b => b.includes("Sàn trượt"))) {
      badges.push("🔧 Sàn trượt + Càng kéo");
    } else if (/3 chức năng/i.test(nameStr)) {
      badges.push("🏗️ Cẩu + Sàn + Càng kéo");
    } else if (/trục vít/i.test(nameStr)) {
      badges.push("⚙️ Bơm trục vít");
    } else if (/cám thổi|khí nén/i.test(nameStr)) {
      badges.push("💨 Bơm khí nén");
    }
  }

  return badges.slice(0, 2);
}
// === END SPEC BADGE EXTRACTOR ===
---

<BaseLayout title="Tổng hợp danh mục xe chuyên dùng, Ô tô khách & Xe cũ | Ô Tô Phú Cường">
  <main class="container mx-auto px-4 py-8 max-w-7xl">
    <nav class="text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-blue-600">Trang chủ</a> &gt; 
      <span id="breadcrumbCurrent" class="text-gray-900 font-semibold">Tất cả sản phẩm</span>
    </nav>

    <div class="bg-blue-800 text-white p-8 rounded-2xl mb-8 shadow-md flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <h1 id="categoryTitle" class="text-2xl lg:text-4xl font-extrabold mb-2">Danh Mục Xe Chuyên Dùng, Ô Tô Khách & Xe Cũ</h1>
        <p class="text-white/90 text-sm lg:text-base">Đóng mới chất lượng cao, xe cũ chính chủ pháp lý chuẩn, hỗ trợ giao xe toàn quốc tại TP.HCM, Tiền Giang và An Giang.</p>
      </div>
      <div class="bg-white/10 px-4 py-2.5 rounded-xl border border-white/20 text-sm font-bold whitespace-nowrap">
        Hiển thị: <span id="lblCount" class="text-yellow-300 text-lg">{productList.length}</span> mẫu xe
      </div>
    </div>

    <!-- Thanh lọc danh mục ngang -->
    <div class="flex overflow-x-auto gap-2 pb-4 mb-6 no-scrollbar">
      {categories.map((cat, idx) => (
        <button 
          type="button"
          data-category={cat.id}
          class={`cat-tab px-4 py-2.5 rounded-xl font-bold text-sm whitespace-nowrap transition cursor-pointer ${idx === 0 ? "bg-blue-600 text-white shadow-md shadow-blue-600/20" : "bg-white text-gray-700 border border-gray-200 hover:bg-gray-100"}`}
        >
          {cat.name}
        </button>
      ))}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Cột Bộ lọc & Tìm kiếm bên trái -->
      <div class="lg:col-span-3 space-y-6">
        <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm space-y-3">
          <h3 class="font-bold text-gray-900 border-b pb-2 text-base">🔎 Tìm kiếm thông minh</h3>
          <div class="relative">
            <input 
              type="text" 
              id="quickSearchInput" 
              placeholder="Gõ có dấu hoặc không dấu (VD: bon cam, gac m8, carnival...)" 
              class="w-full p-2.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-600 outline-none"
            />
          </div>
          <p class="text-[11px] text-gray-400">Hỗ trợ tìm kiếm nhanh không dấu, tìm theo tải trọng, số chỗ, hãng xe.</p>
        </div>

        <!-- Lọc theo Hãng xe -->
        <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm space-y-4">
          <div class="flex justify-between items-center border-b pb-2">
            <h3 class="font-bold text-gray-900 text-base">🚛 Lọc theo Hãng xe</h3>
            <button type="button" id="btnResetFilter" class="text-xs text-blue-600 hover:underline font-semibold cursor-pointer">Đặt lại</button>
          </div>
          <div class="space-y-2 text-sm max-h-60 overflow-y-auto">
            {availableBrands.map((brand: any) => (
              <label class="flex items-center gap-2 cursor-pointer text-gray-700 hover:text-red-600">
                <input type="checkbox" value={brand} class="brand-checkbox rounded border-gray-300 accent-red-600 focus:ring-red-500 w-4 h-4 cursor-pointer" />
                <span>{brand}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Lọc theo Khoảng giá -->
        <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm space-y-4">
          <h3 class="font-bold text-gray-900 border-b pb-2 text-base">💰 Lọc theo Khoảng giá</h3>
          <div class="space-y-2 text-sm">
            {[
              { label: "Tất cả mức giá", min: 0, max: Infinity },
              { label: "Dưới 1 tỷ đồng", min: 0, max: 1000000000 },
              { label: "Từ 1 tỷ - 1.5 tỷ", min: 1000000000, max: 1500000000 },
              { label: "Từ 1.5 tỷ - 2 tỷ", min: 1500000000, max: 2000000000 },
              { label: "Từ 2 tỷ - 2.5 tỷ", min: 2000000000, max: 2500000000 },
              { label: "Trên 2.5 tỷ đồng", min: 2500000000, max: Infinity }
            ].map((range, idx) => (
              <label class="flex items-center gap-2 cursor-pointer text-gray-700 hover:text-red-600">
                <input type="radio" name="priceRange" value={idx} checked={idx === 0} class="price-radio border-gray-300 accent-red-600 focus:ring-red-500 w-4 h-4 cursor-pointer" />
                <span>{range.label}</span>
              </label>
            ))}
          </div>
        </div>
      </div>

      <!-- Cột Lưới sản phẩm bên phải -->
      <div class="lg:col-span-9">
        <div id="productGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {productList.map((product: any) => {
            const specText = product.specialSpecs ? Object.values(product.specialSpecs)[0] : (product.chassisSpecs ? Object.values(product.chassisSpecs)[0] : "Chính hãng chất lượng cao");
            const catSub = product.subCategory || product.categoryName || "Xe Chuyên Dùng";
            const subKey = (product.subKey || "").toLowerCase();
            
            // Nhận diện chính xác nhóm xe cũ vs xe khách vs xe chuyên dùng
            const isUsedCar = subKey.includes("cu") && !subKey.includes("cuu-ho") || catSub.toLowerCase().includes("cũ") || (product.name || "").toLowerCase().includes("xe cũ");
            const categoryType = isUsedCar ? "xe-cu" : (product.category || (catSub.toLowerCase().includes("khách") ? "xe-khach" : "xe-tai-chuyen-dung"));
            
            const fullSearchableText = [
              product.name,
              product.brand,
              catSub,
              product.summary,
              JSON.stringify(product.chassisSpecs || {}),
              JSON.stringify(product.specialSpecs || {})
            ].join(" ");

            const displayPrice = Number(product.price || 0) > 0
              ? Number(product.price).toLocaleString("vi-VN") + " đ"
              : (product.priceText || "Liên hệ nhận giá tốt");

            return (
              <div 
                class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden flex flex-col justify-between hover:shadow-md transition group product-card"
                data-name={product.name?.toLowerCase() || ""}
                data-search={fullSearchableText}
                data-payload={getExactPayloadTons(product)} data-volume={getExactVolumeM3(product)} data-brand={String(product.brand || "").trim().toUpperCase()}
                data-category={catSub.toLowerCase()}
                data-subkey={subKey}
                data-type={categoryType.toLowerCase()}
                data-price={product.price || 0} data-payload={getExactPayloadTons(product)} data-volume={getExactVolumeM3(product)}
              >
                <div>
                  <div class="relative overflow-hidden bg-gray-100 h-48">
                    <span class={`absolute top-3 left-3 text-white text-xs font-bold px-2.5 py-1 rounded-md z-10 ${isUsedCar ? "bg-amber-600" : "bg-blue-600"}`}>{catSub}</span>
                    <img src={product.images?.[0] || product.image || "/Logo.png"} alt={product.name} class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                  {itemHasVideo(product) && (
                    <span class="absolute bottom-2 right-2 bg-red-600/95 text-white text-[11px] font-bold px-2.5 py-1 rounded-md shadow-md flex items-center gap-1 z-10 pointer-events-none">🎬 Có Video</span>
                  )}
                  </div>
                  <div class="p-4 space-y-2">
                    <span class="text-xs font-bold text-gray-500 uppercase">{product.brand || "Phú Cường"}</span>
                    <!-- SPEC BADGES -->
                  {getCardSpecBadges(product).length > 0 && (
                    <div class="flex flex-wrap gap-1.5 mb-2">
                      {getCardSpecBadges(product).map((badge: string) => (
                        <span class="inline-flex items-center bg-slate-100 text-slate-800 border border-slate-200/80 text-[11px] font-bold px-2 py-0.5 rounded-md">
                          {badge}
                        </span>
                      ))}
                    </div>
                  )}
                  <!-- END SPEC BADGES -->
                  <h3 class="font-bold text-base text-gray-900 line-clamp-2 leading-snug group-hover:text-blue-600 transition">
                      <a href={`/san-pham/${product.slug}`}>{product.name}</a>
                    </h3>
                    <p class="text-xs text-gray-600 font-medium bg-gray-50 p-1.5 rounded line-clamp-1">{specText}</p>
                    <p class="text-red-600 font-black text-lg">{displayPrice}</p>
                    {product.promo && (
                      <p class="text-xs text-red-700 bg-red-50 p-2 rounded border border-red-100 font-medium line-clamp-1">🎁 {product.promo}</p>
                    )}
                  </div>
                </div>
                <div class="p-4 pt-0">
                  <a href={`/san-pham/${product.slug}`} class="block w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 rounded-xl text-center transition text-sm shadow-sm shadow-blue-600/20">
                    Xem thông số & Nhận ưu đãi
                  </a>
                </div>
              </div>
            );
          })}
        </div>

        <div id="emptyState" class="hidden bg-white p-12 rounded-2xl border border-gray-200 text-center space-y-3">
          <p class="text-xl font-bold text-gray-800">Không tìm thấy mẫu xe nào phù hợp với từ khóa hoặc bộ lọc</p>
          <p class="text-sm text-gray-500">Quý khách vui lòng thử gõ từ khóa ngắn gọn hơn hoặc bấm "Đặt lại" bộ lọc.</p>
        </div>
      </div>
    </div>
  </main>

  <script is:inline define:vars={{ parentToChildrenMap, dynamicCategoryTitles }}>
    const priceRanges = [
      { min: 0, max: Infinity },
      { min: 0, max: 1000000000 },
      { min: 1000000000, max: 1500000000 },
      { min: 1500000000, max: 2000000000 },
      { min: 2000000000, max: 2500000000 },
      { min: 2500000000, max: Infinity }
    ];

    const categoryTitles = {
      ...dynamicCategoryTitles,
      "all": "Tất Cả Sản Phẩm Xe Chuyên Dùng, Ô Tô Khách & Xe Cũ",
      "xe-tai-chuyen-dung": "Tất Cả Các Dòng Xe Tải Chuyên Dùng",
      "xe-khach": "Tất Cả Các Dòng Ô Tô Khách (16 - 47 Chỗ)",
      "xe-cu": "Tất Cả Các Dòng Xe Ô Tô Cũ Chính Chủ",
      "xe-4-7-cho-cu": "Xe Ô Tô 4 - 7 Chỗ Cũ Chính Chủ",
      "xe-tai-cu": "Xe Tải Cũ Đã Qua Sử Dụng",
      "xe-chuyen-dung-cu": "Xe Chuyên Dùng Cũ Đã Qua Sử Dụng",
      "xe-khach-cu": "Xe Khách Cũ Đã Qua Sử Dụng",
      "bon-thuc-pham": "Xe Bồn Cám & Thức Ăn Chăn Nuôi",
      "xe-bon-cam": "Xe Bồn Cám & Thức Ăn Chăn Nuôi",
      "bon-nuoc": "Xe Bồn Chở Nước & Hút Chất Thải",
      "xe-bon-nuoc": "Xe Bồn Chở Nước Tưới Cây",
      "bon-hut-chat-thai": "Xe Bồn Hút Chất Thải Môi Trường",
      "xe-cau": "Xe Tải Gắn Cẩu Tự Hành",
      "cuu-ho": "Xe Cứu Hộ Giao Thông & Nâng Đầu",
      "xe-cuu-ho": "Xe Cứu Hộ Giao Thông",
      "nang-dau": "Xe Nâng Đầu Chở Máy Công Trình",
      "ep-rac": "Xe Cuốn Ép Rác Môi Trường",
      "xe-nang-khac": "Đầu Kéo Gắn Cẩu & Xe Chở Gia Cầm",
      "16-cho": "Xe Khách 16 Chỗ Cao Cấp",
      "29-cho": "Xe Khách 29 - 34 Chỗ Bầu Hơi",
      "34-cho": "Xe Khách 34 Chỗ Bóng Hơi",
      "47-cho": "Xe Khách 47 Chỗ & Giường Nằm"
    };

    function normalizeText(str) {
      if (!str) return "";
      return str
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[đĐ]/g, "d")
        .replace(/huyndai/g, "hyundai")
        .replace(/xitec|xi tec/g, "bon")
        .replace(/(\d+)t\b/g, "$1 tan")
        .replace(/(\d+)c\b/g, "$1 chan")
        .replace(/[^a-z0-9\s]/g, " ")
        .replace(/\s+/g, " ")
        .trim();
    }

    function isFuzzyWordMatch(queryWord, targetWords) {
      for (const word of targetWords) {
        if (word.includes(queryWord)) return true;
        if (queryWord.length >= 4 && Math.abs(word.length - queryWord.length) <= 1) {
          let diffs = 0;
          let i = 0, j = 0;
          while (i < queryWord.length && j < word.length) {
            if (queryWord[i] !== word[j]) {
              diffs++;
              if (diffs > 1) break;
              if (queryWord.length > word.length) i++;
              else if (word.length > queryWord.length) j++;
              else { i++; j++; }
            } else {
              i++; j++;
            }
          }
          diffs += (queryWord.length - i) + (word.length - j);
          if (diffs <= 1) return true;
        }
      }
      return false;
    }

    function smartSearchMatch(rawQuery, rawTargetText) {
      if (!rawQuery) return true;
      const normQuery = normalizeText(rawQuery);
      const normTarget = normalizeText(rawTargetText);
      if (normTarget.includes(normQuery)) return true;
      const queryWords = normQuery.split(" ").filter(Boolean);
      const targetWords = normTarget.split(" ").filter(Boolean);
      return queryWords.every(qWord => isFuzzyWordMatch(qWord, targetWords));
    }

    let currentFilter = "all";
    const urlParams = new URLSearchParams(window.location.search);
    const catParam = urlParams.get("cat");
    if (catParam) {
      currentFilter = catParam.toLowerCase();
    }

    function checkCategoryMatch(filterKey, cardType, cardSubKey, cardCatName, cardTitle) {
      if (filterKey === "all") return true;

      // 1. Nếu người dùng bấm vào Menu Cha (ví dụ: "xe-cu") có chứa các nhánh con trong navigation.json
      const childKeys = parentToChildrenMap[filterKey] || [];
      if (childKeys.length > 0) {
        if (childKeys.includes(cardSubKey)) return true;
      }

      // 2. Xử lý nhóm Xe Cũ tổng hợp (hiển thị toàn bộ các nhánh con xe cũ: xe-4-7-cho-cu, xe-tai-cu, xe-chuyen-dung-cu, xe-khach-cu...)
      if (filterKey === "xe-cu") {
        return (
          cardType === "xe-cu" ||
          cardSubKey === "xe-cu" ||
          cardSubKey.endsWith("-cu") ||
          cardCatName.includes("xe cũ") ||
          cardCatName.includes("4 - 7 chỗ") ||
          cardTitle.includes("xe cũ")
        );
      }

      // 3. Nếu bấm vào từng nhánh con cụ thể của Xe Cũ (vd: xe-4-7-cho-cu, xe-tai-cu...)
      if (filterKey.endsWith("-cu")) {
        return cardSubKey === filterKey;
      }

      // 4. Nhóm Xe Tải Chuyên Dùng Mới (không trộn lẫn xe cũ)
      if (filterKey === "xe-tai-chuyen-dung") {
        return cardType === "xe-tai-chuyen-dung";
      }

      // 5. Nhóm Ô Tô Khách Mới (không trộn lẫn xe cũ)
      if (filterKey === "xe-khach") {
        return cardType === "xe-khach";
      }

      if (filterKey === "xe-cau" || filterKey === "cau-truc" || filterKey === "cau-gap") return cardSubKey.includes("cau") || cardCatName.includes("cẩu");
      if (filterKey === "bon-thuc-pham" || filterKey === "xe-bon-cam") return cardSubKey === "bon-thuc-pham" || cardCatName.includes("bồn cám");
      if (filterKey === "bon-nuoc" || filterKey === "xe-bon-nuoc" || filterKey === "xe-moi-truong-nang") return cardSubKey === "bon-nuoc" || cardSubKey === "xe-moi-truong-nang" || cardSubKey === "bon-hut-chat-thai" || cardCatName.includes("bồn") || cardCatName.includes("phun nước");
      if (filterKey === "bon-hut-chat-thai") return cardSubKey === "bon-hut-chat-thai" || cardTitle.includes("hút chất thải");
      if (filterKey === "cuu-ho" || filterKey === "xe-cuu-ho") return cardSubKey === "cuu-ho" || cardSubKey === "nang-dau" || cardCatName.includes("cứu hộ") || cardCatName.includes("nâng đầu");
      if (filterKey === "nang-dau" || filterKey === "xe-nang-dau") return cardSubKey === "nang-dau" || cardCatName.includes("nâng đầu");
      if (filterKey === "ep-rac" || filterKey === "xe-ep-rac") return cardSubKey === "ep-rac" || cardCatName.includes("ép rác");
      if (filterKey === "xe-nang-khac") return cardSubKey === "xe-nang-khac";
      if (filterKey === "16-cho") return cardSubKey === "16-cho" || cardCatName.includes("16 chỗ");
      if (filterKey === "29-cho") return cardSubKey === "29-cho" || cardSubKey === "34-cho" || cardCatName.includes("29-34 chỗ");
      if (filterKey === "34-cho") return cardSubKey === "34-cho" || cardTitle.includes("34 chỗ");
      if (filterKey === "47-cho") return cardSubKey === "47-cho" || cardCatName.includes("47 chỗ");

      return cardSubKey === filterKey || cardSubKey.includes(filterKey) || cardCatName.includes(filterKey);
    }

    function filterProducts() {
      const searchVal = document.getElementById("quickSearchInput")?.value || "";
      const selectedBrands = Array.from(document.querySelectorAll(".brand-checkbox:checked")).map(cb => String(cb.value || "").trim().toUpperCase());
      const selectedPriceIdx = parseInt(document.querySelector(".price-radio:checked")?.value || "0");
      const currentRange = priceRanges[selectedPriceIdx];

      const cards = document.querySelectorAll(".product-card");
      let visibleCount = 0;

      cards.forEach(card => {
        const name = card.getAttribute("data-name") || "";
        const fullSearch = card.getAttribute("data-search") || "";
        const brand = String(card.getAttribute("data-brand") || "").trim().toUpperCase();
        const category = card.getAttribute("data-category") || "";
        const subkey = card.getAttribute("data-subkey") || "";
        const type = card.getAttribute("data-type") || "";
        const price = parseFloat(card.getAttribute("data-price") || "0");

        const matchSearch = smartSearchMatch(searchVal, fullSearch);
        const matchCat = checkCategoryMatch(currentFilter, type, subkey, category, name);
        const matchBrand = selectedBrands.length === 0 || selectedBrands.includes(brand);
        const matchPrice = price >= currentRange.min && price < currentRange.max;

        if (matchSearch && matchCat && matchBrand && matchPrice) {
          card.style.display = "flex";
          visibleCount++;
        } else {
          card.style.display = "none";
        }
      });

      const lblCount = document.getElementById("lblCount");
      if (lblCount) lblCount.innerText = String(visibleCount);

      const emptyState = document.getElementById("emptyState");
      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? "block" : "none";
      }

      const titleText = categoryTitles[currentFilter] || "Danh Mục Sản Phẩm";
      const titleEl = document.getElementById("categoryTitle");
      const breadEl = document.getElementById("breadcrumbCurrent");
      if (titleEl) titleEl.innerText = titleText;
      if (breadEl) breadEl.innerText = titleText;
    }

    function highlightActiveTab() {
      document.querySelectorAll(".cat-tab").forEach(t => {
        const tabCat = (t.getAttribute("data-category") || "").toLowerCase();
        if (tabCat === currentFilter) {
          t.className = "cat-tab px-4 py-2.5 rounded-xl font-bold text-sm whitespace-nowrap transition cursor-pointer bg-blue-600 text-white shadow-md shadow-blue-600/20";
        } else {
          t.className = "cat-tab px-4 py-2.5 rounded-xl font-bold text-sm whitespace-nowrap transition cursor-pointer bg-white text-gray-700 border border-gray-200 hover:bg-gray-100";
        }
      });
    }

    document.querySelectorAll(".cat-tab").forEach(tab => {
      tab.addEventListener("click", (e) => {
        const target = e.currentTarget;
        currentFilter = (target.getAttribute("data-category") || "all").toLowerCase();
        highlightActiveTab();
        filterProducts();
      });
    });

    document.getElementById("quickSearchInput")?.addEventListener("input", filterProducts);
    document.querySelectorAll(".brand-checkbox").forEach(cb => cb.addEventListener("change", filterProducts));
    document.querySelectorAll(".price-radio").forEach(rb => rb.addEventListener("change", filterProducts));

    document.getElementById("btnResetFilter")?.addEventListener("click", () => {
      document.querySelectorAll(".brand-checkbox").forEach(cb => cb.checked = false);
      const firstRadio = document.querySelector(".price-radio");
      if (firstRadio) firstRadio.checked = true;
      const searchInput = document.getElementById("quickSearchInput");
      if (searchInput) searchInput.value = "";
      currentFilter = "all";
      highlightActiveTab();
      filterProducts();
    });

    highlightActiveTab();
    filterProducts();
  

  
  



  // === START AUTO SORT ===
  function initProductSortBar() {
    const firstCard = document.querySelector(".product-card") || document.querySelector("[data-brand]");
    if (!firstCard || !firstCard.parentElement) {
      console.warn("Không tìm thấy thẻ sản phẩm để gắn thanh sắp xếp.");
      return;
    }

    const grid = firstCard.parentElement;

    // Tạo giao diện Thanh Sắp Xếp nếu chưa có trên trang
    if (!document.getElementById("sort-select")) {
      const sortBar = document.createElement("div");
      sortBar.id = "custom-sort-bar";
      sortBar.className = "flex flex-wrap items-center justify-between gap-3 mb-6 bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm";
      sortBar.innerHTML = `
        <div class="text-sm text-slate-600 font-medium">
          Hiển thị <span id="visible-count" class="font-bold text-red-600">tất cả</span> dòng xe chuyên dùng &amp; ô tô
        </div>
        <div class="flex items-center gap-2">
          <label for="sort-select" class="text-sm font-semibold text-slate-700 whitespace-nowrap">Sắp xếp theo:</label>
          <select id="sort-select" class="text-sm border border-slate-300 rounded-lg px-3 py-2 bg-slate-50 text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 cursor-pointer">
            <option value="default">Mới cập nhật (Mặc định)</option>
            <option value="cap-desc">Tải trọng cho phép chở: Lớn → Nhỏ</option>
            <option value="cap-asc">Tải trọng cho phép chở: Nhỏ → Lớn</option>
            <option value="vol-desc">Thể tích bồn (Khối): Lớn → Nhỏ</option>
            <option value="vol-asc">Thể tích bồn (Khối): Nhỏ → Lớn</option>
            <option value="price-asc">Giá tham khảo: Thấp → Cao</option>
            <option value="price-desc">Giá tham khảo: Cao → Thấp</option>
          </select>
        </div>
      `;
      grid.parentNode.insertBefore(sortBar, grid);
    }

    const cards = Array.from(grid.children).filter(el => el.classList.contains("product-card") || el.hasAttribute("data-brand") || el.querySelector("a[href*='/san-pham/']"));
    cards.forEach((c, idx) => {
      if (!c.hasAttribute("data-orig-index")) {
        c.setAttribute("data-orig-index", String(idx));
      }
    });

    function extractCapacityScore(card, mode = "payload") {
      // Ưu tiên tuyệt đối dữ liệu chuẩn trích xuất từ chassisSpecs / specialSpecs
      const payloadAttr = parseFloat(card.getAttribute("data-payload") || "0");
      const volumeAttr = parseFloat(card.getAttribute("data-volume") || "0");

      if (mode === "volume") {
        if (volumeAttr > 0) return volumeAttr;
        if (payloadAttr > 0) return payloadAttr;
      } else {
        // Mặc định sắp xếp chuẩn theo Tải trọng cho phép chở (Tấn)
        if (payloadAttr > 0) return payloadAttr;
        if (volumeAttr > 0) return volumeAttr;
      }

      // Fallback nếu thẻ không có attribute
      const text = (card.getAttribute("data-name") || card.textContent || "")
        .toLowerCase()
        .replace(/tổng\s*tải\s*\d+(?:[.,]\d+)?\s*(?:tấn|tan|t\b)/gi, "");
      const tonMatch1 = text.match(/(\d+)t(\d+)/i);
      if (tonMatch1) return parseFloat(tonMatch1[1] + "." + tonMatch1[2]);
      const tonMatch2 = text.match(/(\d+(?:[.,]\d+)?)\s*(?:tấn|tan|t\b)/i);
      if (tonMatch2) return parseFloat(tonMatch2[1].replace(",", "."));
      const volMatch = text.match(/(\d+(?:[.,]\d+)?)\s*(?:khối|khoi|m3|m³)/i);
      if (volMatch) return parseFloat(volMatch[1].replace(",", "."));
      const seatMatch = text.match(/(\d+)\s*(?:chỗ|cho)/i);
      if (seatMatch) return parseFloat(seatMatch[1]);
      return 0;
    }

    function extractPriceScore(card) {
      const rawPrice = card.getAttribute("data-price");
      if (rawPrice && !isNaN(parseFloat(rawPrice)) && parseFloat(rawPrice) > 0) {
        return parseFloat(rawPrice);
      }
      const cleanText = (card.textContent || "").replace(/[.,]/g, "");
      const m = cleanText.match(/(\d{8,10})\s*(?:đ|vnđ|vnd)/i);
      if (m) return parseFloat(m[1]);
      const trMatch = (card.textContent || "").match(/(\d+(?:[.,]\d+)?)\s*triệu/i);
      if (trMatch) return parseFloat(trMatch[1].replace(",", ".")) * 1000000;
      const tyMatch = (card.textContent || "").match(/(\d+(?:[.,]\d+)?)\s*tỷ/i);
      if (tyMatch) return parseFloat(tyMatch[1].replace(",", ".")) * 1000000000;
      return 0;
    }

    function applySortAndCount() {
      const sortSelect = document.getElementById("sort-select");
      const visibleCountEl = document.getElementById("visible-count");
      const sortVal = sortSelect ? sortSelect.value : "default";

      const sortedCards = [...cards].sort((a, b) => {
        if (sortVal === "default") {
          return parseInt(a.getAttribute("data-orig-index") || "0") - parseInt(b.getAttribute("data-orig-index") || "0");
        }
        if (sortVal === "cap-desc" || sortVal === "cap-asc" || sortVal === "vol-desc" || sortVal === "vol-asc") {
          const isVol = sortVal.startsWith("vol-");
          const isDesc = sortVal.endsWith("-desc");
          const capA = extractCapacityScore(a, isVol ? "volume" : "payload");
          const capB = extractCapacityScore(b, isVol ? "volume" : "payload");
          if (capA === 0 && capB === 0) return 0;
          if (capA === 0) return 1;
          if (capB === 0) return -1;
          return isDesc ? capB - capA : capA - capB;
        }
        if (sortVal === "price-asc" || sortVal === "price-desc") {
          const priceA = extractPriceScore(a);
          const priceB = extractPriceScore(b);
          if (priceA === 0 && priceB === 0) return 0;
          if (priceA === 0) return 1;
          if (priceB === 0) return -1;
          return sortVal === "price-asc" ? priceA - priceB : priceB - priceA;
        }
        return 0;
      });

      sortedCards.forEach(card => grid.appendChild(card));

      if (visibleCountEl) {
        const visibleCards = cards.filter(c => c.style.display !== "none" && !c.classList.contains("hidden"));
        visibleCountEl.textContent = String(visibleCards.length);
      }
    }

    const sortSelectEl = document.getElementById("sort-select");
    if (sortSelectEl) {
      sortSelectEl.addEventListener("change", applySortAndCount);
    }

    document.addEventListener("input", () => setTimeout(applySortAndCount, 50));
    document.addEventListener("change", (e) => {
      if (e.target && e.target.id !== "sort-select") setTimeout(applySortAndCount, 50);
    });
    document.addEventListener("click", () => setTimeout(applySortAndCount, 60));

    applySortAndCount();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initProductSortBar);
  } else {
    initProductSortBar();
  }
  document.addEventListener("astro:page-load", initProductSortBar);
  // === END AUTO SORT ===

</script>
</BaseLayout>
