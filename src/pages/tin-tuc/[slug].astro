---
import BaseLayout from '../../layouts/BaseLayout.astro';
import postsData from '../../data/posts.json';

export function getStaticPaths() {
  const posts = Array.isArray(postsData) ? postsData : [];
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { slug } = Astro.params;
const posts = Array.isArray(postsData) ? postsData : [];
const post = Astro.props?.post || posts.find((p: any) => p.slug === slug);

if (!post) {
  return Astro.redirect('/404');
}

// Tự động làm sạch các ký tự HTML bị mã hóa kép (&lt;p&gt;) nếu có từ lần lưu trước
const cleanContent = (post.content || '')
  .replace(/&lt;/g, '<')
  .replace(/&gt;/g, '>')
  .replace(/&amp;/g, '&');

const related = posts.filter((p: any) => p.slug !== slug).slice(0, 3);


function extractPostYouTubeId(url) {
  if (!url || typeof url !== "string") return null;
  const m = url.match(/(?:youtube\.com\/(?:[^\/]+\/.+\/|v\/|e(?:mbed)?\/|.*[?&]v=|shorts\/)|youtu\.be\/)([^"&?\/\s]{11})/i);
  return m ? m[1] : null;
}
const postYtId = extractPostYouTubeId(post?.videoUrl || post?.youtubeUrl || "");

---

<BaseLayout title={`${post.title} | Kiến thức Ô Tô Chuyên Dùng Phú Cường`} description={post.excerpt || post.summary || post.title} image={post.image}>
  <main class="container mx-auto px-4 py-8 max-w-7xl">
    <nav class="text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-blue-600">Trang chủ</a> &gt; 
      <a href="/tin-tuc" class="hover:text-blue-600">Kiến thức & Tin tức</a> &gt; 
      <span class="text-gray-900 font-semibold line-clamp-1">{post.category}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <article class="lg:col-span-8 bg-white p-6 lg:p-10 rounded-2xl shadow-sm border border-gray-100 space-y-6">
        <div>
          <span class="inline-block bg-blue-100 text-blue-800 text-xs font-extrabold px-3 py-1 rounded-full mb-3 uppercase tracking-wider">{post.category}</span>
          <h1 class="text-2xl lg:text-4xl font-extrabold text-gray-900 leading-snug mb-4">{post.title}</h1>
          <div class="flex items-center gap-4 text-xs text-gray-500 border-b pb-4">
            <span>📅 {post.date}</span>
            <span>✍️ {post.author}</span>
            <span>👁️ {post.views}</span>
          </div>
        </div>

        {post.image && (
          <div class="overflow-hidden rounded-xl border border-gray-200">
            <img src={post.image} alt={post.title} class="w-full h-[400px] object-cover" />
          </div>
        )}

        {post.summary && (
          <p class="text-lg font-semibold text-slate-700 bg-slate-50 p-4 rounded-xl border-l-4 border-blue-600 leading-relaxed">
            {post.summary}
          </p>
        )}

        <!-- Render HTML chuẩn xác (biến thẻ <img> thành hình ảnh thật) -->
        
      {postYtId && (
        <div class="my-6 bg-slate-900 rounded-2xl p-4 sm:p-6 text-white shadow-xl">
          <div class="flex items-center justify-between mb-3">
            <span class="font-bold text-sm sm:text-base flex items-center gap-2">
              <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-red-600 text-white text-xs">▶</span>
              🎬 Video Thực Tế Minh Họa Trong Bài Viết
            </span>
            <a href={`https://www.youtube.com/watch?v=${postYtId}`} target="_blank" rel="noopener noreferrer" class="text-xs text-amber-400 hover:underline">Mở YouTube ↗</a>
          </div>
          <div
      class="yt-facade relative w-full overflow-hidden rounded-xl bg-black aspect-video cursor-pointer group border border-slate-700 shadow-xl"
      data-yt-id={ytVideoId}
      title="Bấm để phát video thực tế"
    >
      <img
        src={`https://i.ytimg.com/vi/${ytVideoId}/hqdefault.jpg`}
        alt="Video thực tế Ô Tô Phú Cường"
        loading="lazy"
        class="w-full h-full object-cover opacity-90 group-hover:scale-105 group-hover:opacity-100 transition-all duration-300"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-black/60"></div>

      <!-- LỚP PHỦ THƯƠNG HIỆU & HOTLINE PHÍA TRÊN -->
      <div class="absolute top-3 left-3 right-3 flex flex-wrap items-center justify-between gap-2 z-10 pointer-events-none">
        <div class="flex items-center gap-2 bg-slate-950/85 backdrop-blur-sm border border-white/15 px-3 py-1.5 rounded-lg shadow-md">
          <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-pulse"></span>
          <span class="text-[11px] sm:text-xs font-extrabold text-white tracking-wider uppercase">Ô TÔ CHUYÊN DÙNG PHÚ CƯỜNG</span>
        </div>
        <div class="bg-red-600/95 text-white text-[11px] sm:text-xs font-black px-3 py-1.5 rounded-lg shadow-md border border-red-400/40 flex items-center gap-1.5">
          <span>📞 Hotline/Zalo: 0922 77 77 03</span>
        </div>
      </div>

      <!-- NÚT PLAY TRUNG TÂM -->
      <button
        type="button"
        aria-label="Phát video"
        class="absolute inset-0 m-auto w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-red-600 group-hover:bg-red-500 text-white flex items-center justify-center shadow-2xl group-hover:scale-110 transition-transform duration-200 z-10 ring-4 ring-white/25"
      >
        <svg class="w-8 h-8 sm:w-10 sm:h-10 ml-1 fill-current" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z" />
        </svg>
      </button>

      <!-- LỚP PHỦ TÊN XE / BÀI VIẾT & THÔNG SỐ PHÍA DƯỚI -->
      <div class="absolute bottom-3 left-3.5 right-3.5 flex flex-col sm:flex-row sm:items-end justify-between gap-2 z-10 pointer-events-none">
        <div class="space-y-0.5 max-w-xl">
          <p class="text-white font-extrabold text-xs sm:text-sm line-clamp-1 drop-shadow">{post?.title || "Video Thực Tế Ô Tô Phú Cường"}</p>
          <p class="text-amber-300 font-bold text-[11px] sm:text-xs line-clamp-1">"Quay thực tế tại xưởng & bãi xe Phú Cường • Giao xe toàn quốc"</p>
        </div>
        <div class="flex items-center gap-1.5 shrink-0">
          <span class="text-[11px] text-slate-200 font-medium hidden sm:inline">🎬 Bấm để xem</span>
          <span class="bg-red-600 px-2.5 py-0.5 rounded text-white text-[11px] font-extrabold shadow">YouTube HD</span>
        </div>
      </div>
    </div>
      `;
      return wrap;
    }

    // 2. Quét trong vùng bài viết / mô tả (.prose) để biến link YouTube thành khung Video
    document.querySelectorAll(".prose a[href*='youtube.com'], .prose a[href*='youtu.be']").forEach(a => {
      const vid = getYtId(a.getAttribute("href"));
      if (!vid || a.dataset.ytProcessed === "1") return;
      a.dataset.ytProcessed = "1";

      const parentP = a.closest("p");
      // Nếu thẻ <p> chỉ chứa đường link YouTube (hoặc người dùng chèn link đứng riêng 1 dòng) -> Thay hẳn bằng khung phát Video
      if (parentP && parentP.textContent.trim() === a.textContent.trim()) {
        parentP.replaceWith(buildFacadeElement(vid));
      } else {
        // Nếu link nằm lẫn trong câu văn -> Chèn khung phát Video ngay bên dưới đoạn văn đó
        if (parentP && !parentP.dataset.hasVideoBelow) {
          parentP.dataset.hasVideoBelow = "1";
          parentP.after(buildFacadeElement(vid));
        }
      }
    });

    // 3. Trường hợp người dùng dán thẳng text URL YouTube mà không bôi đen bấm nút Link
    document.querySelectorAll(".prose p").forEach(p => {
      if (p.children.length === 0) {
        const txt = p.textContent.trim();
        if (/^https?:\/\/(?:www\.)?(?:youtube\.com|youtu\.be)\//i.test(txt)) {
          const vid = getYtId(txt);
          if (vid) p.replaceWith(buildFacadeElement(vid));
        }
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initInlineYouTubeEmbeds);
  } else {
    initInlineYouTubeEmbeds();
  }
  document.addEventListener("astro:page-load", initInlineYouTubeEmbeds);
</script>
<!-- === END INLINE YOUTUBE AUTO-EMBED === -->

</main>
</BaseLayout>
