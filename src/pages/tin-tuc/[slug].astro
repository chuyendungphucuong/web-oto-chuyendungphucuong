---
import BaseLayout from '../../layouts/BaseLayout.astro';
import postsData from '../../data/posts.json';

export function getStaticPaths() {
  const posts = Array.isArray(postsData) ? postsData : [];
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { slug } = Astro.params;
const posts = Array.isArray(postsData) ? postsData : [];
const post = Astro.props?.post || posts.find((p: any) => p.slug === slug);

if (!post) {
  return Astro.redirect('/404');
}

// Tự động làm sạch các ký tự HTML bị mã hóa kép (&lt;p&gt;) nếu có từ lần lưu trước
const cleanContent = (post.content || '')
  .replace(/&lt;/g, '<')
  .replace(/&gt;/g, '>')
  .replace(/&amp;/g, '&');

const related = posts.filter((p: any) => p.slug !== slug).slice(0, 3);

function extractPostYouTubeId(url: string) {
  if (!url || typeof url !== "string") return null;
  const m = url.match(/(?:youtube\.com\/(?:[^\/]+\/.+\/|v\/|e(?:mbed)?\/|.*[?&]v=|shorts\/)|youtu\.be\/)([^"&?\/\s]{11})/i);
  return m ? m[1] : null;
}
const postYtId = extractPostYouTubeId(post?.videoUrl || post?.youtubeUrl || "");

const postImageUrl = post.image
  ? (post.image.startsWith("http") ? post.image : `https://chuyendungphucuong.vn${post.image}`)
  : "https://chuyendungphucuong.vn/Logo.png";

function toIsoDate(rawDate: any) {
  if (!rawDate || typeof rawDate !== "string") return new Date().toISOString();
  // Hỗ trợ định dạng DD/MM/YYYY hoặc YYYY-MM-DD
  const dmy = rawDate.trim().match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})$/);
  if (dmy) {
    const [_, d, m, y] = dmy;
    return `${y}-${m.padStart(2, "0")}-${d.padStart(2, "0")}T08:00:00+07:00`;
  }
  const parsed = new Date(rawDate);
  return isNaN(parsed.getTime()) ? "2026-11-17T08:00:00+07:00" : parsed.toISOString();
}
const isoPublished = toIsoDate(post.date);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": post.title,
  "description": post.excerpt || post.summary || post.title,
  "image": [postImageUrl],
  "datePublished": isoPublished,
  "dateModified": isoPublished,
  "author": {
    "@type": "Person",
    "name": post.author || "Đặng Ngọc Hoàng Vũ - Phú Cường Auto",
    "url": "https://chuyendungphucuong.vn/gioi-thieu"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Ô Tô Chuyên Dùng Phú Cường",
    "logo": {
      "@type": "ImageObject",
      "url": "https://chuyendungphucuong.vn/Logo.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://chuyendungphucuong.vn/tin-tuc/${post.slug}`
  }
};

const newsBreadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Trang chủ",
      "item": "https://chuyendungphucuong.vn/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Kiến thức & Tin tức",
      "item": "https://chuyendungphucuong.vn/tin-tuc"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": post.title,
      "item": `https://chuyendungphucuong.vn/tin-tuc/${post.slug}`
    }
  ]
};
---

<BaseLayout title={`${post.title} | Kiến thức Ô Tô Chuyên Dùng Phú Cường`} description={post.excerpt || post.summary || post.title} image={post.image}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(newsBreadcrumbSchema)} />
  <main class="container mx-auto px-4 py-8 max-w-7xl">
    <nav class="text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-blue-600">Trang chủ</a> &gt; 
      <a href="/tin-tuc" class="hover:text-blue-600">Kiến thức &amp; Tin tức</a> &gt; 
      <span class="text-gray-900 font-semibold break-words leading-snug">{post.category}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <article class="lg:col-span-8 bg-white p-6 lg:p-10 rounded-2xl shadow-sm border border-gray-100 space-y-6">
        <div>
          <span class="inline-block bg-blue-100 text-blue-800 text-xs font-extrabold px-3 py-1 rounded-full mb-3 uppercase tracking-wider">{post.category}</span>
          <h1 class="text-2xl lg:text-4xl font-extrabold text-gray-900 leading-snug mb-4">{post.title}</h1>
          <div class="flex flex-wrap items-center gap-4 text-xs text-gray-500 border-b pb-4">
            <span>📅 {post.date}</span>
            <span>✍️ {post.author}</span>
            {post.views && <span>👁️ {post.views}</span>}
          </div>
        </div>

        {post.image && (
          <div class="overflow-hidden rounded-xl border border-gray-200">
            <img src={post.image} alt={post.title} class="w-full max-h-[420px] object-cover" />
          </div>
        )}

        {post.summary && (
          <p class="text-base lg:text-lg font-semibold text-slate-700 bg-slate-50 p-4 rounded-xl border-l-4 border-blue-600 leading-relaxed">
            {post.summary}
          </p>
        )}

        {postYtId && (
          <div class="my-6 bg-slate-900 rounded-2xl p-4 sm:p-6 text-white shadow-xl">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
              <span class="font-bold text-sm sm:text-base flex items-center gap-2">
                <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-red-600 text-white text-xs">▶</span>
                🎬 Video Thực Tế Minh Họa Trong Bài Viết
              </span>
              <a href={`https://www.youtube.com/watch?v=${postYtId}`} target="_blank" rel="noopener noreferrer" class="text-xs text-amber-400 hover:underline">Mở YouTube ↗</a>
            </div>
            <div
              class="yt-facade relative w-full overflow-hidden rounded-xl bg-black aspect-video cursor-pointer group border border-slate-700 shadow-xl"
              data-yt-id={postYtId}
              title="Bấm để phát video thực tế"
            >
              <img
                src={`https://i.ytimg.com/vi/${postYtId}/hqdefault.jpg`}
                alt="Video thực tế Ô Tô Phú Cường"
                loading="lazy"
                class="w-full h-full object-cover opacity-90 group-hover:scale-105 group-hover:opacity-100 transition-all duration-300"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-black/60"></div>

              <div class="absolute top-3 left-3 right-3 flex flex-wrap items-center justify-between gap-2 z-10 pointer-events-none">
                <div class="flex items-center gap-2 bg-slate-950/85 backdrop-blur-sm border border-white/15 px-3 py-1.5 rounded-lg shadow-md">
                  <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-pulse"></span>
                  <span class="text-[11px] sm:text-xs font-extrabold text-white tracking-wider uppercase">Ô TÔ CHUYÊN DÙNG PHÚ CƯỜNG</span>
                </div>
                <div class="bg-red-600/95 text-white text-[11px] sm:text-xs font-black px-3 py-1.5 rounded-lg shadow-md border border-red-400/40 flex items-center gap-1.5">
                  <span>📞 Hotline/Zalo: 0922 77 77 03</span>
                </div>
              </div>

              <button
                type="button"
                aria-label="Phát video"
                class="absolute inset-0 m-auto w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-red-600 group-hover:bg-red-500 text-white flex items-center justify-center shadow-2xl group-hover:scale-110 transition-transform duration-200 z-10 ring-4 ring-white/25"
              >
                <svg class="w-8 h-8 sm:w-10 sm:h-10 ml-1 fill-current" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </button>

              <div class="absolute bottom-3 left-3.5 right-3.5 flex flex-col sm:flex-row sm:items-end justify-between gap-2 z-10 pointer-events-none">
                <div class="space-y-0.5 max-w-xl">
                  <p class="text-white font-extrabold text-xs sm:text-sm break-words leading-snug drop-shadow">{post?.title || "Video Thực Tế Ô Tô Phú Cường"}</p>
                  <p class="text-amber-300 font-bold text-[11px] sm:text-xs break-words leading-snug">Quay thực tế tại xưởng &amp; bãi xe Phú Cường • Giao xe toàn quốc</p>
                </div>
                <div class="flex items-center gap-1.5 shrink-0">
                  <span class="text-[11px] text-slate-200 font-medium hidden sm:inline">🎬 Bấm để xem</span>
                  <span class="bg-red-600 px-2.5 py-0.5 rounded text-white text-[11px] font-extrabold shadow">YouTube HD</span>
                </div>
              </div>
            </div>
          </div>
        )}

        <!-- NỘI DUNG CHI TIẾT BÀI VIẾT (HỖ TRỢ ĐẦY ĐỦ BẢNG BIỂU & HÌNH ẢNH) -->
        <div
          class="prose max-w-none text-gray-800 leading-relaxed space-y-4 text-base
                 [&_h2]:text-xl [&_h2]:lg:text-2xl [&_h2]:font-extrabold [&_h2]:text-slate-900 [&_h2]:mt-6 [&_h2]:mb-3
                 [&_h3]:text-lg [&_h3]:font-bold [&_h3]:text-blue-900 [&_h3]:mt-5 [&_h3]:mb-2
                 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:space-y-1.5
                 [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:space-y-1.5
                 [&_a]:text-blue-600 [&_a]:font-semibold hover:[&_a]:underline
                 [&_img]:max-w-full [&_img]:h-auto [&_img]:rounded-xl [&_img]:my-5 [&_img]:mx-auto [&_img]:border [&_img]:border-gray-200
                 [&_table]:w-full [&_table]:border-collapse [&_table]:my-5 [&_table]:text-sm [&_table]:bg-white [&_table]:shadow-sm [&_table]:rounded-xl [&_table]:overflow-hidden
                 [&_th]:bg-blue-900 [&_th]:text-white [&_th]:font-bold [&_th]:p-3 [&_th]:border [&_th]:border-slate-300 [&_th]:text-left
                 [&_td]:p-3 [&_td]:border [&_td]:border-slate-200 [&_td]:align-top
                 [&_tr:nth-child(even)_td]:bg-slate-50"
          set:html={cleanContent}
        />
      </article>

      <!-- CỘT PHẢI: TƯ VẤN & BÀI VIẾT LIÊN QUAN -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="bg-gradient-to-br from-blue-900 to-slate-900 text-white p-6 rounded-2xl shadow-lg space-y-4">
          <span class="bg-red-600 text-white text-[10px] font-black px-2.5 py-1 rounded uppercase tracking-wider">Hỗ Trợ Trực Tuyến 24/7</span>
          <h3 class="text-xl font-extrabold leading-snug">Cần Tư Vấn Cấu Hình Xe &amp; Thủ Tục Trả Góp?</h3>
          <p class="text-xs sm:text-sm text-blue-100 leading-relaxed">
            Đội ngũ kỹ sư và chuyên viên Ô Tô Chuyên Dùng Phú Cường sẵn sàng hỗ trợ báo giá lăn bánh và hồ sơ ngân hàng lên đến 80% - 85%.
          </p>
          <div class="space-y-2.5 pt-1">
            <a href="tel:0922777703" class="block w-full bg-red-600 hover:bg-red-700 text-white font-extrabold py-3 px-4 rounded-xl text-center transition text-sm shadow">
              📞 Gọi Hotline: 0922 77 77 03
            </a>
            <a href="https://zalo.me/0922777703" target="_blank" rel="noopener noreferrer" class="block w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-3 px-4 rounded-xl text-center transition text-sm">
              💬 Nhắn Zalo Nhận Báo Giá
            </a>
            <a href="/tinh-lan-banh" class="block w-full bg-white/10 hover:bg-white/20 border border-white/20 text-white font-bold py-2.5 px-4 rounded-xl text-center transition text-xs sm:text-sm">
              🧮 Công Cụ Tính Giá Lăn Bánh
            </a>
          </div>
        </div>

        {related.length > 0 && (
          <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 space-y-4">
            <h3 class="text-lg font-extrabold text-gray-900 border-b pb-3">Bài Viết Liên Quan</h3>
            <div class="space-y-4">
              {related.map((item: any) => (
                <a href={`/tin-tuc/${item.slug}`} class="group flex gap-3 items-start">
                  {item.image && (
                    <img src={item.image} alt={item.title} loading="lazy" class="w-20 h-16 object-cover rounded-lg border shrink-0" />
                  )}
                  <div class="space-y-1">
                    <h4 class="text-xs sm:text-sm font-bold text-gray-900 group-hover:text-blue-600 transition break-words leading-snug">
                      {item.title}
                    </h4>
                    <p class="text-[11px] text-gray-400">{item.date}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>

    <!-- === START INLINE YOUTUBE AUTO-EMBED === -->
    <script is:inline>
      function initInlineYouTubeEmbeds() {
        document.addEventListener("click", function (e) {
          const facade = e.target.closest && e.target.closest(".yt-facade");
          if (!facade || facade.dataset.loaded === "1") return;
          const vid = facade.getAttribute("data-yt-id");
          if (!vid) return;
          facade.dataset.loaded = "1";
          facade.innerHTML = `<iframe class="w-full h-full border-0" src="https://www.youtube.com/embed/${vid}?autoplay=1&rel=0" title="YouTube video player" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>`;
        });

        function getYtId(url) {
          if (!url || typeof url !== "string") return null;
          const m = url.match(/(?:youtube\.com\/(?:[^\/]+\/.+\/|v\/|e(?:mbed)?\/|.*[?&]v=|shorts\/)|youtu\.be\/)([^"&?\/\s]{11})/i);
          return m ? m[1] : null;
        }

        function buildFacadeElement(vid) {
          const pageHeading = document.querySelector("h1")?.textContent?.trim() || "Video Thực Tế Ô Tô Chuyên Dùng Phú Cường";
          const wrap = document.createElement("div");
          wrap.className = "my-6 not-prose";
          wrap.innerHTML = `
            <div class="yt-facade relative w-full overflow-hidden rounded-2xl bg-black aspect-video cursor-pointer group border border-slate-700 shadow-xl" data-yt-id="${vid}" title="Bấm để xem video">
              <img src="https://i.ytimg.com/vi/${vid}/hqdefault.jpg" alt="YouTube Video" loading="lazy" class="w-full h-full object-cover opacity-90 group-hover:scale-105 group-hover:opacity-100 transition-all duration-300" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-black/60"></div>

              <div class="absolute top-3 left-3 right-3 flex flex-wrap items-center justify-between gap-2 z-10 pointer-events-none">
                <div class="flex items-center gap-2 bg-slate-950/85 backdrop-blur-sm border border-white/15 px-3 py-1.5 rounded-lg shadow-md">
                  <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-pulse"></span>
                  <span class="text-[11px] sm:text-xs font-extrabold text-white tracking-wider uppercase">Ô TÔ CHUYÊN DÙNG PHÚ CƯỜNG</span>
                </div>
                <div class="bg-red-600/95 text-white text-[11px] sm:text-xs font-black px-3 py-1.5 rounded-lg shadow-md border border-red-400/40">
                  📞 Hotline/Zalo: 0922 77 77 03
                </div>
              </div>

              <button type="button" aria-label="Phát video" class="absolute inset-0 m-auto w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-red-600 group-hover:bg-red-500 text-white flex items-center justify-center shadow-2xl group-hover:scale-110 transition-transform duration-200 z-10 ring-4 ring-white/25">
                <svg class="w-8 h-8 sm:w-10 sm:h-10 ml-1 fill-current" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
              </button>

              <div class="absolute bottom-3 left-3.5 right-3.5 flex flex-col sm:flex-row sm:items-end justify-between gap-2 z-10 pointer-events-none">
                <div class="space-y-0.5 max-w-xl">
                  <p class="text-white font-extrabold text-xs sm:text-sm break-words leading-snug drop-shadow">${pageHeading}</p>
                  <p class="text-amber-300 font-bold text-[11px] sm:text-xs">Quay thực tế tại xưởng &amp; bãi xe Phú Cường • Hỗ trợ trả góp 85%</p>
                </div>
                <div class="flex items-center gap-1.5 shrink-0">
                  <span class="text-[11px] text-slate-200 font-medium hidden sm:inline">🎬 Bấm để xem</span>
                  <span class="bg-red-600 px-2.5 py-0.5 rounded text-white text-[11px] font-extrabold shadow">YouTube HD</span>
                </div>
              </div>
            </div>
          `;
          return wrap;
        }

        document.querySelectorAll(".prose a[href*='youtube.com'], .prose a[href*='youtu.be']").forEach(a => {
          const vid = getYtId(a.getAttribute("href"));
          if (!vid || a.dataset.ytProcessed === "1") return;
          a.dataset.ytProcessed = "1";

          const parentP = a.closest("p");
          if (parentP && parentP.textContent.trim() === a.textContent.trim()) {
            parentP.replaceWith(buildFacadeElement(vid));
          } else if (parentP && !parentP.dataset.hasVideoBelow) {
            parentP.dataset.hasVideoBelow = "1";
            parentP.after(buildFacadeElement(vid));
          }
        });

        document.querySelectorAll(".prose p").forEach(p => {
          if (p.children.length === 0) {
            const txt = p.textContent.trim();
            if (/^https?:\/\/(?:www\.)?(?:youtube\.com|youtu\.be)\//i.test(txt)) {
              const vid = getYtId(txt);
              if (vid) p.replaceWith(buildFacadeElement(vid));
            }
          }
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initInlineYouTubeEmbeds);
      } else {
        initInlineYouTubeEmbeds();
      }
      document.addEventListener("astro:page-load", initInlineYouTubeEmbeds);
    </script>
    <!-- === END INLINE YOUTUBE AUTO-EMBED === -->
  </main>
</BaseLayout>
