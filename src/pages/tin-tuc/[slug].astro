---
import BaseLayout from '../../layouts/BaseLayout.astro';
import posts from '../../data/posts.json';

export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": post.title,
  "description": post.summary,
  "image": post.image,
  "datePublished": post.publishedDate,
  "author": { "@type": "Person", "name": post.author }
};
---

<BaseLayout title={post.title} description={post.summary} schema={articleSchema}>
  <article class="max-w-4xl mx-auto px-4 py-10">
    <nav class="text-sm text-slate-500 mb-6">
      <a href="/" class="hover:underline">Trang chủ</a> / 
      <a href="/tin-tuc" class="hover:underline">Kiến Thức & Tin Tức</a> / 
      <strong class="text-slate-800">{post.category}</strong>
    </nav>

    <header class="mb-8">
      <span class="bg-blue-100 text-blue-900 text-xs font-extrabold px-3 py-1 rounded uppercase">
        {post.category}
      </span>
      <h1 class="text-3xl md:text-4xl font-extrabold text-blue-950 mt-3 mb-4 leading-tight">
        {post.title}
      </h1>
      <div class="flex items-center text-sm text-slate-500 space-x-4">
        <span>📅 Ngày đăng: {post.publishedDate}</span>
        <span>✍️ Tác giả: {post.author}</span>
      </div>
    </header>

    <div class="mb-8">
      <img src={post.image} alt={post.title} class="w-full h-96 object-cover rounded-xl shadow-sm border border-slate-200" />
    </div>

    <!-- Tóm tắt Answer-First cho AI Overviews -->
    <div class="bg-blue-50 border-l-4 border-blue-900 p-5 rounded-r-lg mb-8 text-slate-700 leading-relaxed font-medium">
      {post.summary}
    </div>

    <!-- Nội dung bài viết -->
    <div class="prose max-w-none text-slate-700 space-y-6 text-base leading-relaxed whitespace-pre-line">
      {post.content}
    </div>

    <!-- Khối Câu Hỏi Thường Gặp (FAQ) cho AI Overviews -->
    <section class="mt-12 bg-white p-6 rounded-xl shadow-sm border border-slate-200">
      <h2 class="text-xl font-extrabold text-blue-950 mb-4">Câu Hỏi Thường Gặp</h2>
      <div class="space-y-4 text-sm">
        {post.faqs.map((faq) => (
          <div class="border-b border-slate-100 pb-3">
            <h3 class="font-bold text-slate-900">❓ {faq.question}</h3>
            <p class="text-slate-600 mt-1">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Khối liên hệ tư vấn cuối bài -->
    <div class="mt-12 bg-slate-900 text-white p-8 rounded-2xl text-center">
      <h3 class="text-2xl font-bold mb-2">Cần Tư Vấn Hồ Sơ Cải Tạo & Đóng Thùng Xe?</h3>
      <p class="text-slate-300 text-sm mb-6">Liên hệ trực tiếp với chuyên viên pháp lý của Ô Tô Chuyên Dùng Phú Cường.</p>
      <a href="tel:0922777703" class="inline-block bg-red-600 hover:bg-red-700 text-white font-extrabold px-8 py-3 rounded-lg text-lg transition shadow">
        📞 Hotline Tư Vấn: 0922 77 77 03
      </a>
    </div>
  </article>
</BaseLayout>
