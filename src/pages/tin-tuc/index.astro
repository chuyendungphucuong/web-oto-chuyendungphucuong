---
import BaseLayout from '../../layouts/BaseLayout.astro';
import postsData from '../../data/posts.json';

const posts = Array.isArray(postsData) ? postsData : [];

const categories = [
  'Tất Cả Chuyên Mục',
  'Đánh Giá & So Sánh Xe',
  'Thủ Tục Pháp Lý & Đăng Kiểm',
  'Kinh Nghiệm Vận Tải & Đầu Tư',
  'Tin Tức & Bàn Giao Xe Showroom'
];
---

<BaseLayout title="Kiến Thức & Tin Tức Ô Tô Chuyên Dùng | Phú Cường Auto">
  <main class="container mx-auto px-4 py-8 max-w-7xl">
    <nav class="text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-blue-600">Trang chủ</a> &gt; 
      <span class="text-gray-900 font-semibold">Kiến Thức & Tin Tức</span>
    </nav>

    <div class="bg-blue-800 text-white p-8 rounded-2xl mb-8 shadow-md">
      <h1 class="text-3xl lg:text-4xl font-extrabold mb-2">Kiến Thức Chuyên Ngành & Tin Tức Phú Cường</h1>
      <p class="text-white/90 text-sm lg:text-base">Cập nhật các thông tin đăng kiểm, đánh giá xe chuyên dùng và kinh nghiệm đầu tư vận tải thực tế.</p>
    </div>

    <!-- Thanh lọc chuyên mục tin tức -->
    <div class="flex overflow-x-auto gap-2 pb-4 mb-8 no-scrollbar">
      {categories.map((cat, idx) => (
        <button 
          type="button"
          data-category={cat}
          class={`cat-tab px-4 py-2.5 rounded-xl font-bold text-sm whitespace-nowrap transition cursor-pointer ${idx === 0 ? 'bg-blue-600 text-white shadow-md shadow-blue-600/20' : 'bg-white text-gray-700 border border-gray-200 hover:bg-gray-100'}`}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Lưới bài viết -->
    <div id="postGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
      {posts.map((post: any) => (
        <article class="bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm flex flex-col justify-between post-card" data-category={post.category}>
          <div>
            <div class="overflow-hidden h-60 bg-gray-100">
              <img src={post.image} alt={post.title} class="w-full h-full object-cover hover:scale-105 transition duration-300" />
            </div>
            <div class="p-6 space-y-3">
              <div class="flex justify-between items-center text-xs">
                <span class="bg-blue-100 text-blue-800 font-extrabold px-3 py-1 rounded-md">{post.category}</span>
                <span class="text-gray-400">{post.date}</span>
              </div>
              <h2 class="text-xl font-extrabold text-gray-900 leading-snug hover:text-blue-600 transition">
                <a href={`/tin-tuc/${post.slug}`}>{post.title}</a>
              </h2>
              <p class="text-gray-600 text-sm line-clamp-2 leading-relaxed">{post.summary}</p>
            </div>
          </div>
          <div class="p-6 pt-0">
            <a href={`/tin-tuc/${post.slug}`} class="inline-flex items-center gap-1 text-blue-600 hover:text-blue-800 font-bold text-sm transition">
              Đọc bài viết chi tiết &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </main>

  <script is:inline>
    document.querySelectorAll('.cat-tab').forEach(tab => {
      tab.addEventListener('click', (e) => {
        document.querySelectorAll('.cat-tab').forEach(t => {
          t.className = 'cat-tab px-4 py-2.5 rounded-xl font-bold text-sm whitespace-nowrap transition cursor-pointer bg-white text-gray-700 border border-gray-200 hover:bg-gray-100';
        });
        const target = e.currentTarget;
        target.className = 'cat-tab px-4 py-2.5 rounded-xl font-bold text-sm whitespace-nowrap transition cursor-pointer bg-blue-600 text-white shadow-md shadow-blue-600/20';

        const selectedCat = target.getAttribute('data-category');
        const cards = document.querySelectorAll('.post-card');

        cards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (selectedCat === 'Tất Cả Chuyên Mục' || cardCat === selectedCat) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</BaseLayout>
