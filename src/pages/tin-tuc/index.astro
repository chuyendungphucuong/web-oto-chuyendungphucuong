---
import BaseLayout from '../../layouts/BaseLayout.astro';
import posts from '../../data/posts.json';
---

<BaseLayout 
  title="Kiến Thức, Thủ Tục Đăng Kiểm & Tin Tức Xe Chuyên Dùng"
  description="Tổng hợp kiến thức chuyên ngành xe tải chuyên dùng, thủ tục cải tạo hoán cải, đăng kiểm và cập nhật tin tức bàn giao xe tại Phú Cường."
>
  <div class="max-w-7xl mx-auto px-4 py-10">
    <!-- Breadcrumb -->
    <nav class="text-sm text-slate-500 mb-6">
      <a href="/" class="hover:underline">Trang chủ</a> / 
      <a href="/tin-tuc" class="hover:underline">Kiến Thức & Tin Tức</a>
      <span id="breadcrumbCat" class="hidden"> / <strong id="breadcrumbCatText" class="text-slate-800"></strong></span>
    </nav>

    <!-- Tiêu đề trang -->
    <div class="text-center max-w-3xl mx-auto mb-8">
      <span id="badgeText" class="bg-blue-100 text-blue-900 text-xs font-extrabold px-3 py-1 rounded-full uppercase">
        Góc Chuyên Gia Vận Tải
      </span>
      <h1 id="pageTitle" class="text-3xl md:text-4xl font-extrabold text-blue-950 mt-3">
        Kiến Thức Kỹ Thuật, Thủ Tục Đăng Kiểm & Tin Tức
      </h1>
      <p class="text-slate-600 mt-3 text-base">
        Cập nhật các quy định pháp luật mới nhất về cải tạo xe chuyên dùng, kinh nghiệm đầu tư xe tải cẩu, xe bồn và tin tức hoạt động từ hệ thống Phú Cường.
      </p>
    </div>

    <!-- Thanh nút bấm lọc nhanh các mục nhỏ ngay trên trang -->
    <div class="flex flex-wrap justify-center gap-2 mb-10">
      <a href="/tin-tuc" data-cat-btn="all" class="cat-filter-btn px-4 py-2 rounded-lg text-sm font-bold border transition bg-blue-900 text-white border-blue-900">
        Tất Cả Bài Viết
      </a>
      <a href="/tin-tuc?cat=danh-gia-xe" data-cat-btn="danh-gia-xe" class="cat-filter-btn px-4 py-2 rounded-lg text-sm font-bold border transition bg-white text-slate-700 border-slate-300 hover:border-blue-900">
        Đánh Giá & So Sánh Xe
      </a>
      <a href="/tin-tuc?cat=phap-ly" data-cat-btn="phap-ly" class="cat-filter-btn px-4 py-2 rounded-lg text-sm font-bold border transition bg-white text-slate-700 border-slate-300 hover:border-blue-900">
        Thủ Tục Pháp Lý & Đăng Kiểm
      </a>
      <a href="/tin-tuc?cat=kinh-nghiem" data-cat-btn="kinh-nghiem" class="cat-filter-btn px-4 py-2 rounded-lg text-sm font-bold border transition bg-white text-slate-700 border-slate-300 hover:border-blue-900">
        Kinh Nghiệm Vận Tải & Đầu Tư
      </a>
      <a href="/tin-tuc?cat=tin-tuc" data-cat-btn="tin-tuc" class="cat-filter-btn px-4 py-2 rounded-lg text-sm font-bold border transition bg-white text-slate-700 border-slate-300 hover:border-blue-900">
        Tin Tức & Bàn Giao Xe
      </a>
    </div>

    <!-- Danh sách bài viết -->
    <div id="postsGrid" class="grid md:grid-cols-3 gap-8">
      {posts.map((post) => (
        <article 
          class="post-card bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden flex flex-col justify-between hover:shadow-md transition"
          data-category={post.category}
        >
          <div>
            <img src={post.image} alt={post.title} class="w-full h-48 object-cover" />
            <div class="p-6">
              <span class="text-xs font-bold text-blue-900 bg-blue-50 px-2.5 py-1 rounded">{post.category}</span>
              <h2 class="font-bold text-lg text-slate-900 hover:text-red-600 mt-2 mb-3 leading-snug">
                <a href={`/tin-tuc/${post.slug}`}>{post.title}</a>
              </h2>
              <p class="text-slate-600 text-sm line-clamp-3 leading-relaxed">
                {post.summary}
              </p>
            </div>
          </div>
          <div class="p-6 pt-0 flex justify-between items-center text-xs text-slate-500 border-t border-slate-100 mt-4 pt-4">
            <span>📅 {post.publishedDate}</span>
            <a href={`/tin-tuc/${post.slug}`} class="font-bold text-red-600 hover:underline">Xem chi tiết →</a>
          </div>
        </article>
      ))}
    </div>

    <!-- Thông báo khi mục nhỏ chưa có bài viết -->
    <div id="emptyState" class="hidden text-center py-16 bg-white rounded-xl border border-slate-200">
      <p class="text-slate-500 text-base mb-4">Hiện tại chưa có bài viết nào thuộc chuyên mục này.</p>
      <a href="/tin-tuc" class="inline-block bg-blue-900 text-white font-bold px-6 py-2.5 rounded-lg text-sm">
        Xem Tất Cả Bài Viết
      </a>
    </div>
  </div>

  <!-- Script tự động đọc ?cat= trên thanh địa chỉ và lọc bài ngay lập tức -->
  <script>
    const categoryMap: Record<string, { match: string; title: string }> = {
      'danh-gia-xe': { match: 'Đánh Giá', title: 'Đánh Giá & So Sánh Xe' },
      'phap-ly': { match: 'Pháp Lý', title: 'Thủ Tục Pháp Lý & Đăng Kiểm' },
      'kinh-nghiem': { match: 'Kinh Nghiệm', title: 'Kinh Nghiệm Vận Tải & Đầu Tư' },
      'tin-tuc': { match: 'Tin Tức', title: 'Tin Tức & Bàn Giao Xe Showroom' }
    };

    function applyCategoryFilter() {
      const params = new URLSearchParams(window.location.search);
      const catKey = params.get('cat') || 'all';
      const config = categoryMap[catKey];

      const cards = document.querySelectorAll('.post-card');
      const buttons = document.querySelectorAll('.cat-filter-btn');
      const emptyState = document.getElementById('emptyState');
      const pageTitle = document.getElementById('pageTitle');
      const badgeText = document.getElementById('badgeText');
      const breadcrumbCat = document.getElementById('breadcrumbCat');
      const breadcrumbCatText = document.getElementById('breadcrumbCatText');

      // Đổi màu nút tab đang được chọn
      buttons.forEach((btn) => {
        const el = btn as HTMLElement;
        if (el.dataset.catBtn === catKey) {
          el.className = 'cat-filter-btn px-4 py-2 rounded-lg text-sm font-bold border transition bg-blue-900 text-white border-blue-900';
        } else {
          el.className = 'cat-filter-btn px-4 py-2 rounded-lg text-sm font-bold border transition bg-white text-slate-700 border-slate-300 hover:border-blue-900';
        }
      });

      // Cập nhật tiêu đề theo mục nhỏ
      if (config && pageTitle && badgeText && breadcrumbCat && breadcrumbCatText) {
        pageTitle.textContent = config.title;
        badgeText.textContent = `Chuyên Mục: ${config.title}`;
        breadcrumbCat.classList.remove('hidden');
        breadcrumbCatText.textContent = config.title;
      }

      // Lọc các bài viết khớp với mục nhỏ
      let visibleCount = 0;
      cards.forEach((card) => {
        const el = card as HTMLElement;
        const postCat = (el.dataset.category || '').toLowerCase();
        const isMatch = !config || postCat.includes(config.match.toLowerCase());

        if (isMatch) {
          el.style.display = 'flex';
          visibleCount++;
        } else {
          el.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCount > 0);
      }
    }

    applyCategoryFilter();
  </script>
</BaseLayout>
