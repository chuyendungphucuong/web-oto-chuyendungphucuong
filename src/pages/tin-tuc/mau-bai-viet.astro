---
import BaseLayout from '../../layouts/BaseLayout.astro';

const samplePost = {
  title: "Thủ tục mua xe tải, xe chuyên dùng trả góp qua ngân hàng mới nhất: Cần chuẩn bị những gì?",
  category: "Kinh Nghiệm Vận Tải & Đầu Tư",
  date: "19 Tháng Mười, 2026",
  author: "Chuyên gia tài chính Phú Cường Auto",
  views: "1.245 lượt xem",
  summary: "Hướng dẫn chi tiết thủ tục, hồ sơ và quy trình vay mua xe chuyên dùng trả góp lên đến 80% giá trị xe tại các ngân hàng uy tín, hỗ trợ khách hàng cá nhân và doanh nghiệp tại TP.HCM, Tiền Giang, An Giang.",
  image: "https://images.unsplash.com/photo-1563720223185-11003d516935?auto=format&fit=crop&w=1200&q=80",
  content: `
    <p class="lead text-lg font-medium text-gray-700 mb-6">Mua xe ô tô chuyên dùng, xe tải trả góp là giải pháp tài chính tối ưu giúp nhiều cá nhân và doanh nghiệp vận tải nhanh chóng sở hữu phương tiện kinh doanh mà không phải chịu áp lực tài chính quá lớn ban đầu.</p>
    
    <h2 class="text-2xl font-bold text-gray-900 mt-6 mb-4">1. Điều kiện và tỷ lệ hỗ trợ vay vốn</h2>
    <p class="mb-4">Hiện nay, tại Ô Tô Chuyên Dùng Phú Cường, các ngân hàng và công ty tài chính lớn đang hỗ trợ mức vay rất linh hoạt cho các dòng xe bồn, xe cẩu, xe cứu hộ:</p>
    <ul class="list-disc pl-6 space-y-2 mb-6 text-gray-700">
      <li><strong>Đối với khách hàng cá nhân:</strong> Hỗ trợ vay từ 70% đến 75% giá trị xe.</li>
      <li><strong>Đối với khách hàng doanh nghiệp:</strong> Hỗ trợ vay lên đến 80% - 85% giá trị xe.</li>
      <li><strong>Thời gian cho vay:</strong> Linh hoạt từ 1 năm (12 tháng) đến tối đa 6 - 7 năm (84 tháng).</li>
    </ul>

    <!-- HÌNH ẢNH CHÈN Ở GIỮA BÀI VIẾT -->
    <div class="my-8">
      <div class="overflow-hidden rounded-xl border border-gray-200 bg-gray-50">
        <img src="https://images.unsplash.com/photo-1601584115197-04ecc0da31d7?auto=format&fit=crop&w=1000&q=80" alt="Bàn giao xe chuyên dùng cho khách hàng" class="w-full h-[350px] object-cover" />
      </div>
      <p class="text-center text-sm text-gray-500 mt-2 italic">Hình ảnh thực tế bàn giao lô xe chuyên dùng cho khách hàng tại chi nhánh Phú Cường Auto.</p>
    </div>

    <h2 class="text-2xl font-bold text-gray-900 mt-6 mb-4">2. Hồ sơ chuẩn bị vay mua xe gồm những gì?</h2>
    <p class="mb-4">Để hồ sơ được ngân hàng duyệt nhanh chóng trong vòng 24h, quý khách cần chuẩn bị các giấy tờ cơ bản sau:</p>
    
    <h3 class="text-xl font-semibold text-gray-800 mt-4 mb-2">Đối với cá nhân:</h3>
    <ol class="list-decimal pl-6 space-y-2 mb-4 text-gray-700">
      <li>Căn cước công dân (CCCD) gắn chip của người vay và vợ/chồng (nếu có lập gia đình).</li>
      <li>Giấy chứng nhận kết hôn hoặc giấy xác nhận độc thân.</li>
      <li>Chứng minh thu nhập: Hợp đồng lao động, bảng lương 3-6 tháng gần nhất, hoặc giấy tờ chứng minh nguồn thu kinh doanh (nếu có).</li>
    </ol>

    <!-- THÊM MỘT HÌNH ẢNH KHÁC Ở GIỮA -->
    <div class="my-8">
      <div class="overflow-hidden rounded-xl border border-gray-200 bg-gray-50">
        <img src="https://phucuongauto.vn/wp-content/uploads/2026/05/bon-cam-thoi-chenglong-4-chan-slider.png" alt="Xưởng đóng thùng bồn chuyên dùng" class="w-full h-[350px] object-contain bg-gray-100 p-2" />
      </div>
      <p class="text-center text-sm text-gray-500 mt-2 italic">Xưởng cơ khí đóng mới bồn, thùng và xe chuyên dùng đạt chuẩn chất lượng kiểm định.</p>
    </div>

    <h3 class="text-xl font-semibold text-gray-800 mt-4 mb-2">Đối với doanh nghiệp:</h3>
    <ol class="list-decimal pl-6 space-y-2 mb-6 text-gray-700">
      <li>Giấy chứng nhận đăng ký doanh nghiệp (GPKD).</li>
      <li>Báo cáo tài chính, tờ khai thuế các quý gần nhất.</li>
      <li>Hợp đồng kinh tế đầu ra/đầu vào tiêu biểu.</li>
    </ol>

    <div class="bg-blue-50 border-l-4 border-blue-600 p-4 my-6 text-blue-900 rounded-r-xl">
      <p class="font-bold">💡 Lời khuyên từ chuyên gia Phú Cường Auto:</p>
      <p class="text-sm mt-1">Đội ngũ tư vấn tài chính của chúng tôi sẽ hỗ trợ trọn gói từ A-Z hồ sơ chứng minh thu nhập, làm việc trực tiếp với các ngân hàng lớn để tối ưu lãi suất và tỷ lệ giải ngân cao nhất cho quý khách.</p>
    </div>
  `,
  relatedPosts: [
    { title: "Quy định đăng kiểm xe chuyên dùng mới nhất năm 2026", date: "15 Th10, 2026", category: "Thủ Tục Pháp Lý & Đăng Kiểm", slug: "#" },
    { title: "Đánh giá chi tiết xe bồn cám Chenglong 4 chân 30 khối", date: "10 Th10, 2026", category: "Đánh Giá & So Sánh Xe", slug: "#" },
    { title: "Lô xe cứu hộ giao thông 3 chức năng bàn giao tại Tiền Giang", date: "05 Th10, 2026", category: "Tin Tức & Bàn Giao Xe Showroom", slug: "#" }
  ]
};
---

<BaseLayout title={`${samplePost.title} | Kiến thức Ô Tô Chuyên Dùng Phú Cường`}>
  <main class="container mx-auto px-4 py-8 max-w-7xl">
    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-blue-600">Trang chủ</a> &gt; 
      <a href="/tin-tuc" class="hover:text-blue-600">Kiến thức & Tin tức</a> &gt; 
      <span class="text-gray-900 font-semibold line-clamp-1">{samplePost.category}</span>
    </nav>

    <!-- Bố cục 2 cột -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Cột Nội dung chính (8 phần) -->
      <article class="lg:col-span-8 bg-white p-6 lg:p-10 rounded-2xl shadow-sm border border-gray-100 space-y-6">
        <div>
          <span class="inline-block bg-blue-100 text-blue-800 text-xs font-extrabold px-3 py-1 rounded-full mb-3 uppercase tracking-wider">{samplePost.category}</span>
          <h1 class="text-2xl lg:text-4xl font-extrabold text-gray-900 leading-snug mb-4">{samplePost.title}</h1>
          <div class="flex items-center gap-4 text-xs text-gray-500 border-b pb-4">
            <span>📅 {samplePost.date}</span>
            <span>✍️ {samplePost.author}</span>
            <span>👁️ {samplePost.views}</span>
          </div>
        </div>

        <!-- Ảnh đại diện bài viết -->
        <div class="overflow-hidden rounded-xl border border-gray-200">
          <img src={samplePost.image} alt={samplePost.title} class="w-full h-[400px] object-cover" />
        </div>

        <!-- Thân bài viết -->
        <div class="prose max-w-none text-gray-800 leading-relaxed space-y-4" set:html={samplePost.content} />

        <!-- Hộp kêu gọi hành động cuối bài viết -->
        <div class="bg-gradient-to-r from-blue-800 to-blue-900 text-white p-6 rounded-2xl shadow-md mt-8 space-y-4 text-center">
          <h3 class="text-xl font-bold">Bạn đang cần tư vấn mua xe chuyên dùng trả góp?</h3>
          <p class="text-sm text-white/90 max-w-xl mx-auto">Liên hệ ngay với Ô Tô Chuyên Dùng Phú Cường để nhận bảng dự toán chi tiết và hỗ trợ thủ tục ngân hàng nhanh chóng.</p>
          <a href="tel:0922777703" class="inline-block bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-8 rounded-xl transition shadow-lg text-lg">
            📞 Hotline tư vấn: 0922 77 77 03
          </a>
        </div>
      </article>

      <!-- Cột Sidebar phụ (4 phần) -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="bg-blue-800 text-white p-6 rounded-2xl shadow-sm space-y-3">
          <h3 class="font-bold text-lg border-b border-white/20 pb-2">Hỗ trợ nhanh 24/7</h3>
          <p class="text-sm text-white/90">Giải đáp mọi thắc mắc về kỹ thuật xe chuyên dùng và thủ tục đăng ký, đăng kiểm.</p>
          <a href="tel:0922777703" class="block bg-red-600 hover:bg-red-700 text-white font-bold py-3 rounded-xl text-center transition">
            📞 0922 77 77 03
          </a>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 space-y-4">
          <h3 class="font-bold text-gray-900 border-b pb-2 text-base flex items-center gap-2">
            <span class="w-2 h-5 bg-blue-600 rounded-full"></span> Bài viết liên quan
          </h3>
          <div class="space-y-4">
            {samplePost.relatedPosts.map((post) => (
              <div class="group border-b border-gray-100 pb-3 last:border-0 last:pb-0">
                <div class="flex items-center justify-between text-xs mb-1">
                  <span class="text-blue-600 font-semibold">{post.category}</span>
                  <span class="text-gray-400">{post.date}</span>
                </div>
                <h4 class="font-semibold text-sm text-gray-800 group-hover:text-blue-600 transition leading-snug">
                  <a href={post.slug}>{post.title}</a>
                </h4>
              </div>
            ))}
          </div>
        </div>
      </aside>

    </div>
  </main>
</BaseLayout>
