    const inputSeats = document.getElementById('inputSeats') as HTMLInputElement;
    const selectLocation = document.getElementById('selectLocation') as HTMLSelectElement;
    const selectRatio = document.getElementById('selectLoanRatio') as HTMLSelectElement;
    const selectTerm = document.getElementById('selectLoanTerm') as HTMLSelectElement;
    const inputRate = document.getElementById('inputInterestRate') as HTMLInputElement;

    // Các phần tử của Card hiển thị trực quan & Modal
    const cardVehicleImg = document.getElementById('cardVehicleImg') as HTMLImageElement;
    const cardVehicleBrand = document.getElementById('cardVehicleBrand');
    const cardVehicleCat = document.getElementById('cardVehicleCat');
    const cardVehicleName = document.getElementById('cardVehicleName');
    const cardVehiclePrice = document.getElementById('cardVehiclePrice');

    const modal = document.getElementById('vehiclePickerModal');
    const inputSearch = document.getElementById('inputModalSearch') as HTMLInputElement;
    const btnClearSearch = document.getElementById('btnClearSearch');
    const modalItems = document.querySelectorAll('.modal-vehicle-item');
    const catBtns = document.querySelectorAll('.modal-cat-btn');
    const emptyState = document.getElementById('modalEmptyState');
    const countLabel = document.getElementById('modalCountLabel');

    let activeCategory = 'Tất cả';

    // Hàm bỏ dấu tiếng Việt giúp gõ tìm kiếm không dấu cực nhạy
    function normalizeText(str: string) {
      return (str || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[đĐ]/g, 'd');
    }

    // Mở / Đóng Modal
    function openModal() {
      if (!modal) return;
      modal.classList.remove('hidden');
      setTimeout(() => inputSearch?.focus(), 50);
      highlightCurrentSelectedInModal();
    }

    function closeModal() {
      modal?.classList.add('hidden');
    }

    function highlightCurrentSelectedInModal() {
      const currentSlug = selectModel?.value;
      modalItems.forEach((item) => {
        const el = item as HTMLElement;
        if (el.getAttribute('data-slug') === currentSlug) {
          el.classList.add('ring-2', 'ring-blue-600', 'border-blue-600', 'bg-blue-50/40');
        } else {
          el.classList.remove('ring-2', 'ring-blue-600', 'border-blue-600', 'bg-blue-50/40');
        }
      });
    }

    // Lọc danh sách xe trong Modal theo từ khóa + danh mục
    function filterModalVehicles() {
      const query = normalizeText(inputSearch?.value || '');
      if (btnClearSearch) {
        btnClearSearch.classList.toggle('hidden', query.length === 0);
      }

      let visibleCount = 0;

      modalItems.forEach((item) => {
        const el = item as HTMLElement;
        const name = normalizeText(el.getAttribute('data-name') || '');
        const brand = normalizeText(el.getAttribute('data-brand') || '');
        const rawCat = el.getAttribute('data-cat') || '';
        const normCat = normalizeText(rawCat);

        const matchCat = activeCategory === 'Tất cả' || rawCat === activeCategory;
        const matchQuery = !query || name.includes(query) || brand.includes(query) || normCat.includes(query);

        if (matchCat && matchQuery) {
          el.classList.remove('hidden');
          visibleCount++;
        } else {
          el.classList.add('hidden');
        }
      });

      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCount > 0);
      }
      if (countLabel) {
        countLabel.innerText = `Hiển thị ${visibleCount} mẫu xe phù hợp`;
      }
    }

    // Gắn sự kiện mở / đóng Modal
    document.getElementById('selectedVehicleCard')?.addEventListener('click', openModal);
    document.getElementById('btnOpenPickerTop')?.addEventListener('click', openModal);
    document.getElementById('btnCloseVehicleModal')?.addEventListener('click', closeModal);
    document.getElementById('btnCloseModalBottom')?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal?.classList.contains('hidden')) closeModal();
    });

    // Sự kiện gõ tìm kiếm trực tiếp
    inputSearch?.addEventListener('input', filterModalVehicles);
    btnClearSearch?.addEventListener('click', () => {
      if (inputSearch) inputSearch.value = '';
      filterModalVehicles();
      inputSearch?.focus();
    });

    // Sự kiện bấm chọn Tab danh mục
    catBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeCategory = btn.getAttribute('data-cat') || 'Tất cả';
        catBtns.forEach((b) => {
          b.className = 'modal-cat-btn shrink-0 px-3.5 py-1.5 rounded-full text-xs font-bold border transition cursor-pointer bg-white text-gray-700 border-gray-300 hover:border-blue-500 hover:text-blue-600';
        });
        btn.className = 'modal-cat-btn shrink-0 px-3.5 py-1.5 rounded-full text-xs font-bold border transition cursor-pointer bg-blue-600 text-white border-blue-600 shadow-sm';
        filterModalVehicles();
      });
    });

    // Sự kiện khi khách bấm chọn 1 xe trong lưới Modal
    modalItems.forEach((item) => {
      item.addEventListener('click', () => {
        const slug = item.getAttribute('data-slug');
        if (slug && selectModel) {
          selectModel.value = slug;
          loadSelectedCarDefaults();
          closeModal();
        }
      });
    });

    // =========================================================================
    // BIỂU GIÁ ĐĂNG KÝ ĐĂNG KIỂM KHÁCH HÀNG (CẬP NHẬT THEO FILE PDF 11/11/2026)
    // =========================================================================
    // Cấu trúc: [ <=2.5T, >2.5T..<=5T (hoặc 16 chỗ), >5T..<=10T, >10T..18T/Đầu kéo ]
    const DKDK_PRICING_TABLE: Record<string, { plate: number; inspect: number; tiers: [number, number, number, number]; noCar?: number }> = {
      hcm_1:             { plate: 350000, inspect: 78860, tiers: [3500000, 3800000, 4100000, 4400000] },
      hcm_2:             { plate: 350000, inspect: 78860, tiers: [3500000, 3800000, 4100000, 4400000] },
      hcm_bd:            { plate: 350000, inspect: 78860, tiers: [3400000, 3700000, 3900000, 4300000] },
      dong_nai:          { plate: 100000, inspect: 78860, tiers: [3800000, 4100000, 4300000, 4700000] },
      hcm_vt:            { plate: 350000, inspect: 78860, tiers: [3700000, 4300000, 5100000, 5500000], noCar: 5300000 },
      tg_la:             { plate: 100000, inspect: 78860, tiers: [3800000, 4400000, 5200000, 5600000], noCar: 5400000 },
      tn_bp_bt_vl:       { plate: 100000, inspect: 78860, tiers: [4100000, 4400000, 6200000, 7100000], noCar: 6000000 },
      bt_ag_tv_ct_hg_dt: { plate: 100000, inspect: 78860, tiers: [4600000, 5400000, 6300000, 7100000], noCar: 7500000 },
      bl_st_kg:          { plate: 100000, inspect: 78860, tiers: [5100000, 5700000, 6900000, 7600000], noCar: 7500000 },
      cm_nt_ld_kh:       { plate: 100000, inspect: 78860, tiers: [6000000, 6700000, 7400000, 8200000], noCar: 6500000 },
      gl_dn_dl:          { plate: 100000, inspect: 78860, tiers: [7100000, 8000000, 8500000, 9100000], noCar: 7600000 },
      kon_tum:           { plate: 100000, inspect: 78860, tiers: [7500000, 8200000, 9400000, 9600000] },
      phu_yen:           { plate: 100000, inspect: 78860, tiers: [6900000, 7500000, 8400000, 9300000], noCar: 8600000 },
      binh_dinh:         { plate: 100000, inspect: 78860, tiers: [7700000, 8300000, 9700000, 10300000], noCar: 8600000 },
      quang_ngai:        { plate: 100000, inspect: 78860, tiers: [8200000, 8900000, 10200000, 11100000], noCar: 9700000 }
    };

    const selectRegMode = document.getElementById('selectRegMode') as HTMLSelectElement | null;

    function lookupPdfScheduleFees(locKey: string, payloadKg: number, isBus: boolean, seats: number, regMode: string) {
      const cfg = DKDK_PRICING_TABLE[locKey] || DKDK_PRICING_TABLE.hcm_2;
      let tierIdx = 0;
      let bracketLabel = '<= 2.5T';

      if (isBus) {
        if (seats <= 16) {
          tierIdx = 1;
          bracketLabel = 'Xe 16 chỗ';
        } else if (seats <= 34) {
          tierIdx = 2;
          bracketLabel = 'Xe khách trung';
        } else {
          tierIdx = 3;
          bracketLabel = 'Xe khách lớn';
        }
      } else {
        if (payloadKg <= 2500) {
          tierIdx = 0;
          bracketLabel = '<= 2.5T';
        } else if (payloadKg <= 5000) {
          tierIdx = 1;
          bracketLabel = '> 2.5T - 5T';
        } else if (payloadKg <= 10000) {
          tierIdx = 2;
          bracketLabel = '> 5T - 10T';
        } else {
          tierIdx = 3;
          bracketLabel = '> 10T / Đầu kéo';
        }
      }

      let dkdkFee = cfg.tiers[tierIdx];
      if (regMode === 'khong_xe' && cfg.noCar) {
        dkdkFee = cfg.noCar;
        bracketLabel = 'ĐK không xe';
      }

      return {
        plateFee: cfg.plate,
        inspectFee: cfg.inspect,
        dkdkFee,
        bracketLabel
      };
    }

    // Bảo mật 2 lớp Chế độ Chuyên Viên Nội Bộ + Ghi nhớ thiết bị cá nhân
    const EXPECTED_TOKEN = 'NzcwM3xIdmQyMDExODlA'; // Base64("7703|Hvd201189@")
    const SALE_DEVICE_KEY = 'pc_sale_trusted_device_v3';
    const SALE_SESSION_KEY = 'pc_sale_session_v3';
    let isSaleMode = false;
    let isDeviceTrusted = false;

    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('sale')) {
      urlParams.delete('sale');
      const cleanQuery = urlParams.toString();
      const cleanUrl = window.location.pathname + (cleanQuery ? '?' + cleanQuery : '');
      window.history.replaceState({}, document.title, cleanUrl);
    }

    try {
      localStorage.removeItem('phucuong_sale_mode');
      if (localStorage.getItem(SALE_DEVICE_KEY) === EXPECTED_TOKEN) {
        isSaleMode = true;
        isDeviceTrusted = true;
      } else if (sessionStorage.getItem(SALE_SESSION_KEY) === EXPECTED_TOKEN) {
        isSaleMode = true;
      }
    } catch (e) {}

    const staffOnlyControls = document.getElementById('staffOnlyControls');
    const staffOnlyResults = document.getElementById('staffOnlyResults');
    const scheduleSection = document.getElementById('scheduleSection');
    const rolloutLeadForm = document.getElementById('rolloutPageLeadForm') as HTMLFormElement | null;
    const btnToggleSaleMode = document.getElementById('btnToggleSaleMode');
    const btnLockSaleMode = document.getElementById('btnLockSaleMode');
    const btnTempPreviewPublic = document.getElementById('btnTempPreviewPublic');
    const btnResetDefaultFees = document.getElementById('btnResetDefaultFees');

    const inputDiscount = document.getElementById('inputDiscountAmount') as HTMLInputElement | null;
    const inputCustomerForPdf = document.getElementById('inputCustomerForPdf') as HTMLInputElement | null;
    const inputCustomNoteForPdf = document.getElementById('inputCustomNoteForPdf') as HTMLInputElement | null;
    const extraFeeRowsContainer = document.getElementById('extraFeeRowsContainer');
    const btnAddExtraFeeRow = document.getElementById('btnAddExtraFeeRow');

    const chkFeeReg = document.getElementById('chkFeeReg') as HTMLInputElement | null;
    const inputCustomRegRate = document.getElementById('inputCustomRegRate') as HTMLInputElement | null;
    const valFeeReg = document.getElementById('valFeeReg') as HTMLInputElement | null;

    const chkFeePlate = document.getElementById('chkFeePlate') as HTMLInputElement | null;
    const valFeePlate = document.getElementById('valFeePlate') as HTMLInputElement | null;

    const chkFeeRoad = document.getElementById('chkFeeRoad') as HTMLInputElement | null;
    const valFeeRoad = document.getElementById('valFeeRoad') as HTMLInputElement | null;

    const chkFeeInspect = document.getElementById('chkFeeInspect') as HTMLInputElement | null;
    const valFeeInspect = document.getElementById('valFeeInspect') as HTMLInputElement | null;

    const chkFeeTnds = document.getElementById('chkFeeTnds') as HTMLInputElement | null;
    const valFeeTnds = document.getElementById('valFeeTnds') as HTMLInputElement | null;

    const chkFeeBodyIns = document.getElementById('chkFeeBodyIns') as HTMLInputElement | null;
    const inputBodyInsRate = document.getElementById('inputBodyInsRate') as HTMLInputElement | null;
    const valFeeBodyIns = document.getElementById('valFeeBodyIns') as HTMLInputElement | null;

    const chkFeeDkdk = document.getElementById('chkFeeDkdk') as HTMLInputElement | null;
    const valFeeDkdk = document.getElementById('valFeeDkdk') as HTMLInputElement | null;
    const lblDkdkBracket = document.getElementById('lblDkdkBracket');

    const chkFeeHtx = document.getElementById('chkFeeHtx') as HTMLInputElement | null;
    const valFeeHtx = document.getElementById('valFeeHtx') as HTMLInputElement | null;

    const manualOverride = {
      reg: false,
      plate: false,
      road: false,
      inspect: false,
      tnds: false,
      bodyIns: false,
      dkdk: false
    };

    function resetManualOverridesAndSync() {
      manualOverride.reg = false;
      manualOverride.plate = false;
      manualOverride.road = false;
      manualOverride.inspect = false;
      manualOverride.tnds = false;
      manualOverride.bodyIns = false;
      manualOverride.dkdk = false;
      if (inputCustomRegRate) inputCustomRegRate.value = '2';
      if (inputBodyInsRate) inputBodyInsRate.value = '1.5';
      if (valFeeHtx) valFeeHtx.value = '6000000';
      [chkFeeReg, chkFeePlate, chkFeeRoad, chkFeeInspect, chkFeeTnds, chkFeeBodyIns, chkFeeDkdk, chkFeeHtx].forEach((c) => {
        if (c) c.checked = true;
      });
      syncAutoFeeInputs();
      recalculateAll();
    }

    btnResetDefaultFees?.addEventListener('click', resetManualOverridesAndSync);

    function getNetVehiclePrice() {
      const basePrice = parseFloat(inputPrice?.value || '0') || 0;
      const discount = isSaleMode ? (parseFloat(inputDiscount?.value || '0') || 0) : 0;
      return Math.max(0, basePrice - discount);
    }

    function syncAutoFeeInputs() {
      const netPrice = getNetVehiclePrice();
      const isBus = selectType?.value === 'bus';
      const payloadKg = parseFloat(inputPayload?.value || '0') || 0;
      const totalWeightKg = parseFloat(inputWeight?.value || '0') || 0;
      const seats = parseInt(inputSeats?.value || '2') || 2;
      const locKey = selectLocation?.value || 'hcm_2';
      const regMode = selectRegMode?.value || 'co_xe';

      const pdfFees = lookupPdfScheduleFees(locKey, payloadKg, isBus, seats, regMode);
      const roadTax = FINANCIAL_CONFIG.getRoadTax(totalWeightKg, isBus, seats);
      const insuranceTNDS = FINANCIAL_CONFIG.getInsuranceTNDS(payloadKg, seats, isBus);

      if (lblDkdkBracket) lblDkdkBracket.innerText = pdfFees.bracketLabel;

      const regRate = parseFloat(inputCustomRegRate?.value || '2') || 0;
      if (!manualOverride.reg && valFeeReg) {
        valFeeReg.value = String(Math.round(netPrice * (regRate / 100)));
      }
      if (!manualOverride.plate && valFeePlate) {
        valFeePlate.value = String(pdfFees.plateFee);
      }
      if (!manualOverride.road && valFeeRoad) {
        valFeeRoad.value = String(roadTax);
      }
      if (!manualOverride.inspect && valFeeInspect) {
        valFeeInspect.value = String(pdfFees.inspectFee);
      }
      if (!manualOverride.tnds && valFeeTnds) {
        valFeeTnds.value = String(insuranceTNDS);
      }
      const bodyInsRate = parseFloat(inputBodyInsRate?.value || '1.5') || 0;
      if (!manualOverride.bodyIns && valFeeBodyIns) {
        valFeeBodyIns.value = String(Math.round(netPrice * (bodyInsRate / 100)));
      }
      if (!manualOverride.dkdk && valFeeDkdk) {
        valFeeDkdk.value = String(pdfFees.dkdkFee);
      }
    }

    inputCustomRegRate?.addEventListener('input', () => {
      manualOverride.reg = false;
      syncAutoFeeInputs();
      recalculateAll();
    });
    inputBodyInsRate?.addEventListener('input', () => {
      manualOverride.bodyIns = false;
      syncAutoFeeInputs();
      recalculateAll();
    });

    valFeeReg?.addEventListener('input', () => { manualOverride.reg = true; recalculateAll(); });
    valFeePlate?.addEventListener('input', () => { manualOverride.plate = true; recalculateAll(); });
    valFeeRoad?.addEventListener('input', () => { manualOverride.road = true; recalculateAll(); });
    valFeeInspect?.addEventListener('input', () => { manualOverride.inspect = true; recalculateAll(); });
    valFeeTnds?.addEventListener('input', () => { manualOverride.tnds = true; recalculateAll(); });
    valFeeBodyIns?.addEventListener('input', () => { manualOverride.bodyIns = true; recalculateAll(); });
    valFeeDkdk?.addEventListener('input', () => { manualOverride.dkdk = true; recalculateAll(); });
    valFeeHtx?.addEventListener('input', recalculateAll);

    [chkFeeReg, chkFeePlate, chkFeeRoad, chkFeeInspect, chkFeeTnds, chkFeeBodyIns, chkFeeDkdk, chkFeeHtx].forEach((chk) => {
      chk?.addEventListener('change', recalculateAll);
    });

    [inputPrice, inputDiscount].forEach((el) => {
      el?.addEventListener('input', () => {
        syncAutoFeeInputs();
        recalculateAll();
      });
    });

    [selectLocation, selectRegMode, selectType, inputPayload, inputWeight, inputSeats].forEach((el) => {
      el?.addEventListener('change', () => {
        manualOverride.plate = false;
        manualOverride.road = false;
        manualOverride.inspect = false;
        manualOverride.tnds = false;
        manualOverride.dkdk = false;
        syncAutoFeeInputs();
        recalculateAll();
      });
      el?.addEventListener('input', () => {
        syncAutoFeeInputs();
        recalculateAll();
      });
    });

    function addExtraFeeRow(defaultTitle = '', defaultAmount = '') {
      if (!extraFeeRowsContainer) return;
      const row = document.createElement('div');
      row.className = 'flex items-center gap-2 extra-fee-row';
      row.innerHTML = `
        <input type="text" value="${defaultTitle}" placeholder="Tên hạng mục khác (VD: Bồn Inox 304, Ốp Meca...)" class="extra-fee-name flex-1 p-2 border border-slate-300 rounded-lg text-xs font-semibold text-slate-900 bg-slate-50 focus:bg-white outline-none focus:border-blue-600" />
        <input type="number" value="${defaultAmount}" step="500000" placeholder="Số tiền (VNĐ)" class="extra-fee-val w-36 p-2 border border-slate-300 rounded-lg text-xs font-bold text-blue-800 bg-slate-50 focus:bg-white outline-none focus:border-blue-600" />
        <button type="button" class="btn-remove-extra text-red-500 hover:text-red-700 font-black px-2 py-1 text-xs cursor-pointer" title="Xóa hạng mục">✕</button>
      `;
      row.querySelectorAll('input').forEach((inp) => inp.addEventListener('input', recalculateAll));
      row.querySelector('.btn-remove-extra')?.addEventListener('click', () => {
        row.remove();
        recalculateAll();
      });
      extraFeeRowsContainer.appendChild(row);
      recalculateAll();
    }

    btnAddExtraFeeRow?.addEventListener('click', () => addExtraFeeRow('', ''));

    function applySaleModeUI() {
      const publicSummary = document.getElementById('publicFeeSummaryBlock');
      const saleActiveFees = document.getElementById('saleActiveFeesContainer');

      if (isSaleMode) {
        staffOnlyControls?.classList.remove('hidden');
        staffOnlyResults?.classList.remove('hidden');
        scheduleSection?.classList.remove('hidden');
        rolloutLeadForm?.classList.add('hidden');
        publicSummary?.classList.add('hidden');
        saleActiveFees?.classList.remove('hidden');
        if (btnToggleSaleMode) {
          btnToggleSaleMode.innerText = '🔓 Đang bật Chế độ Sale';
          btnToggleSaleMode.className = 'text-[11px] font-extrabold text-emerald-800 bg-emerald-100 border border-emerald-300 px-2.5 py-1 rounded-lg transition cursor-pointer shrink-0';
        }
      } else {
        staffOnlyControls?.classList.add('hidden');
        staffOnlyResults?.classList.add('hidden');
        scheduleSection?.classList.add('hidden');
        rolloutLeadForm?.classList.remove('hidden');
        publicSummary?.classList.remove('hidden');
        saleActiveFees?.classList.add('hidden');
        if (btnToggleSaleMode) {
          btnToggleSaleMode.innerText = '🔒 Nội bộ';
          btnToggleSaleMode.className = 'text-[11px] font-bold text-slate-500 hover:text-blue-700 bg-white border border-slate-200 px-2.5 py-1 rounded-lg transition cursor-pointer shrink-0';
        }
      }
      syncAutoFeeInputs();
      recalculateAll();
    }

    const inlinePinBox = document.getElementById('inlinePinBox');
    const inputInlineSalePin = document.getElementById('inputInlineSalePin') as HTMLInputElement | null;
    const inputInlineSalePass = document.getElementById('inputInlineSalePass') as HTMLInputElement | null;
    const chkRememberDevice = document.getElementById('chkRememberDevice') as HTMLInputElement | null;
    const btnConfirmInlinePin = document.getElementById('btnConfirmInlinePin');
    const btnCloseInlinePin = document.getElementById('btnCloseInlinePin');

    function verifyAndUnlockPin() {
      const enteredPin = inputInlineSalePin?.value?.trim() || '';
      const enteredPass = inputInlineSalePass?.value?.trim() || '';

      if (!enteredPin || !enteredPass) {
        alert('⚠️ Vui lòng nhập đầy đủ Mã PIN và Mật khẩu bảo mật!');
        inputInlineSalePass?.focus();
        return;
      }

      let encoded = '';
      try {
        encoded = btoa(enteredPin + '|' + enteredPass);
      } catch (e) {
        encoded = '';
      }

      if (encoded === EXPECTED_TOKEN) {
        isSaleMode = true;
        try {
          sessionStorage.setItem(SALE_SESSION_KEY, EXPECTED_TOKEN);
          if (chkRememberDevice?.checked) {
            isDeviceTrusted = true;
            localStorage.setItem(SALE_DEVICE_KEY, EXPECTED_TOKEN);
          } else {
            localStorage.removeItem(SALE_DEVICE_KEY);
          }
        } catch (e) {}

        inlinePinBox?.classList.add('hidden');
        if (inputInlineSalePin) inputInlineSalePin.value = '';
        if (inputInlineSalePass) inputInlineSalePass.value = '';
        applySaleModeUI();
      } else {
        alert('❌ Mã PIN hoặc Mật khẩu bảo mật chưa đúng!');
        if (inputInlineSalePass) {
          inputInlineSalePass.value = '';
          inputInlineSalePass.focus();
        }
      }
    }

    btnToggleSaleMode?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (isSaleMode) {
        isSaleMode = false;
        applySaleModeUI();
      } else if (isDeviceTrusted || localStorage.getItem(SALE_DEVICE_KEY) === EXPECTED_TOKEN) {
        isSaleMode = true;
        isDeviceTrusted = true;
        applySaleModeUI();
      } else if (inlinePinBox) {
        inlinePinBox.classList.toggle('hidden');
        if (!inlinePinBox.classList.contains('hidden')) {
          setTimeout(() => inputInlineSalePin?.focus(), 40);
        }
      }
    });

    btnTempPreviewPublic?.addEventListener('click', () => {
      isSaleMode = false;
      applySaleModeUI();
    });

    btnCloseInlinePin?.addEventListener('click', () => {
      inlinePinBox?.classList.add('hidden');
    });

    btnConfirmInlinePin?.addEventListener('click', (e) => {
      e.preventDefault();
      verifyAndUnlockPin();
    });

    [inputInlineSalePin, inputInlineSalePass].forEach((inp) => {
      inp?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          verifyAndUnlockPin();
        }
      });
    });

    btnLockSaleMode?.addEventListener('click', () => {
      isSaleMode = false;
      isDeviceTrusted = false;
      try {
        localStorage.removeItem(SALE_DEVICE_KEY);
        sessionStorage.removeItem(SALE_SESSION_KEY);
      } catch (e) {}
      applySaleModeUI();
      alert('🔒 Đã đăng xuất và xóa ghi nhớ trên thiết bị này.');
    });

    function loadSelectedCarDefaults() {
      if (!selectModel) return;
      const opt = selectModel.options[selectModel.selectedIndex];
      if (!opt) return;

      const rawPrice = Number(opt.getAttribute('data-price') || '0');
      const rawMinPrice = Number(opt.getAttribute('data-minprice') || rawPrice);
      const defaultCsbhDiscount = (rawPrice > 0 && rawMinPrice > 0 && rawPrice > rawMinPrice) ? (rawPrice - rawMinPrice) : 0;
      if (inputPrice) inputPrice.value = String(rawPrice);
      if (inputDiscount) inputDiscount.value = String(defaultCsbhDiscount);
      const lblMinEl = document.getElementById('lblCsbhMinPrice');
      if (lblMinEl) lblMinEl.innerText = rawMinPrice > 0 ? rawMinPrice.toLocaleString('vi-VN') + ' đ' : 'Chưa cấu hình';

      const isBus = opt.getAttribute('data-isbus') === 'true';
      if (selectType) selectType.value = isBus ? 'bus' : 'special';
      if (inputPayload) inputPayload.value = opt.getAttribute('data-payload') || '8000';
      if (inputWeight) inputWeight.value = opt.getAttribute('data-weight') || '16000';
      if (inputSeats) inputSeats.value = opt.getAttribute('data-seats') || '2';

      if (cardVehicleImg) cardVehicleImg.src = opt.getAttribute('data-image') || '';
      if (cardVehicleBrand) cardVehicleBrand.innerText = opt.getAttribute('data-brand') || 'Phú Cường';
      if (cardVehicleCat) cardVehicleCat.innerText = opt.getAttribute('data-cat') || 'Xe Chuyên Dùng';
      if (cardVehicleName) cardVehicleName.innerText = opt.getAttribute('data-name') || '';

      manualOverride.reg = false;
      manualOverride.plate = false;
      manualOverride.road = false;
      manualOverride.inspect = false;
      manualOverride.tnds = false;
      manualOverride.bodyIns = false;
      manualOverride.dkdk = false;

      syncAutoFeeInputs();
      recalculateAll();
    }

    function recalculateAll() {
      if (!selectModel) return;
      const opt = selectModel.options[selectModel.selectedIndex];
      const carName = opt ? opt.getAttribute('data-name') || '' : '';
      const carImg = opt ? opt.getAttribute('data-image') || '' : '';
      const chassisJson = opt ? opt.getAttribute('data-chassis') || '{}' : '{}';
      const specialJson = opt ? opt.getAttribute('data-special') || '{}' : '{}';

      const basePrice = parseFloat(inputPrice?.value || '0') || 0;
      const discount = isSaleMode ? (parseFloat(inputDiscount?.value || '0') || 0) : 0;
      const netVehiclePrice = Math.max(0, basePrice - discount);

      if (cardVehiclePrice) {
        if (isSaleMode && basePrice > 0) {
          cardVehiclePrice.innerText = netVehiclePrice.toLocaleString('vi-VN') + ' đ' + (discount > 0 ? ' (Đã trừ CK)' : ' (Giá tiêu chuẩn)');
        } else {
          const dpTrieu = basePrice > 0 ? Math.round((basePrice * 0.2) / 1000000) : 0;
          cardVehiclePrice.innerText = dpTrieu > 0
            ? '💳 Trả trước (20%): ~' + dpTrieu.toLocaleString('vi-VN') + ' Triệu'
            : '💳 Trả trước chỉ từ 20% giá xe';
        }
      }

      const isBus = selectType?.value === 'bus';
      const payloadKg = parseFloat(inputPayload?.value || '0') || 0;
      const totalWeightKg = parseFloat(inputWeight?.value || '0') || 0;
      const seats = parseInt(inputSeats?.value || '2') || 2;
      const locKey = selectLocation?.value || 'hcm_2';
      const regMode = selectRegMode?.value || 'co_xe';

      const pdfFees = lookupPdfScheduleFees(locKey, payloadKg, isBus, seats, regMode);
      const defaultRoadTax = FINANCIAL_CONFIG.getRoadTax(totalWeightKg, isBus, seats);
      const defaultTnds = FINANCIAL_CONFIG.getInsuranceTNDS(payloadKg, seats, isBus);

      // Xây dựng danh sách 8 hạng mục mặc định (Chỉ cộng vào Tổng lăn bánh những mục đang được tick chọn)
      const regRatePct = parseFloat(inputCustomRegRate?.value || '2') || 0;
      const bodyInsRatePct = parseFloat(inputBodyInsRate?.value || '1.5') || 0;
      const tndsLabel = isBus
        ? `BH TNDS bắt buộc Xe khách (${seats} chỗ)`
        : `BH TNDS chuyên dùng (${(payloadKg / 1000).toFixed(1)}T + ${seats} ghế)`;

      const eightDefaultItems = [
        {
          enabled: isSaleMode ? Boolean(chkFeeReg?.checked) : true,
          label: `Lệ phí trước bạ (${regRatePct}%)`,
          amount: isSaleMode ? (parseFloat(valFeeReg?.value || '0') || 0) : Math.round(netVehiclePrice * 0.02)
        },
        {
          enabled: isSaleMode ? Boolean(chkFeePlate?.checked) : true,
          label: 'Lệ phí Biển số (Theo biên lai NN)',
          amount: isSaleMode ? (parseFloat(valFeePlate?.value || '0') || 0) : pdfFees.plateFee
        },
        {
          enabled: isSaleMode ? Boolean(chkFeeRoad?.checked) : true,
          label: 'Phí bảo trì đường bộ (1 năm)',
          amount: isSaleMode ? (parseFloat(valFeeRoad?.value || '0') || 0) : defaultRoadTax
        },
        {
          enabled: isSaleMode ? Boolean(chkFeeInspect?.checked) : true,
          label: 'Phí đăng kiểm (Theo biên lai NN)',
          amount: isSaleMode ? (parseFloat(valFeeInspect?.value || '0') || 0) : pdfFees.inspectFee
        },
        {
          enabled: isSaleMode ? Boolean(chkFeeTnds?.checked) : true,
          label: tndsLabel,
          amount: isSaleMode ? (parseFloat(valFeeTnds?.value || '0') || 0) : defaultTnds
        },
        {
          enabled: isSaleMode ? Boolean(chkFeeBodyIns?.checked) : true,
          label: `Bảo hiểm Thân vỏ (${bodyInsRatePct}%)`,
          amount: isSaleMode ? (parseFloat(valFeeBodyIns?.value || '0') || 0) : Math.round(netVehiclePrice * 0.015)
        },
        {
          enabled: isSaleMode ? Boolean(chkFeeDkdk?.checked) : true,
          label: `Dịch vụ đăng ký đăng kiểm (Giá ĐKĐK - ${pdfFees.bracketLabel})`,
          amount: isSaleMode ? (parseFloat(valFeeDkdk?.value || '0') || 0) : pdfFees.dkdkFee
        },
        {
          enabled: isSaleMode ? Boolean(chkFeeHtx?.checked) : true,
          label: 'Hợp tác xã, hộp đen (Phù hiệu + Định vị GPS)',
          amount: isSaleMode ? (parseFloat(valFeeHtx?.value || '0') || 0) : 6000000
        }
      ];

      const activeDefaultItems = eightDefaultItems.filter((item) => item.enabled);
      const totalDefaultFees = activeDefaultItems.reduce((sum, item) => sum + item.amount, 0);

      // Các hạng mục phát sinh thêm bên ngoài 8 mục
      const extraItems: { name: string; amount: number }[] = [];
      let totalExtraAmount = 0;
      if (isSaleMode && extraFeeRowsContainer) {
        extraFeeRowsContainer.querySelectorAll('.extra-fee-row').forEach((row) => {
          const nameInp = row.querySelector('.extra-fee-name') as HTMLInputElement | null;
          const valInp = row.querySelector('.extra-fee-val') as HTMLInputElement | null;
          const itemName = nameInp?.value?.trim() || '';
          const itemVal = parseFloat(valInp?.value || '0') || 0;
          if (itemName || itemVal !== 0) {
            extraItems.push({ name: itemName || 'Hạng mục bổ sung', amount: itemVal });
            totalExtraAmount += itemVal;
          }
        });
      }

      const totalRollout = netVehiclePrice + totalDefaultFees + totalExtraAmount;

      const loanRatio = parseFloat(selectRatio?.value || '0.8') || 0.8;
      const loanTermMonths = parseInt(selectTerm?.value || '60') || 60;
      const annualRate = (parseFloat(inputRate?.value || '9.5') || 9.5) / 100;

      const loanAmount = Math.round(netVehiclePrice * loanRatio);
      const downPayment = totalRollout - loanAmount;

      const monthlyRate = annualRate / 12;
      const monthlyPrincipal = Math.round(loanAmount / loanTermMonths);
      const firstMonthInterest = Math.round(loanAmount * monthlyRate);
      const firstMonthPayment = monthlyPrincipal + firstMonthInterest;

      // Cập nhật hiển thị Cột Phải trên Web
      const elCarName = document.getElementById('resCarName');
      const elPrice = document.getElementById('resPrice');
      const elRoadTax = document.getElementById('resRoadTax');
      const elInsurance = document.getElementById('resInsurance');
      const elInsExplain = document.getElementById('lblInsuranceExplain');
      const elOtherFees = document.getElementById('resOtherFees');
      const elPublicPlateInspect = document.getElementById('resPublicPlateAndInspect');
      const elTotalRollout = document.getElementById('resTotalRollout');
      const elDownPayment = document.getElementById('resDownPayment');
      const webDiscountRow = document.getElementById('webDiscountRow');
      const resDiscount = document.getElementById('resDiscount');
      const saleActiveFeesContainer = document.getElementById('saleActiveFeesContainer');
      const webExtraItemsContainer = document.getElementById('webExtraItemsContainer');

      if (elCarName) elCarName.innerText = carName;
      if (elPublicPlateInspect) elPublicPlateInspect.innerText = (pdfFees.plateFee + pdfFees.inspectFee).toLocaleString('vi-VN') + ' đ';
      if (elRoadTax) elRoadTax.innerText = defaultRoadTax.toLocaleString('vi-VN') + ' đ';
      if (elInsurance) elInsurance.innerText = defaultTnds.toLocaleString('vi-VN') + ' đ';
      if (elInsExplain) elInsExplain.innerText = tndsLabel + ':';
      if (elOtherFees) elOtherFees.innerText = pdfFees.dkdkFee.toLocaleString('vi-VN') + ' đ';

      if (isSaleMode) {
        if (elPrice) {
          elPrice.className = 'font-black text-gray-900 text-base';
          elPrice.innerText = basePrice.toLocaleString('vi-VN') + ' đ';
        }
        if (webDiscountRow && resDiscount) {
          if (discount > 0) {
            webDiscountRow.classList.remove('hidden');
            webDiscountRow.classList.add('flex');
            resDiscount.innerText = '-' + discount.toLocaleString('vi-VN') + ' đ';
          } else {
            webDiscountRow.classList.add('hidden');
            webDiscountRow.classList.remove('flex');
          }
        }
        if (saleActiveFeesContainer) {
          saleActiveFeesContainer.innerHTML = '';
          activeDefaultItems.forEach((item) => {
            const div = document.createElement('div');
            div.className = 'flex justify-between items-center border-b pb-2';
            div.innerHTML = `<span class="text-gray-600">${item.label}:</span><span class="font-bold text-gray-900">${item.amount.toLocaleString('vi-VN')} đ</span>`;
            saleActiveFeesContainer.appendChild(div);
          });
        }
        if (webExtraItemsContainer) {
          webExtraItemsContainer.innerHTML = '';
          extraItems.forEach((item) => {
            const div = document.createElement('div');
            div.className = 'flex justify-between items-center border-b pb-2 text-blue-900';
            div.innerHTML = `<span class="font-medium">+ ${item.name}:</span><span class="font-bold">${item.amount.toLocaleString('vi-VN')} đ</span>`;
            webExtraItemsContainer.appendChild(div);
          });
        }
        if (elTotalRollout) {
          elTotalRollout.className = 'text-red-600 text-lg font-black';
          elTotalRollout.innerText = totalRollout.toLocaleString('vi-VN') + ' đ';
        }
        if (elDownPayment) {
          elDownPayment.innerText = downPayment.toLocaleString('vi-VN') + ' đ';
        }

        const elLoanAmount = document.getElementById('resLoanAmount');
        const elMonthlyPrincipal = document.getElementById('resMonthlyPrincipal');
        const elMaxMonthly = document.getElementById('resMaxMonthly');
        if (elLoanAmount) elLoanAmount.innerText = loanAmount.toLocaleString('vi-VN') + ' đ';
        if (elMonthlyPrincipal) elMonthlyPrincipal.innerText = monthlyPrincipal.toLocaleString('vi-VN') + ' đ / tháng';
        if (elMaxMonthly) elMaxMonthly.innerText = firstMonthPayment.toLocaleString('vi-VN') + ' đ / tháng';
      } else {
        if (webDiscountRow) {
          webDiscountRow.classList.add('hidden');
          webDiscountRow.classList.remove('flex');
        }
        if (webExtraItemsContainer) webExtraItemsContainer.innerHTML = '';
        if (elPrice) {
          elPrice.className = 'text-xs font-bold bg-amber-100 text-amber-900 px-2.5 py-1 rounded-md border border-amber-300';
          elPrice.innerText = '🔒 Nhận qua Zalo / Email';
        }
        if (elTotalRollout) {
          elTotalRollout.className = 'text-red-600 text-xs sm:text-sm font-extrabold';
          elTotalRollout.innerText = '🔒 Điền thông tin bên dưới để nhận';
        }
        const approxDownTrieu = basePrice > 0 ? Math.round((basePrice * (1 - loanRatio)) / 1000000) : 0;
        if (elDownPayment) {
          elDownPayment.innerText = approxDownTrieu > 0
            ? `~${approxDownTrieu.toLocaleString('vi-VN')} Triệu đ (Trả trước ${Math.round((1 - loanRatio) * 100)}%)`
            : `Trả trước ${Math.round((1 - loanRatio) * 100)}% giá trị xe`;
        }
      }

      // Đổ dữ liệu sang Bản In 2 Trang A4 Vector (PDF)
      const printCarName = document.getElementById('printCarName');
      const printImgEl = document.getElementById('printCarImg') as HTMLImageElement | null;
      const printCustomerLine = document.getElementById('printCustomerLine');
      if (printCarName) printCarName.innerText = carName;
      if (printImgEl) printImgEl.src = carImg;
      if (printCustomerLine) {
        const custName = inputCustomerForPdf?.value?.trim() || '';
        if (custName) {
          printCustomerLine.innerText = 'Kính gửi Quý khách hàng: ' + custName;
          printCustomerLine.classList.remove('hidden');
        } else {
          printCustomerLine.classList.add('hidden');
        }
      }

      const pPrice = document.getElementById('printPrice');
      const pDiscountRow = document.getElementById('printDiscountRow');
      const pDiscountVal = document.getElementById('printDiscountVal');
      const pDynamicBody = document.getElementById('printDynamicFeesBody');
      const pExtraBody = document.getElementById('printExtraItemsBody');
      const pTotal = document.getElementById('printTotalRollout');
      const pNoteBox = document.getElementById('printCustomNoteBox');
      const pMeta = document.getElementById('printLoanMeta');
      const pDown = document.getElementById('printDownPayment');
      const pLoan = document.getElementById('printLoanAmount');
      const pMaxM = document.getElementById('printMaxMonthly');

      if (pPrice) pPrice.innerText = basePrice.toLocaleString('vi-VN') + ' đ';
      if (pDiscountRow && pDiscountVal) {
        if (discount > 0) {
          pDiscountRow.classList.remove('hidden');
          pDiscountVal.innerText = '-' + discount.toLocaleString('vi-VN') + ' đ (Giá sau CK: ' + netVehiclePrice.toLocaleString('vi-VN') + ' đ)';
        } else {
          pDiscountRow.classList.add('hidden');
        }
      }

      if (pDynamicBody) {
        pDynamicBody.innerHTML = '';
        activeDefaultItems.forEach((item) => {
          const tr = document.createElement('tr');
          tr.className = 'border-b';
          tr.innerHTML = `<td class="py-0.5 text-slate-600">${item.label}:</td><td class="py-0.5 font-semibold text-right text-slate-900">${item.amount.toLocaleString('vi-VN')} đ</td>`;
          pDynamicBody.appendChild(tr);
        });
      }

      if (pExtraBody) {
        pExtraBody.innerHTML = '';
        extraItems.forEach((item) => {
          const tr = document.createElement('tr');
          tr.className = 'border-b';
          tr.innerHTML = `<td class="py-0.5 text-slate-700 font-medium">+ ${item.name}:</td><td class="py-0.5 font-semibold text-right text-slate-900">${item.amount.toLocaleString('vi-VN')} đ</td>`;
          pExtraBody.appendChild(tr);
        });
      }

      if (pTotal) pTotal.innerText = totalRollout.toLocaleString('vi-VN') + ' đ';

      if (pNoteBox) {
        const customNote = inputCustomNoteForPdf?.value?.trim() || '';
        if (customNote) {
          pNoteBox.innerText = '🎁 Ghi chú & Ưu đãi kèm theo: ' + customNote;
          pNoteBox.classList.remove('hidden');
        } else {
          pNoteBox.classList.add('hidden');
        }
      }

      if (pMeta) pMeta.innerText = `${Math.round(loanRatio * 100)}% giá trị xe trong ${loanTermMonths / 12} năm (${loanTermMonths} tháng)`;
      if (pDown) pDown.innerText = downPayment.toLocaleString('vi-VN') + ' đ';
      if (pLoan) pLoan.innerText = loanAmount.toLocaleString('vi-VN') + ' đ';
      if (pMaxM) pMaxM.innerText = firstMonthPayment.toLocaleString('vi-VN') + ' đ / tháng';

      // Đổ thông số Chassis & Thiết bị chuyên dùng vào Trang 1 bản in
      const chassisBox = document.getElementById('printChassisSpecs');
      const specialBox = document.getElementById('printSpecialSpecs');
      if (chassisBox && specialBox) {
        chassisBox.innerHTML = '';
        specialBox.innerHTML = '';
        try {
          const chassisObj = JSON.parse(chassisJson);
          const specialObj = JSON.parse(specialJson);
          Object.entries(chassisObj).forEach(([k, v]) => {
            const div = document.createElement('div');
            div.className = 'flex justify-between border-b border-slate-200 pb-0.5';
            div.innerHTML = `<span class="text-slate-600">${k}:</span> <strong class="text-slate-900 text-right">${v}</strong>`;
            chassisBox.appendChild(div);
          });
          Object.entries(specialObj).forEach(([k, v]) => {
            const div = document.createElement('div');
            div.className = 'flex justify-between border-b border-slate-200 pb-0.5';
            div.innerHTML = `<span class="text-slate-600">${k}:</span> <strong class="text-slate-900 text-right">${v}</strong>`;
            specialBox.appendChild(div);
          });
        } catch (e) {}
      }

      // Tạo bảng lịch trả góp trên web (Chế độ Nội bộ) & Trang 2 bản in PDF
      const tbodyWeb = document.getElementById('scheduleTableBody');
      const tbodyPrint = document.getElementById('printScheduleTableBody');
      if (tbodyWeb && tbodyPrint) {
        tbodyWeb.innerHTML = '';
        tbodyPrint.innerHTML = '';
        let balance = loanAmount;
        let totalInterest = 0;

        for (let m = 1; m <= loanTermMonths; m++) {
          const interest = Math.round(balance * monthlyRate);
          const principal = m === loanTermMonths ? balance : monthlyPrincipal;
          const totalPay = principal + interest;
          const endBalance = Math.max(0, balance - principal);
          totalInterest += interest;

          const trWeb = document.createElement('tr');
          trWeb.className = m % 2 === 0 ? 'bg-gray-50' : 'bg-white';
          trWeb.innerHTML = `
            <td class="p-2 border font-bold text-center">Tháng ${m}</td>
            <td class="p-2 border">${balance.toLocaleString('vi-VN')} đ</td>
            <td class="p-2 border">${principal.toLocaleString('vi-VN')} đ</td>
            <td class="p-2 border text-red-600">${interest.toLocaleString('vi-VN')} đ</td>
            <td class="p-2 border font-bold text-blue-900">${totalPay.toLocaleString('vi-VN')} đ</td>
            <td class="p-2 border text-gray-500">${endBalance.toLocaleString('vi-VN')} đ</td>
          `;
          tbodyWeb.appendChild(trWeb);

          const trPrint = document.createElement('tr');
          trPrint.className = m % 2 === 0 ? 'bg-slate-50' : 'bg-white';
          trPrint.innerHTML = `
            <td class="p-1 border text-center font-bold">${m}</td>
            <td class="p-1 border">${balance.toLocaleString('vi-VN')} đ</td>
            <td class="p-1 border">${principal.toLocaleString('vi-VN')} đ</td>
            <td class="p-1 border text-red-600">${interest.toLocaleString('vi-VN')} đ</td>
            <td class="p-1 border font-bold">${totalPay.toLocaleString('vi-VN')} đ</td>
            <td class="p-1 border">${endBalance.toLocaleString('vi-VN')} đ</td>
          `;
          tbodyPrint.appendChild(trPrint);

          balance = endBalance;
        }

        const lblTotInt = document.getElementById('lblTotalInterest');
        const prtTotInt = document.getElementById('printTotalInterest');
        if (lblTotInt) lblTotInt.innerText = `Tổng lãi dự kiến suốt kỳ vay: ${totalInterest.toLocaleString('vi-VN')} đ`;
        if (prtTotInt) prtTotInt.innerText = `Tổng lãi dự kiến suốt kỳ vay: ${totalInterest.toLocaleString('vi-VN')} đ`;
      }
    }

    selectModel?.addEventListener('change', loadSelectedCarDefaults);
    [inputCustomerForPdf, inputCustomNoteForPdf, selectRatio, selectTerm, inputRate].forEach((el) => {
      el?.addEventListener('input', recalculateAll);
      el?.addEventListener('change', recalculateAll);
    });

    // SỰ KIỆN IN / LƯU BÁO GIÁ PDF 2 TRANG A4 CHO CHUYÊN VIÊN
    document.getElementById('btnPrintPDF')?.addEventListener('click', () => {
      recalculateAll();
      const now = new Date();
      const day = String(now.getDate()).padStart(2, '0');
      const month = String(now.getMonth() + 1).padStart(2, '0');
      const year = now.getFullYear();
      const dateStr = `Ngày xuất: ${day}/${month}/${year}`;
      const d1 = document.getElementById('printDate1');
      const d2 = document.getElementById('printDate2');
      if (d1) d1.innerText = dateStr;
      if (d2) d2.innerText = dateStr;

      const opt = selectModel?.options[selectModel.selectedIndex];
      const rawName = opt ? opt.getAttribute('data-name') || 'Xe-Phu-Cuong' : 'Bao-Gia';
      const cleanCarName = rawName
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[đĐ]/g, 'd')
        .replace(/([^0-9a-z-\s])/g, '')
        .replace(/(\s+)/g, '-');

      document.title = `Bao-Gia-${cleanCarName}-${day}-${month}/${year}`;
      window.print();
    });

    document.getElementById('btnToggleSchedule')?.addEventListener('click', () => {
      document.getElementById('scheduleSection')?.scrollIntoView({ behavior: 'smooth' });
    });

    const carParam = urlParams.get('car');
    if (carParam && selectModel) {
      const exists = Array.from(selectModel.options).some((opt) => opt.value === carParam);
      if (exists) {
        selectModel.value = carParam;
      }
    }

    loadSelectedCarDefaults();
    applySaleModeUI();

    // Xử lý trực tiếp 2 nút [Áp giá tối thiểu] và [Bán đúng giá công bố (CK = 0)]
    function applyCsbhPricingMode(mode: 'min' | 'public') {
      if (!selectModel) return;
      const opt = selectModel.options[selectModel.selectedIndex];
      if (!opt) return;

      const publishedPrice = Number(opt.getAttribute('data-price') || inputPrice?.value || '0');
      const floorPrice = Number(opt.getAttribute('data-minprice') || publishedPrice);

      if (inputPrice && (!inputPrice.value || Number(inputPrice.value) === 0)) {
        inputPrice.value = String(publishedPrice);
      }

      const currentBasePrice = Number(inputPrice?.value || publishedPrice);
      const maxDiscount = (currentBasePrice > floorPrice && floorPrice > 0) ? (currentBasePrice - floorPrice) : 0;

      if (inputDiscount) {
        inputDiscount.value = mode === 'min' ? String(maxDiscount) : '0';
      }

      // Bỏ cờ sửa tay của Trước bạ & Bảo hiểm thân vỏ để tự động tính lại theo Giá sau chiết khấu mới
      manualOverride.reg = false;
      manualOverride.bodyIns = false;

      // Hiệu ứng nhấp nháy nhẹ trên nút vừa bấm và cập nhật giao diện ngay lập tức
      const btnMin = document.getElementById('btnApplyMaxDiscount');
      const btnPub = document.getElementById('btnZeroDiscount');
      if (btnMin && btnPub) {
        if (mode === 'min') {
          btnMin.className = 'bg-emerald-700 text-white text-[11px] font-black px-2.5 py-1 rounded-lg cursor-pointer transition ring-2 ring-emerald-400';
          btnPub.className = 'bg-slate-200 hover:bg-slate-300 text-slate-700 text-[11px] font-bold px-2.5 py-1 rounded-lg cursor-pointer transition';
        } else {
          btnPub.className = 'bg-blue-700 text-white text-[11px] font-black px-2.5 py-1 rounded-lg cursor-pointer transition ring-2 ring-blue-400';
          btnMin.className = 'bg-emerald-600/80 hover:bg-emerald-700 text-white text-[11px] font-bold px-2.5 py-1 rounded-lg cursor-pointer transition';
        }
      }

      syncAutoFeeInputs();
      recalculateAll();
    }

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;
      if (target.closest('#btnApplyMaxDiscount')) {
        e.preventDefault();
        applyCsbhPricingMode('min');
      } else if (target.closest('#btnZeroDiscount')) {
        e.preventDefault();
        applyCsbhPricingMode('public');
      }
    });

    // Xử lý gửi Form Báo Giá & Lịch Trả Góp của Khách hàng về Web3Forms
    const btnRolloutSubmit = document.getElementById('btnSubmitRolloutPageLead') as HTMLButtonElement | null;
    const hiddenSubj = document.getElementById('rolloutHiddenSubject') as HTMLInputElement | null;
    const hiddenMsg = document.getElementById('rolloutHiddenMessage') as HTMLInputElement | null;

    async function sendRolloutLead() {
      if (!rolloutLeadForm) return;
      if (!rolloutLeadForm.reportValidity()) return;

      const opt = selectModel?.options[selectModel.selectedIndex];
      const carName = opt ? opt.getAttribute('data-name') || 'Xe chuyên dùng' : 'Xe chuyên dùng';
      const loanRatioPct = Math.round((parseFloat(selectRatio?.value || '0.8') || 0.8) * 100);
      const loanYears = (parseInt(selectTerm?.value || '60') || 60) / 12;
      const locName = selectLocation?.options[selectLocation.selectedIndex]?.text || 'TP.HCM';
      const rateVal = inputRate?.value || '9.5';

      if (hiddenSubj) {
        hiddenSubj.value = `Yêu cầu báo giá xe: ${carName}`;
      }
      if (hiddenMsg) {
        hiddenMsg.value = `Cần gửi Bảng Báo Giá Chi Tiết & File PDF Lịch Trả Góp mẫu xe ${carName} (Khu vực: ${locName} | Vay ${loanRatioPct}% - Trả trước ${100 - loanRatioPct}% trong ${loanYears} năm - Lãi suất tạm tính ${rateVal}%/năm)`;
      }

      if (btnRolloutSubmit) {
        btnRolloutSubmit.disabled = true;
        btnRolloutSubmit.innerText = '⏳ Đang gửi...';
      }

      try {
        const fd = new FormData(rolloutLeadForm);
        await fetch('https://api.web3forms.com/submit', { method: 'POST', body: fd });
        window.location.href = '/cam-on';
      } catch (err) {
        window.location.href = '/cam-on';
      }
    }

    btnRolloutSubmit?.addEventListener('click', sendRolloutLead);
    rolloutLeadForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      sendRolloutLead();
    });
  </script>
</BaseLayout>
